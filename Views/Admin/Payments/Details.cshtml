@model MovieMania.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="card card-dark p-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-light">
                <i class="fas fa-receipt me-2 text-primary"></i>Payment Details
            </h2>
            <span class="badge @(Model.Status == "Completed" ? "bg-success" : Model.Status == "Pending" ? "bg-warning" : "bg-secondary") p-3">
                @Model.Status
            </span>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="info-section p-3 mb-3" style="background: #2a2a2a; border-radius: 8px;">
                    <h5 class="text-primary mb-3"><i class="fas fa-user me-2"></i>User Information</h5>
                    <table class="table table-dark table-borderless">
                        <tr>
                            <th class="text-muted" style="width: 120px;">Name:</th>
                            <td class="fw-bold text-white">@(Model.User?.Name ?? "Unknown")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Email:</th>
                            <td class="text-white">@(Model.User?.Email ?? "N/A")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">User ID:</th>
                            <td class="text-white">#@Model.UserId</td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-section p-3 mb-3" style="background: #2a2a2a; border-radius: 8px;">
                    <h5 class="text-primary mb-3"><i class="fas fa-credit-card me-2"></i>Payment Information</h5>
                    <table class="table table-dark table-borderless">
                        <tr>
                            <th class="text-muted" style="width: 140px;">Amount:</th>
                            <td class="fw-bold text-success fs-5">$@Model.Amount.ToString("N2")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Payment Method:</th>
                            <td class="text-white">
                                @if (Model.PaymentMethod == "Card")
                                {
                                    <span><i class="fas fa-credit-card me-2"></i>Card</span>
                                }
                                else if (Model.PaymentMethod == "UPI")
                                {
                                    <span><i class="fas fa-mobile-alt me-2"></i>UPI</span>
                                }
                                else if (Model.PaymentMethod == "NetBanking")
                                {
                                    <span><i class="fas fa-university me-2"></i>NetBanking</span>
                                }
                                else
                                {
                                    <span>@Model.PaymentMethod</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Transaction ID:</th>
                            <td><code class="text-white">@(Model.TransactionId ?? "N/A")</code></td>
                        </tr>
                        <tr>
                            <th class="text-muted">Payment Date:</th>
                            <td class="text-white">@Model.PaymentDate.ToString("dd MMMM yyyy HH:mm:ss")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="info-section p-3 mb-3" style="background: #2a2a2a; border-radius: 8px;">
                    <h5 class="text-primary mb-3"><i class="fas fa-crown me-2"></i>Subscription Details</h5>
                    @if (Model.SubscriptionPlan != null)
                    {
                        <table class="table table-dark table-borderless">
                            <tr>
                                <th class="text-muted" style="width: 120px;">Plan:</th>
                                <td class="fw-bold text-white">@Model.SubscriptionPlan.Name</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Duration:</th>
                                <td class="text-white">@Model.SubscriptionPlan.DurationInDays days</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Quality:</th>
                                <td class="text-white">@Model.SubscriptionPlan.VideoQuality</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Max Screens:</th>
                                <td class="text-white">@Model.SubscriptionPlan.MaxScreens</td>
                            </tr>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No subscription plan associated</p>
                    }
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-section p-3 mb-3" style="background: #2a2a2a; border-radius: 8px;">
                    <h5 class="text-primary mb-3"><i class="fas fa-info-circle me-2"></i>Additional Details</h5>
                    <table class="table table-dark table-borderless">
                        <tr>
                            <th class="text-muted" style="width: 120px;">Payment ID:</th>
                            <td class="text-white">#@Model.Id</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Status:</th>
                            <td>
                                @if (Model.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (Model.Status == "Pending")
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                                else if (Model.Status == "Failed")
                                {
                                    <span class="badge bg-danger">Failed</span>
                                }
                                else if (Model.Status == "Refunded")
                                {
                                    <span class="badge bg-secondary">Refunded</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Payment Details:</th>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.PaymentDetails))
                                {
                                    <pre class="text-muted small">@Model.PaymentDetails</pre>
                                }
                                else
                                {
                                    <span class="text-muted">No additional details</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a asp-action="Index" class="btn btn-outline-light btn-lg px-4">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-lg px-4 ms-2">
                <i class="fas fa-trash me-2"></i>Delete Payment
            </a>
        </div>
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 15px;
        max-width: 1200px;
        margin: auto;
    }

    .info-section {
        background: #2a2a2a;
        border-radius: 8px;
    }

    .table-dark {
        --bs-table-bg: transparent;
    }

    .badge {
        font-size: 0.9rem;
        padding: 8px 15px;
    }
</style>