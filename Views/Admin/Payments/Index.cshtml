<style>
    body {
        background: #0f0f0f;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    /* Table Styling */
    .table {
        border-collapse: separate;
        border-spacing: 0 5px;
        width: 100%;
    }

        .table thead th {
            background: #2a2a2a;
            color: #fff;
            font-weight: 600;
            border: none;
            padding: 15px 12px;
            white-space: nowrap;
        }

        .table tbody tr {
            background: #1e1e1e;
            transition: all 0.2s ease;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        }

            .table tbody tr:hover {
                background: #252525;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(255, 77, 77, 0.2);
            }

                .table tbody tr:hover td,
                .table tbody tr:hover td span,
                .table tbody tr:hover td .text-white,
                .table tbody tr:hover td .fw-bold {
                    color: #ffffff !important;
                }

                .table tbody tr:hover .text-muted {
                    color: #aaa !important;
                }

        .table td {
            padding: 15px 12px;
            vertical-align: middle;
            border: none;
            color: #fff;
        }

    /* Badge Styling */
    .badge {
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: 20px;
    }

        .badge.bg-success {
            background: #00c853 !important;
        }

        .badge.bg-warning {
            background: #ffc107 !important;
            color: #000 !important;
        }

        .badge.bg-danger {
            background: #ff4d4d !important;
        }

        .badge.bg-info {
            background: #0dcaf0 !important;
            color: #000 !important;
        }

        .badge.bg-primary {
            background: #4A80F0 !important;
        }

        .badge.bg-secondary {
            background: #6c757d !important;
        }

    /* Button Group Styling */
    .btn-group {
        gap: 5px;
    }

    .btn-sm {
        width: 32px;
        height: 32px;
        border-radius: 8px !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        border: none;
        margin: 0 2px;
    }

        .btn-sm:hover {
            transform: scale(1.1);
        }

    .btn-info {
        background: #0dcaf0;
    }

        .btn-info:hover {
            background: #0bb7d6;
        }

    .btn-danger {
        background: #ff4d4d;
    }

        .btn-danger:hover {
            background: #ff3333;
        }

    /* Alert Styling */
    .alert {
        border: none;
        border-radius: 10px;
        padding: 15px 20px;
        margin-bottom: 20px;
    }

    .alert-success {
        background: rgba(0, 200, 83, 0.15);
        color: #00c853;
        border-left: 4px solid #00c853;
    }

    .alert-danger {
        background: rgba(255, 77, 77, 0.15);
        color: #ff4d4d;
        border-left: 4px solid #ff4d4d;
    }

    .btn-close {
        filter: invert(1);
    }
</style>