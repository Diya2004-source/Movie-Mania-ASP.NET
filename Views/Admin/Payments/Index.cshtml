@model IEnumerable<MovieMania.Models.Payment>

@{
    ViewData["Title"] = "User Payments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4 text-white" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-credit-card me-2"></i>User Payments
        </h2>

        <div>
            <span class="badge bg-info me-2">Total: @Model.Count()</span>
            <span class="badge bg-success">Total Revenue: $@Model.Sum(p => p.Amount).ToString("N2")</span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card bg-dark border-0 shadow">
        <div class="card-body p-0">
            <table class="table table-bordered table-hover table-dark text-white mb-0">
                <thead class="table-secondary text-dark">
                    <tr>
                        <th>User</th>
                        <th>Amount ($)</th>
                        <th>Payment Method</th>
                        <th>Subscription Plan</th>
                        <th>Payment Date</th>
                        <th>Status</th>
                        <th>Transaction ID</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td>
                                <strong>@(payment.User?.Name ?? "Unknown")</strong><br />
                                <small class="text-muted">@(payment.User?.Email ?? "")</small>
                            </td>
                            <td class="fw-bold text-success">$@payment.Amount.ToString("N2")</td>
                            <td>
                                @if (payment.PaymentMethod == "Card")
                                {
                                    <span class="badge bg-primary"><i class="fas fa-credit-card me-1"></i>Card</span>
                                }
                                else if (payment.PaymentMethod == "UPI")
                                {
                                    <span class="badge bg-info"><i class="fas fa-mobile-alt me-1"></i>UPI</span>
                                }
                                else if (payment.PaymentMethod == "NetBanking")
                                {
                                    <span class="badge bg-secondary"><i class="fas fa-university me-1"></i>NetBanking</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@payment.PaymentMethod</span>
                                }
                            </td>
                            <td>@(payment.SubscriptionPlan?.Name ?? "N/A")</td>
                            <td>@payment.PaymentDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                @if (payment.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (payment.Status == "Pending")
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                                else if (payment.Status == "Failed")
                                {
                                    <span class="badge bg-danger">Failed</span>
                                }
                                else if (payment.Status == "Refunded")
                                {
                                    <span class="badge bg-secondary">Refunded</span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@(payment.TransactionId ?? "N/A")</small>
                            </td>
                            <td>
                                <a class="btn btn-info btn-sm text-white" asp-action="Details" asp-route-id="@payment.Id" title="Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (payment.Status != "Refunded")
                                {
                                    <a class="btn btn-danger btn-sm text-white" asp-action="Delete" asp-route-id="@payment.Id" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                }
                                @if (payment.Status == "Completed" && payment.PaymentDate.AddDays(7) >= DateTime.Now)
                                {
                                    <a class="btn btn-warning btn-sm text-white" asp-action="Refund" asp-route-id="@payment.Id" title="Process Refund">
                                        <i class="fas fa-undo-alt"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="fas fa-credit-card fa-3x mb-3"></i>
                    <h5>No payments found</h5>
                    <p>Payments will appear here when users make purchases.</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table-dark {
        --bs-table-bg: #1e1e1e;
        --bs-table-striped-bg: #252525;
        --bs-table-hover-bg: #2a2a2a;
    }

    .badge {
        padding: 5px 10px;
        font-size: 0.85rem;
    }

    .btn-sm {
        margin: 0 2px;
        border-radius: 6px;
        padding: 4px 8px;
    }

    .table td {
        vertical-align: middle;
    }
</style>