@model MovieMania.Models.Show
@{
    ViewData["Title"] = "Add Anime";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* Fix for text turning black on hover */
    .card-body, .form-label, h3 {
        color: white !important;
    }

    input.form-control:focus, textarea.form-control:focus {
        background-color: #3d444b !important;
        color: white !important;
        box-shadow: none;
        border: 1px solid #198754;
    }
</style>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow">
                    <h5 class="alert-heading">Validation Error</h5>
                    <div asp-validation-summary="All"></div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card bg-dark border-0 shadow-lg">
                <div class="card-header bg-transparent border-secondary pt-4 px-4">
                    <h3 class="text-white"><i class="fas fa-plus-circle me-2 text-success"></i>Create Anime Entry</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Genre" value="Anime" />

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label asp-for="Title" class="form-label fw-bold">Title</label>
                                <input asp-for="Title" class="form-control bg-secondary text-white border-0" required />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="TotalEpisodes" class="form-label fw-bold">Total Episodes</label>
                                <input asp-for="TotalEpisodes" class="form-control bg-secondary text-white border-0" type="number" min="1" value="1" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Thumbnail Image (File)</label>
                                <input type="file" name="ThumbnailFile" class="form-control bg-secondary text-white border-0" accept="image/*" />
                                <small class="text-muted">Stored in wwwroot/images/movies</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="TrailerUrl" class="form-label fw-bold">Trailer URL</label>
                                <input asp-for="TrailerUrl" class="form-control bg-secondary text-white border-0" placeholder="https://..." />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="ReleaseYear" class="form-label fw-bold">Release Year</label>
                                <input asp-for="ReleaseYear" class="form-control bg-secondary text-white border-0" type="number" value="2026" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Rating" class="form-label fw-bold">Rating</label>
                                <input asp-for="Rating" class="form-control bg-secondary text-white border-0" step="0.1" value="0.0" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Description</label>
                            <textarea asp-for="Description" class="form-control bg-secondary text-white border-0" rows="3"></textarea>
                        </div>

                        <div class="mt-4 pt-2">
                            <button type="submit" class="btn btn-success px-5 shadow">Save Anime</button>
                            <a asp-action="Index" class="btn btn-outline-light ms-2">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}