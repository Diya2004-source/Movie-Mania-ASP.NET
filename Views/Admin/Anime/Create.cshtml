﻿@model IEnumerable<MovieMania.Models.Show>

@{
    ViewData["Title"] = "Anime Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="card card-dark p-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-light">
                <i class="fas fa-dragon me-2 text-danger"></i>Anime Management
            </h2>
            <div>
                <span class="badge bg-info me-2 p-2">Total Anime: @Model.Count()</span>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Add New Anime
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@Html.Raw(TempData["Success"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@Html.Raw(TempData["Error"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-dark table-hover table-striped mb-0">
                <thead class="table-secondary text-dark">
                    <tr>
                        <th>Poster</th>
                        <th>Title</th>
                        <th>Genre</th>
                        <th>Seasons</th>
                        <th>Episodes</th>
                        <th>Year</th>
                        <th>Rating</th>
                        <th>Status</th>
                        <th>Featured</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var anime in Model.OrderByDescending(a => a.CreatedAt))
                    {
                        <tr class="anime-row">
                            <td>
                                @if (!string.IsNullOrEmpty(anime.ThumbnailUrl))
                                {
                                    <img src="@anime.ThumbnailUrl" width="60" height="80" style="border-radius:8px; object-fit:cover; border: 2px solid #ff4d4d;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center"
                                         style="width:60px; height:80px; background: #2a2a2a; border-radius:8px; border: 2px solid #ff4d4d;">
                                        <i class="fas fa-dragon fa-2x text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td class="fw-bold text-white">@anime.Title</td>
                            <td class="text-white">@anime.Genre</td>
                            <td class="text-center text-white">@anime.TotalSeasons</td>
                            <td class="text-center text-white">@anime.TotalEpisodes</td>
                            <td class="text-white">@anime.ReleaseYear</td>
                            <td>
                                @if (anime.Rating.HasValue)
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">
                                        <i class="fas fa-star me-1"></i>@anime.Rating.Value.ToString("F1")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>
                                @if (anime.IsActive)
                                {
                                    <span class="badge bg-success px-3 py-2">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (anime.IsFeatured)
                                {
                                    <span class="badge bg-info px-3 py-2">Featured</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@anime.Id"
                                       class="btn btn-info btn-sm text-white" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@anime.Id"
                                       class="btn btn-warning btn-sm" title="Edit Anime">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-controller="AdminEpisodes" asp-action="Index" asp-route-showId="@anime.Id"
                                       class="btn btn-primary btn-sm" title="Manage Episodes">
                                        <i class="fas fa-list"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@anime.Id"
                                       class="btn btn-danger btn-sm" title="Delete Anime">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-info btn-sm toggle-status"
                                            data-id="@anime.Id"
                                            data-active="@anime.IsActive"
                                            title="@(anime.IsActive ? "Deactivate" : "Activate")">
                                        <i class="fas fa-@(anime.IsActive ? "toggle-on" : "toggle-off")"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-dragon fa-4x mb-3"></i>
                <h5 class="text-light">No anime found</h5>
                <p class="text-muted">Click "Add New Anime" to create your first anime.</p>
                <a asp-action="Create" class="btn btn-primary mt-3">
                    <i class="fas fa-plus me-2"></i>Add New Anime
                </a>
            </div>
        }
    </div>
</div>

