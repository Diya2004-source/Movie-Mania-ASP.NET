@model IEnumerable<MovieMania.Models.Show>
@{
    ViewData["Title"] = "Anime Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* Prevent text from turning black on hover */
    .table-hover tbody tr:hover td {
        color: #ffffff !important;
        background-color: #25292d !important;
    }

    .table td, .table th {
        border-color: #2d3238 !important;
    }

    .table {
        color: white !important;
    }

    /* Tooltip-like behavior for icons */
    .action-icon {
        transition: transform 0.2s;
    }

        .action-icon:hover {
            transform: scale(1.2);
        }
</style>

<div class="container-fluid p-4 bg-dark min-vh-100">
    <div class="card shadow-lg border-0" style="background-color: #1a1d21; border-radius: 15px;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-white fw-bold m-0"><i class="bi bi-tv text-primary me-2"></i>Anime Management</h2>
                <a href="/Admin/Anime/Create" class="btn btn-primary rounded-pill px-4 shadow">
                    <i class="bi bi-plus-lg me-1"></i> Add New Anime
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="text-secondary small text-uppercase">
                        <tr>
                            <th style="width: 80px;">Poster</th>
                            <th>Title</th>
                            <th>Rating</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(item.ThumbnailUrl) ? "/images/no-thumb.jpg" : item.ThumbnailUrl)"
                                         class="rounded shadow-sm" style="width: 50px; height: 70px; object-fit: cover;" />
                                </td>
                                <td class="fw-bold text-white">@item.Title</td>
                                <td>
                                    <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>@item.Rating</span>
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success px-3">
                                            <i class="bi bi-check-circle-fill me-1"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger px-3">
                                            <i class="bi bi-x-circle-fill me-1"></i> Inactive
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-3">
                                        @* Details Icon *@
                                        <a href="/Admin/Anime/Details/@item.Id" class="text-info action-icon" title="View Details">
                                            <i class="bi bi-eye-fill fs-5"></i>
                                        </a>

                                        @* Add Episode Icon *@
                                        <a href="/Admin/Anime/AddEpisode/@item.Id" class="text-primary action-icon" title="Add Episode">
                                            <i class="bi bi-plus-square-fill fs-5"></i>
                                        </a>

                                        @* Edit Icon *@
                                        <a href="/Admin/Anime/Edit/@item.Id" class="text-warning action-icon" title="Edit Anime">
                                            <i class="bi bi-pencil-square fs-5"></i>
                                        </a>

                                        @* Delete Icon *@
                                        <a href="/Admin/Anime/Delete/@item.Id" class="text-danger action-icon" title="Delete Anime">
                                            <i class="bi bi-trash3-fill fs-5"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>