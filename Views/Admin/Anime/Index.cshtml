@section Scripts {
    <script>
        // Toggle status with AJAX
        $('.toggle-status').click(function() {
            var button = $(this);
            var id = button.data('id');
            var isActive = button.data('active');

            $.post('@Url.Action("ToggleStatus", "AdminAnime")/' + id)
                .done(function(response) {
                    if (response.success) {
                        // Update button icon and data
                        button.find('i').attr('class', 'fas fa-' + (response.isActive ? 'toggle-on' : 'toggle-off'));
                        button.data('active', response.isActive);
                        button.attr('title', response.isActive ? 'Deactivate' : 'Activate');

                        // Update status badge
                        var statusCell = button.closest('tr').find('td:eq(7)');
                        if (response.isActive) {
                            statusCell.html('<span class="badge bg-success px-3 py-2">Active</span>');
                        } else {
                            statusCell.html('<span class="badge bg-secondary px-3 py-2">Inactive</span>');
                        }

                        // Show success message
                        toastr.success(response.message);
                    }
                })
                .fail(function() {
                    toastr.error('Error toggling anime status');
                });
        });
    </script>
}
