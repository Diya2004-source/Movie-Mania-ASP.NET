@model MovieMania.Models.AppUser

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete User";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-dark p-4 shadow-lg">
                <h2 class="text-center text-danger mb-4">
                    <i class="fas fa-exclamation-triangle me-2"></i>Delete User
                </h2>

                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    Are you sure you want to delete this user?
                    <strong>This action cannot be undone.</strong>
                </div>

                <div class="user-details p-3 mb-4" style="background: #2a2a2a; border-radius: 8px;">
                    <h5 class="text-center text-light mb-3">User Details</h5>

                    <table class="table table-dark table-borderless">
                        <tr>
                            <th class="text-muted" style="width: 120px;">Name:</th>
                            <td class="fw-bold text-light">@Model.Name</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Email:</th>
                            <td class="text-light">@Model.Email</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Role:</th>
                            <td>
                                <span class="badge bg-info">@Model.Role</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Status:</th>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Member Since:</th>
                            <td>@Model.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                        @if (!string.IsNullOrEmpty(Model.ReferralCode))
                        {
                            <tr>
                                <th class="text-muted">Referral Code:</th>
                                <td><span class="badge bg-secondary">@Model.ReferralCode</span></td>
                            </tr>
                        }
                    </table>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="text-center">
                        <button type="submit" class="btn btn-danger btn-lg px-5">
                            <i class="fas fa-trash me-2"></i>Confirm Delete
                        </button>
                        <a asp-action="Index" class="btn btn-outline-light btn-lg px-5 ms-2">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 12px;
    }

    .btn-danger {
        background: #dc3545;
        border: none;
        transition: 0.3s;
    }

        .btn-danger:hover {
            background: #bb2d3b;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220,53,69,0.4);
        }

    .btn-outline-light:hover {
        background: white;
        color: black;
        transform: translateY(-2px);
    }

    .badge {
        font-size: 0.9rem;
        padding: 5px 10px;
    }

    .table-dark {
        --bs-table-bg: transparent;
    }
</style>