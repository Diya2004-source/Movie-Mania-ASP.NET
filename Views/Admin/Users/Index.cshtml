@model IEnumerable<MovieMania.Models.AppUser>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "User Management";
}

<div class="container mt-4">
    <div class="card card-dark p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fw-bold">
                <i class="fas fa-users me-2 text-primary"></i>Users Management
            </h2>
            <div>
                <span class="badge bg-info me-2">Total: @Model.Count()</span>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Create User
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <table class="table table-dark-custom table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Referral Code</th>
                    <th>Created</th>
                    <th>Last Login</th>
                    <th width="200">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.OrderByDescending(u => u.CreatedAt))
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                {
                                    <img src="@user.ProfilePictureUrl" class="rounded-circle me-2" width="30" height="30" style="object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="fas fa-user-circle fa-2x me-2 text-secondary"></i>
                                }
                                <span class="fw-bold">@user.Name</span>
                            </div>
                        </td>
                        <td>@user.Email</td>
                        <td>
                            @if (user.Role == "admin")
                            {
                                <span class="badge bg-warning text-dark">Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">User</span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(user.ReferralCode))
                            {
                                <span class="badge bg-secondary">@user.ReferralCode</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (user.LastLoginAt.HasValue)
                            {
                                <small>@user.LastLoginAt.Value.ToString("dd MMM HH:mm")</small>
                            }
                            else
                            {
                                <span class="text-muted">Never</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-info text-white" title="Details">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger" title="Delete">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-users-slash fa-3x mb-3"></i>
                <h5>No users found</h5>
                <p>Click "Create User" to add your first user.</p>
            </div>
        }
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 12px;
    }

    .table-dark-custom {
        color: #fff;
        background-color: transparent;
    }

        .table-dark-custom thead th {
            border-bottom-color: #444;
            color: #aaa;
            font-weight: 500;
        }

        .table-dark-custom td {
            border-bottom-color: #333;
            vertical-align: middle;
        }

        .table-dark-custom tbody tr:hover {
            background-color: #2a2a2a;
        }

    .badge {
        padding: 5px 8px;
        font-size: 0.8rem;
    }

    .btn-sm {
        margin: 0 2px;
        border-radius: 6px;
        padding: 4px 8px;
    }
</style>