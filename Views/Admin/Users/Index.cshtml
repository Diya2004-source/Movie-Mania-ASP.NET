@model IEnumerable<MovieMania.Models.AppUser>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "User Management";
}

<div class="container mt-4">
    <div class="card card-dark p-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-light">
                <i class="fas fa-users me-2 text-primary"></i>Users Management
            </h2>
            <div>
                <span class="badge bg-info me-2 p-2">Total Users: @Model.Count()</span>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Create User
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-dark table-hover table-striped mb-0">
                <thead class="table-secondary text-dark">
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Referral Code</th>
                        <th>Joined</th>
                        <th>Last Login</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.OrderByDescending(u => u.CreatedAt))
                    {
                        <tr class="user-row">
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                    {
                                        <img src="@user.ProfilePictureUrl" class="rounded-circle me-2" width="35" height="35" style="object-fit: cover; border: 2px solid #ff4d4d;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle me-2 d-flex align-items-center justify-content-center"
                                             style="width:35px; height:35px; background: #2a2a2a; border: 2px solid #ff4d4d;">
                                            <i class="fas fa-user text-white"></i>
                                        </div>
                                    }
                                    <span class="fw-bold text-white">@user.Name</span>
                                </div>
                            </td>
                            <td class="text-white">@user.Email</td>
                            <td>
                                @if (user.Role == "admin")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark px-3 py-2">User</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success px-3 py-2">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(user.ReferralCode))
                                {
                                    <span class="badge bg-secondary px-3 py-2">@user.ReferralCode</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-white">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-white">
                                @if (user.LastLoginAt.HasValue)
                                {
                                    <small>@user.LastLoginAt.Value.ToString("dd MMM HH:mm")</small>
                                }
                                else
                                {
                                    <span class="text-muted">Never</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-info btn-sm text-white" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-warning btn-sm" title="Edit User">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger btn-sm" title="Delete User">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                    <!-- Toggle button removed -->
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-users-slash fa-4x mb-3"></i>
                <h5 class="text-light">No users found</h5>
                <p class="text-muted">Click "Create User" to add your first user.</p>
                <a asp-action="Create" class="btn btn-primary mt-3">
                    <i class="fas fa-plus me-2"></i>Create User
                </a>
            </div>
        }
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    /* Table Styling */
    .table {
        border-collapse: separate;
        border-spacing: 0 5px;
        width: 100%;
    }

        .table thead th {
            background: #2a2a2a;
            color: #fff;
            font-weight: 600;
            border: none;
            padding: 15px 12px;
        }

        .table tbody tr {
            background: #1e1e1e;
            transition: all 0.2s ease;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        }

            .table tbody tr:hover {
                background: #252525;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(255, 77, 77, 0.2);
            }

                /* FIX: Ensure text stays visible on hover */
                .table tbody tr:hover td,
                .table tbody tr:hover td span,
                .table tbody tr:hover td small,
                .table tbody tr:hover td .text-white,
                .table tbody tr:hover td .fw-bold {
                    color: #ffffff !important;
                }

                .table tbody tr:hover .text-muted {
                    color: #aaa !important;
                }

        .table td {
            padding: 15px 12px;
            vertical-align: middle;
            border: none;
            color: #fff;
        }

    /* Badge Styling */
    .badge {
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: 20px;
    }

        .badge.bg-warning {
            background: #ffc107 !important;
            color: #000 !important;
        }

        .badge.bg-info {
            background: #0dcaf0 !important;
            color: #000 !important;
        }

        .badge.bg-success {
            background: #00c853 !important;
        }

        .badge.bg-secondary {
            background: #6c757d !important;
        }

    /* Button Group Styling */
    .btn-group {
        gap: 5px;
    }

    .btn-sm {
        width: 32px;
        height: 32px;
        border-radius: 8px !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        border: none;
        margin: 0 2px;
    }

        .btn-sm:hover {
            transform: scale(1.1);
        }

    .btn-info {
        background: #0dcaf0;
    }

        .btn-info:hover {
            background: #0bb7d6;
        }

    .btn-warning {
        background: #ffc107;
    }

        .btn-warning:hover {
            background: #ffb300;
        }

    .btn-danger {
        background: #ff4d4d;
    }

        .btn-danger:hover {
            background: #ff3333;
        }

    /* Alert Styling */
    .alert {
        border: none;
        border-radius: 10px;
        padding: 15px 20px;
        margin-bottom: 20px;
    }

    .alert-success {
        background: rgba(0, 200, 83, 0.15);
        color: #00c853;
        border-left: 4px solid #00c853;
    }

    .alert-danger {
        background: rgba(255, 77, 77, 0.15);
        color: #ff4d4d;
        border-left: 4px solid #ff4d4d;
    }

    .btn-close {
        filter: invert(1);
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .card-dark {
            padding: 15px !important;
        }

        .table {
            font-size: 0.9rem;
        }

        .btn-sm {
            width: 28px;
            height: 28px;
        }
    }
</style>