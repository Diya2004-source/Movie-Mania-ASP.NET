@model MovieMania.Models.AppUser

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "User Details";
}

<div class="container mt-4">
    <div class="card card-dark p-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-light">
                <i class="fas fa-user-circle me-2 text-info"></i>User Details
            </h2>
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary") p-3">
                @(Model.IsActive ? "ACTIVE" : "INACTIVE")
            </span>
        </div>

        <div class="row">
            <div class="col-md-4 text-center mb-4">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" class="rounded-circle img-fluid mb-3" style="max-width: 200px; border: 3px solid #00c853;" />
                }
                else
                {
                    <i class="fas fa-user-circle fa-7x text-secondary mb-3"></i>
                }
                <h4 class="text-light">@Model.Name</h4>
                <p class="text-muted">@Model.Email</p>
            </div>

            <div class="col-md-8">
                <div class="info-section p-3 mb-3" style="background: #2a2a2a; border-radius: 8px;">
                    <h5 class="text-info mb-3"><i class="fas fa-info-circle me-2"></i>Basic Information</h5>
                    <table class="table table-dark table-borderless">
                        <tr>
                            <th class="text-muted" style="width: 150px;">User ID:</th>
                            <td>#@Model.Id</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Role:</th>
                            <td>
                                @if (Model.Role == "admin")
                                {
                                    <span class="badge bg-warning">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">User</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Member Since:</th>
                            <td>@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Last Login:</th>
                            <td>@(Model.LastLoginAt?.ToString("dd MMMM yyyy HH:mm") ?? "Never")</td>
                        </tr>
                    </table>
                </div>

                <div class="info-section p-3 mb-3" style="background: #2a2a2a; border-radius: 8px;">
                    <h5 class="text-info mb-3"><i class="fas fa-gift me-2"></i>Referral Information</h5>
                    <table class="table table-dark table-borderless">
                        <tr>
                            <th class="text-muted" style="width: 150px;">Referral Code:</th>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.ReferralCode))
                                {
                                    <span class="badge bg-secondary">@Model.ReferralCode</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not set</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Total Referrals:</th>
                            <td>@Model.TotalReferrals</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Reward Points:</th>
                            <td>@Model.RewardPoints</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg px-4">
                <i class="fas fa-edit me-2"></i>Edit User
            </a>
            <a asp-action="Index" class="btn btn-outline-light btn-lg px-4 ms-2">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 12px;
        max-width: 1000px;
        margin: auto;
    }

    .info-section {
        background: #2a2a2a;
        border-radius: 8px;
    }

    .table-dark {
        --bs-table-bg: transparent;
    }

    .badge {
        font-size: 0.9rem;
        padding: 8px 15px;
    }
</style>