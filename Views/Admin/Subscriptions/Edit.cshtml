@model MovieMania.Models.SubscriptionPlan

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Subscription Plan";
}

<h2>Edit Subscription Plan</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="DurationInDays"></label>  <!-- Fixed -->
        <input asp-for="DurationInDays" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="MaxScreens"></label>
        <input asp-for="MaxScreens" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="VideoQuality"></label>
        <select asp-for="VideoQuality" class="form-control">
            <option value="SD">SD</option>
            <option value="HD">HD</option>
            <option value="Full HD">Full HD</option>
            <option value="4K">4K</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="DisplayOrder"></label>
        <input asp-for="DisplayOrder" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="form-group form-check">
        <input asp-for="IsActive" class="form-check-input" />  <!-- Fixed -->
        <label asp-for="IsActive" class="form-check-label">Active</label>
    </div>

    <button type="submit" class="btn btn-success mt-2">Update</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}