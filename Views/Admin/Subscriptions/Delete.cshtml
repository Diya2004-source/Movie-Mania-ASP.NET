@model MovieMania.Models.SubscriptionPlan

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Subscription Plan";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg bg-dark">
                <div class="card-body p-5">
                    <h2 class="text-center text-danger mb-4">
                        <i class="fas fa-exclamation-triangle me-2"></i>Delete Subscription Plan
                    </h2>

                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        Are you sure you want to delete this subscription plan?
                        <strong class="d-block mt-2">This action cannot be undone.</strong>
                    </div>

                    <div class="bg-secondary p-4 rounded mb-4">
                        <h5 class="text-warning mb-4 text-center">Plan Details</h5>

                        <div class="row">
                            <div class="col-md-6">
                                <table class="table table-dark table-borderless">
                                    <tr>
                                        <th class="text-muted">Name:</th>
                                        <td class="text-light fw-bold">@Model.Name</td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Price:</th>
                                        <td class="text-success fw-bold fs-5">₹ @Model.Price.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Duration:</th>
                                        <td class="text-light">@Model.DurationInDays days</td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Max Screens:</th>
                                        <td class="text-light">@Model.MaxScreens</td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <table class="table table-dark table-borderless">
                                    <tr>
                                        <th class="text-muted">Video Quality:</th>
                                        <td>
                                            @if (Model.VideoQuality == "4K")
                                            {
                                                <span class="badge bg-danger">4K</span>
                                            }
                                            else if (Model.VideoQuality == "Full HD")
                                            {
                                                <span class="badge bg-info">1080p</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@Model.VideoQuality</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Status:</th>
                                        <td>
                                            @if (Model.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Display Order:</th>
                                        <td class="text-light">@Model.DisplayOrder</td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Created:</th>
                                        <td class="text-light">@Model.CreatedAt.ToString("dd MMM yyyy")</td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <div class="mt-3">
                                <small class="text-muted d-block">Description:</small>
                                <p class="text-light">@Model.Description</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Features))
                        {
                            <div class="mt-3">
                                <small class="text-muted d-block">Features:</small>
                                <div class="text-light">
                                    @foreach (var feature in Model.Features.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <div>• @feature.Trim()</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <form asp-action="DeleteConfirmed" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="text-center">
                            <button type="submit" class="btn btn-danger btn-lg px-5">
                                <i class="fas fa-trash me-2"></i>Confirm Delete
                            </button>
                            <a asp-action="Index" class="btn btn-outline-light btn-lg px-5 ms-3">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
    }

    .alert-warning {
        background: rgba(255, 193, 7, 0.1);
        border: 1px solid #ffc107;
        color: #ffc107;
    }
</style>

@section Scripts {
    <script>
        document.querySelector('form').addEventListener('submit', function(e) {
            var button = document.querySelector('button[type="submit"]');
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Deleting...';
            button.disabled = true;
        });
    </script>
}