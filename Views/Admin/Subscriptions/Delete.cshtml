@model MovieMania.Models.SubscriptionPlan

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Subscription Plan";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-dark p-4 shadow-lg">
                <h2 class="text-center text-danger mb-4">
                    <i class="fas fa-exclamation-triangle me-2"></i>Delete Plan
                </h2>

                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    Are you sure you want to delete this subscription plan?
                    <strong>This action cannot be undone.</strong>
                </div>

                <div class="plan-details p-3 mb-4" style="background: #2a2a2a; border-radius: 8px;">
                    <h5 class="text-center text-light mb-3">Plan Details</h5>

                    <table class="table table-dark table-borderless">
                        <tr>
                            <th class="text-muted" style="width: 120px;">Name:</th>
                            <td class="fw-bold text-light">@Model.Name</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Price:</th>
                            <td class="text-success fw-bold">$@Model.Price.ToString("N2")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Duration:</th>
                            <td>@Model.DurationInDays days</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Max Screens:</th>
                            <td>@Model.MaxScreens</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Video Quality:</th>
                            <td>@Model.VideoQuality</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Status:</th>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="text-center">
                        <button type="submit" class="btn btn-danger btn-lg px-5">
                            <i class="fas fa-trash me-2"></i>Confirm Delete
                        </button>
                        <a asp-action="Index" class="btn btn-outline-light btn-lg px-5 ms-2">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 15px;
    }

    .btn-danger {
        background: #ff4d4d;
        border: none;
        transition: all 0.3s;
    }

        .btn-danger:hover {
            background: #ff3333;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255,77,77,0.3);
        }

    .btn-outline-light:hover {
        background: white;
        color: black;
        transform: translateY(-2px);
    }

    .badge {
        font-size: 0.9rem;
        padding: 5px 10px;
    }
</style>