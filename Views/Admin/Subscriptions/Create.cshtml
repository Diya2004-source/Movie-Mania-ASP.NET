@model MovieMania.Models.SubscriptionPlan

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Subscription Plan";
}

<div class="container mt-5">
    <div class="card card-dark p-4 shadow-lg">
        <h2 class="text-center text-light mb-4">Create Subscription Plan</h2>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label text-light"></label>
                <input asp-for="Name" class="form-control custom-input" />
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label text-light"></label>
                <input asp-for="Price" class="form-control custom-input" />
            </div>

            <div class="mb-3">
                <label asp-for="DurationInDays" class="form-label text-light"></label>  <!-- Fixed -->
                <input asp-for="DurationInDays" class="form-control custom-input" />
            </div>

            <div class="mb-3">
                <label asp-for="MaxScreens" class="form-label text-light"></label>
                <input asp-for="MaxScreens" class="form-control custom-input" />
            </div>

            <div class="mb-3">
                <label asp-for="VideoQuality" class="form-label text-light"></label>
                <select asp-for="VideoQuality" class="form-control custom-input">
                    <option value="SD">SD</option>
                    <option value="HD">HD</option>
                    <option value="Full HD">Full HD</option>
                    <option value="4K">4K</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="DisplayOrder" class="form-label text-light"></label>
                <input asp-for="DisplayOrder" class="form-control custom-input" />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label text-light"></label>
                <textarea asp-for="Description" class="form-control custom-input" rows="3"></textarea>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" checked />  <!-- Fixed -->
                <label asp-for="IsActive" class="form-check-label text-light">Active</label>
            </div>

            <div class="text-center mt-3">
                <button type="submit" class="btn btn-success btn-custom">Create</button>
                <a asp-action="Index" class="btn btn-outline-light btn-custom ms-2">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}