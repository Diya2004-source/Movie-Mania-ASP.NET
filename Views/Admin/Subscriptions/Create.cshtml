@model MovieMania.Models.SubscriptionPlan

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Subscription Plan";
}

<div class="container mt-5">
    <div class="card card-dark p-4 shadow-lg">
        <h2 class="mb-4 text-center text-light">
            <i class="fas fa-plus-circle me-2 text-success"></i>Create Subscription Plan
        </h2>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label text-light"></label>
                    <input asp-for="Name" class="form-control custom-input" placeholder="Enter plan name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="form-label text-light"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-secondary text-white border-0">$</span>
                        <input asp-for="Price" class="form-control custom-input" type="number" step="0.01" min="0" placeholder="9.99" />
                    </div>
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="DurationInDays" class="form-label text-light"></label>
                    <div class="input-group">
                        <input asp-for="DurationInDays" class="form-control custom-input" type="number" min="1" value="30" />
                        <span class="input-group-text bg-secondary text-white border-0">days</span>
                    </div>
                    <span asp-validation-for="DurationInDays" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="MaxScreens" class="form-label text-light"></label>
                    <input asp-for="MaxScreens" class="form-control custom-input" type="number" min="1" max="10" value="1" />
                    <span asp-validation-for="MaxScreens" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="DisplayOrder" class="form-label text-light"></label>
                    <input asp-for="DisplayOrder" class="form-control custom-input" type="number" min="1" value="1" />
                    <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="VideoQuality" class="form-label text-light"></label>
                    <select asp-for="VideoQuality" class="form-control custom-input">
                        <option value="SD">SD (480p)</option>
                        <option value="HD">HD (720p)</option>
                        <option value="Full HD">Full HD (1080p)</option>
                        <option value="4K">4K Ultra HD</option>
                    </select>
                    <span asp-validation-for="VideoQuality" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label text-light"></label>
                <textarea asp-for="Description" class="form-control custom-input" rows="3"
                          placeholder="Enter plan description..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Features" class="form-label text-light"></label>
                <textarea asp-for="Features" class="form-control custom-input" rows="4"
                          placeholder='Enter features (one per line)'></textarea>
                <span asp-validation-for="Features" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" checked />
                <label asp-for="IsActive" class="form-check-label text-light">Active</label>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-success btn-custom px-5">
                    <i class="fas fa-save me-2"></i>Create Plan
                </button>
                <a asp-action="Index" class="btn btn-outline-light btn-custom px-4 ms-2">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>

        </form>
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 15px;
        max-width: 900px;
        margin: auto;
    }

    .custom-input {
        background: #2a2a2a;
        border: 1px solid #444;
        color: white;
        border-radius: 8px;
        padding: 10px;
    }

        .custom-input:focus {
            background: #2a2a2a;
            color: white;
            border-color: #00c853;
            box-shadow: 0 0 8px rgba(0,200,83,0.4);
        }

        .custom-input::placeholder {
            color: #666;
        }

    .input-group-text {
        background: #2a2a2a;
        border: 1px solid #444;
        border-left: none;
    }

    .btn-custom {
        padding: 10px 20px;
        border-radius: 8px;
        transition: all 0.3s;
    }

    .btn-success {
        background: #00c853;
        border: none;
    }

        .btn-success:hover {
            background: #00e676;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,200,83,0.3);
        }

    .btn-outline-light:hover {
        background: white;
        color: black;
        transform: translateY(-2px);
    }

    .form-check-input:checked {
        background-color: #00c853;
        border-color: #00c853;
    }

    .text-danger {
        font-size: 0.85rem;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}