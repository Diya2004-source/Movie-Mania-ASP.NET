@model MovieMania.Models.SubscriptionPlan
@{
    ViewData["Title"] = "Create Subscription Plan";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0 text-light">
                <i class="fas fa-plus-circle me-2 text-success"></i>Create New Subscription Plan
            </h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg bg-dark">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label asp-for="Name" class="form-label text-light fw-bold"></label>
                                <input asp-for="Name" class="form-control bg-secondary text-light border-0" placeholder="e.g., Premium Plan" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DisplayOrder" class="form-label text-light fw-bold">Display Order</label>
                                <input asp-for="DisplayOrder" class="form-control bg-secondary text-light border-0" type="number" min="0" value="0" />
                                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label text-light fw-bold"></label>
                            <textarea asp-for="Description" class="form-control bg-secondary text-light border-0" rows="3" placeholder="Brief description of the plan..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="Price" class="form-label text-light fw-bold">Price (₹)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-primary text-white border-0">₹</span>
                                    <input asp-for="Price" class="form-control bg-secondary text-light border-0" type="number" step="0.01" min="0" value="0" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DurationInDays" class="form-label text-light fw-bold">Duration (Days)</label>
                                <input asp-for="DurationInDays" class="form-control bg-secondary text-light border-0" type="number" min="1" value="30" />
                                <span asp-validation-for="DurationInDays" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MaxScreens" class="form-label text-light fw-bold">Max Screens</label>
                                <input asp-for="MaxScreens" class="form-control bg-secondary text-light border-0" type="number" min="1" max="10" value="1" />
                                <span asp-validation-for="MaxScreens" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="VideoQuality" class="form-label text-light fw-bold">Video Quality</label>
                                <select asp-for="VideoQuality" class="form-select bg-secondary text-light border-0">
                                    <option value="HD">HD (720p)</option>
                                    <option value="Full HD">Full HD (1080p)</option>
                                    <option value="4K">4K (2160p)</option>
                                    <option value="8K">8K (4320p)</option>
                                </select>
                                <span asp-validation-for="VideoQuality" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mt-4">
                                    <input asp-for="IsActive" class="form-check-input" checked />
                                    <label asp-for="IsActive" class="form-check-label text-light fw-bold"></label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Features" class="form-label text-light fw-bold">Features</label>
                            <textarea asp-for="Features" class="form-control bg-secondary text-light border-0" rows="4" placeholder="List the features (one per line)&#10;e.g.,&#10;✓ Watch on 1 screen&#10;✓ HD quality available&#10;✓ Download on 1 device"></textarea>
                            <span asp-validation-for="Features" class="text-danger"></span>
                            <small class="text-muted">Enter each feature on a new line</small>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-save me-2"></i>Create Plan
                            </button>
                            <a asp-action="Index" class="btn btn-outline-light ms-2 px-4">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-lg bg-dark">
                <div class="card-body p-4">
                    <h5 class="text-warning mb-3">
                        <i class="fas fa-info-circle me-2"></i>Plan Guidelines
                    </h5>
                    <ul class="list-unstyled text-light">
                        <li class="mb-2">✓ <strong>Name:</strong> Keep it short and descriptive</li>
                        <li class="mb-2">✓ <strong>Price:</strong> Enter in Indian Rupees (₹)</li>
                        <li class="mb-2">✓ <strong>Duration:</strong> Common: 30, 90, 365 days</li>
                        <li class="mb-2">✓ <strong>Max Screens:</strong> Between 1-10 screens</li>
                        <li class="mb-2">✓ <strong>Features:</strong> One feature per line</li>
                        <li class="mb-2">✓ <strong>Display Order:</strong> Lower numbers appear first</li>
                    </ul>

                    <hr class="bg-secondary">

                    <h5 class="text-warning mb-3 mt-3">
                        <i class="fas fa-crown me-2"></i>Example Plan
                    </h5>
                    <div class="bg-secondary p-3 rounded">
                        <h6 class="text-light">Premium Plan</h6>
                        <p class="text-success fw-bold">₹ 299 / 30 days</p>
                        <small class="text-muted d-block">✓ 4K Ultra HD</small>
                        <small class="text-muted d-block">✓ 4 screens</small>
                        <small class="text-muted d-block">✓ Dolby Atmos</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}