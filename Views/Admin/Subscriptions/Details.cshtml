@model MovieMania.Models.SubscriptionPlan

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Subscription Plan Details";
}

<div class="container mt-4">
    <div class="card card-dark p-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-light">
                <i class="fas fa-crown me-2 text-warning"></i>Plan Details
            </h2>
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary") p-3">
                @(Model.IsActive ? "ACTIVE" : "INACTIVE")
            </span>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="info-section p-3 mb-3" style="background: #2a2a2a; border-radius: 8px;">
                    <h5 class="text-warning mb-3"><i class="fas fa-info-circle me-2"></i>Basic Information</h5>
                    <table class="table table-dark table-borderless">
                        <tr>
                            <th class="text-muted" style="width: 150px;">Plan Name:</th>
                            <td class="text-light fw-bold">@Model.Name</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Price:</th>
                            <td class="text-success fw-bold">$@Model.Price.ToString("N2") / month</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Duration:</th>
                            <td>@Model.DurationInDays days</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Display Order:</th>
                            <td>@Model.DisplayOrder</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Created:</th>
                            <td>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <tr>
                                <th class="text-muted">Last Updated:</th>
                                <td>@Model.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm")</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-section p-3 mb-3" style="background: #2a2a2a; border-radius: 8px;">
                    <h5 class="text-warning mb-3"><i class="fas fa-tv me-2"></i>Streaming Details</h5>
                    <table class="table table-dark table-borderless">
                        <tr>
                            <th class="text-muted" style="width: 150px;">Video Quality:</th>
                            <td>
                                @if (Model.VideoQuality == "4K")
                                {
                                    <span class="badge bg-danger">4K Ultra HD</span>
                                }
                                else if (Model.VideoQuality == "Full HD")
                                {
                                    <span class="badge bg-info text-dark">Full HD (1080p)</span>
                                }
                                else if (Model.VideoQuality == "HD")
                                {
                                    <span class="badge bg-primary">HD (720p)</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Model.VideoQuality</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Max Screens:</th>
                            <td>@Model.MaxScreens devices</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="info-section p-3 mb-3" style="background: #2a2a2a; border-radius: 8px;">
                <h5 class="text-warning mb-3"><i class="fas fa-align-left me-2"></i>Description</h5>
                <p class="text-light mb-0">@Model.Description</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Features))
        {
            <div class="info-section p-3 mb-3" style="background: #2a2a2a; border-radius: 8px;">
                <h5 class="text-warning mb-3"><i class="fas fa-list me-2"></i>Features</h5>
                <pre class="text-light mb-0" style="white-space: pre-wrap;">@Model.Features</pre>
            </div>
        }

        <div class="text-center mt-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg px-4">
                <i class="fas fa-edit me-2"></i>Edit Plan
            </a>
            <a asp-action="Index" class="btn btn-outline-light btn-lg px-4 ms-2">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 15px;
        max-width: 1000px;
        margin: auto;
    }

    .info-section {
        background: #2a2a2a;
        border-radius: 8px;
    }

    .table-dark {
        --bs-table-bg: transparent;
    }

    .badge {
        font-size: 0.9rem;
        padding: 8px 15px;
    }
</style>