@model MovieMania.Models.Movie

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Movie";
}

<div class="container mt-5">
    <div class="card card-dark p-4 shadow-lg">
        <h2 class="mb-4 text-center text-light">
            <i class="fas fa-plus-circle me-2 text-success"></i>Add New Movie
        </h2>

        <!-- Success Message -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@Html.Raw(TempData["Success"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Error Message -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@Html.Raw(TempData["Error"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Title" class="form-label text-light"></label>
                    <input asp-for="Title" class="form-control custom-input" placeholder="Enter movie title" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Genre" class="form-label text-light"></label>
                    <input asp-for="Genre" class="form-control custom-input" placeholder="e.g., Action, Comedy" />
                    <span asp-validation-for="Genre" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="ReleaseDate" class="form-label text-light"></label>
                    <input asp-for="ReleaseDate" type="date" class="form-control custom-input" />
                    <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="ReleaseYear" class="form-label text-light"></label>
                    <input asp-for="ReleaseYear" class="form-control custom-input" placeholder="2024" />
                    <span asp-validation-for="ReleaseYear" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Duration" class="form-label text-light"></label>
                    <input asp-for="Duration" class="form-control custom-input" placeholder="120" />
                    <span asp-validation-for="Duration" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Rating" class="form-label text-light"></label>
                    <input asp-for="Rating" class="form-control custom-input" placeholder="8.5" step="0.1" />
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Language" class="form-label text-light"></label>
                    <input asp-for="Language" class="form-control custom-input" placeholder="English" />
                    <span asp-validation-for="Language" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Country" class="form-label text-light"></label>
                    <input asp-for="Country" class="form-control custom-input" placeholder="USA" />
                    <span asp-validation-for="Country" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Director" class="form-label text-light"></label>
                    <input asp-for="Director" class="form-control custom-input" placeholder="Director name" />
                    <span asp-validation-for="Director" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Cast" class="form-label text-light"></label>
                    <input asp-for="Cast" class="form-control custom-input" placeholder="Actor1, Actor2, Actor3" />
                    <span asp-validation-for="Cast" class="text-danger"></span>
                </div>

                <div class="col-md-12 mb-3">
                    <label asp-for="Description" class="form-label text-light"></label>
                    <textarea asp-for="Description" class="form-control custom-input" rows="4" placeholder="Movie description..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="VideoUrl" class="form-label text-light"></label>
                    <input asp-for="VideoUrl" class="form-control custom-input" placeholder="https://example.com/video.mp4" />
                    <span asp-validation-for="VideoUrl" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="TrailerUrl" class="form-label text-light"></label>
                    <input asp-for="TrailerUrl" class="form-control custom-input" placeholder="https://youtube.com/watch?v=..." />
                    <span asp-validation-for="TrailerUrl" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ThumbnailUrl" class="form-label text-light"></label>
                    <input asp-for="ThumbnailUrl" class="form-control custom-input" placeholder="https://example.com/image.jpg" />
                    <span asp-validation-for="ThumbnailUrl" class="text-danger"></span>
                    <small class="text-muted">OR upload file below</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label text-light">Upload Thumbnail File</label>
                    <input type="file" name="ThumbnailFile" class="form-control custom-input" accept="image/*" />
                </div>

                <div class="col-md-6 mb-3">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" checked />
                        <label asp-for="IsActive" class="form-check-label text-light">Active</label>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <div class="form-check">
                        <input asp-for="IsFeatured" class="form-check-input" />
                        <label asp-for="IsFeatured" class="form-check-label text-light">Featured</label>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-success btn-custom px-5">
                    <i class="fas fa-save me-2"></i>Add Movie
                </button>
                <a asp-action="Index" class="btn btn-outline-light btn-custom px-4 ms-2">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>

        </form>
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 12px;
        max-width: 1000px;
        margin: auto;
    }

    .custom-input {
        background: #2a2a2a;
        border: 1px solid #444;
        color: white;
        border-radius: 8px;
        padding: 10px;
    }

        .custom-input:focus {
            background: #2a2a2a;
            color: white;
            border-color: #0d6efd;
            box-shadow: 0 0 8px rgba(13,110,253,0.4);
        }

        .custom-input::placeholder {
            color: #666;
        }

    .btn-custom {
        padding: 10px 20px;
        border-radius: 8px;
        transition: all 0.3s;
    }

    .btn-success {
        background: #00c853;
        border: none;
    }

        .btn-success:hover {
            background: #00e676;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,200,83,0.3);
        }

    .btn-outline-light:hover {
        background: white;
        color: black;
        transform: translateY(-2px);
    }

    .form-check-input:checked {
        background-color: #00c853;
        border-color: #00c853;
    }

    .text-danger {
        font-size: 0.85rem;
    }

    /* Alert styles */
    .alert {
        border: none;
        border-radius: 8px;
        padding: 15px 20px;
        margin-bottom: 20px;
    }

    .alert-success {
        background: rgba(0, 200, 83, 0.15);
        color: #00c853;
        border-left: 4px solid #00c853;
    }

    .alert-danger {
        background: rgba(255, 77, 77, 0.15);
        color: #ff4d4d;
        border-left: 4px solid #ff4d4d;
    }

    .btn-close {
        filter: invert(1);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}