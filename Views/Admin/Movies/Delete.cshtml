@model MovieMania.Models.Movie

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Movie";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card card-dark p-4 shadow-lg">

                <h2 class="text-center text-danger mb-4">
                    <i class="fas fa-trash me-2"></i>Delete Movie
                </h2>

                <div class="alert alert-warning">
                    <strong>Warning!</strong> This action will permanently delete the movie.
                </div>

                <div class="movie-details p-3 mb-4" style="background:#2a2a2a; border-radius:8px;">

                    <div class="text-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                        {
                            <img src="@Model.ThumbnailUrl"
                                 width="150"
                                 style="border-radius:8px;" />
                        }
                    </div>

                    <table class="table table-dark table-borderless">
                        <tr>
                            <th>Title</th>
                            <td>@Model.Title</td>
                        </tr>
                        <tr>
                            <th>Genre</th>
                            <td>@Model.Genre</td>
                        </tr>
                        <tr>
                            <th>Year</th>
                            <td>@Model.ReleaseYear</td>
                        </tr>
                        <tr>
                            <th>Duration</th>
                            <td>@Model.Duration mins</td>
                        </tr>
                        <tr>
                            <th>Rating</th>
                            <td>
                                @if (Model.Rating.HasValue)
                                {
                                    <span class="badge bg-warning">
                                        @Model.Rating.Value.ToString("F1")
                                    </span>
                                }
                            </td>
                        </tr>
                    </table>

                </div>

                <!-- IMPORTANT FIX: must match route Delete/{id} -->
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()

                    <div class="text-center">
                        <button type="submit" class="btn btn-danger btn-lg px-5">
                            <i class="fas fa-trash me-2"></i>Confirm Delete
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-light btn-lg px-5 ms-2">
                            Cancel
                        </a>
                    </div>
                </form>

            </div>

        </div>
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 12px;
    }

    .btn-danger {
        background: #dc3545;
        border: none;
        transition: all 0.3s;
    }

        .btn-danger:hover {
            background: #bb2d3b;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220,53,69,0.3);
        }

    .btn-outline-light:hover {
        background: white;
        color: black;
        transform: translateY(-2px);
    }

    .table-dark {
        --bs-table-bg: transparent;
    }
</style>