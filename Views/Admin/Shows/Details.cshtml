@model MovieMania.Models.Show

@{
    ViewData["Title"] = "Show Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="card card-dark p-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-light">
                <i class="fas fa-tv me-2 text-primary"></i>Show Details
            </h2>
            <div>
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary") p-3 me-2">
                    @(Model.IsActive ? "ACTIVE" : "INACTIVE")
                </span>
                @if (Model.IsFeatured)
                {
                    <span class="badge bg-info p-3">FEATURED</span>
                }
            </div>
        </div>

        <div class="row">
            <!-- Left Column - Show Info -->
            <div class="col-md-4">
                <div class="text-center mb-4">
                    @if (!string.IsNullOrEmpty(Model.PosterUrl))
                    {
                        <img src="@Model.PosterUrl" alt="@Model.Title" class="img-fluid rounded" style="max-height: 400px; border: 3px solid #ff4d4d;" />
                    }
                    else if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                    {
                        <img src="@Model.ThumbnailUrl" alt="@Model.Title" class="img-fluid rounded" style="max-height: 400px; border: 3px solid #ff4d4d;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-secondary rounded" style="height: 400px;">
                            <i class="fas fa-tv fa-5x text-muted"></i>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.TrailerUrl))
                {
                    <div class="text-center mb-4">
                        <a href="@Model.TrailerUrl" target="_blank" class="btn btn-danger">
                            <i class="fas fa-play me-2"></i>Watch Trailer
                        </a>
                    </div>
                }
            </div>

            <!-- Right Column - Show Details -->
            <div class="col-md-8">
                <div class="info-section p-4 mb-4" style="background: #2a2a2a; border-radius: 8px;">
                    <h3 class="text-light mb-3">@Model.Title</h3>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p><strong class="text-muted">Genre:</strong> <span class="text-white">@Model.Genre</span></p>
                            <p><strong class="text-muted">Release Year:</strong> <span class="text-white">@(Model.ReleaseYear ?? 0)</span></p>
                            <p><strong class="text-muted">Language:</strong> <span class="text-white">@Model.Language</span></p>
                            <p><strong class="text-muted">Country:</strong> <span class="text-white">@Model.Country</span></p>
                        </div>
                        <div class="col-md-6">
                            <p><strong class="text-muted">Total Seasons:</strong> <span class="text-white">@Model.TotalSeasons</span></p>
                            <p><strong class="text-muted">Total Episodes:</strong> <span class="text-white">@Model.TotalEpisodes</span></p>
                            <p>
                                <strong class="text-muted">Rating:</strong>
                                @if (Model.Rating.HasValue)
                                {
                                    <span class="badge bg-warning text-dark">@Model.Rating.Value.ToString("F1") ⭐</span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </p>
                            <p><strong class="text-muted">Views:</strong> <span class="text-white">@Model.ViewsCount</span></p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Director))
                    {
                        <p><strong class="text-muted">Director:</strong> <span class="text-white">@Model.Director</span></p>
                    }

                    @if (!string.IsNullOrEmpty(Model.Cast))
                    {
                        <p><strong class="text-muted">Cast:</strong> <span class="text-white">@Model.Cast</span></p>
                    }

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mt-3">
                            <h5 class="text-muted">Description</h5>
                            <p class="text-white">@Model.Description</p>
                        </div>
                    }
                </div>

                <!-- Episodes Section -->
                @if (Model.Episodes != null && Model.Episodes.Any())
                {
                    <div class="info-section p-4" style="background: #2a2a2a; border-radius: 8px;">
                        <h4 class="text-light mb-3">
                            <i class="fas fa-list me-2 text-primary"></i>Episodes
                        </h4>

                        @{
                            var episodesBySeason = Model.Episodes.GroupBy(e => e.SeasonNumber).OrderBy(g => g.Key);
                        }

                        @foreach (var season in episodesBySeason)
                        {
                            <div class="season-section mb-4">
                                <h5 class="text-warning mb-3">
                                    <i class="fas fa-layer-group me-2"></i>Season @season.Key
                                </h5>

                                <div class="table-responsive">
                                    <table class="table table-dark table-sm">
                                        <thead>
                                            <tr>
                                                <th>Episode</th>
                                                <th>Title</th>
                                                <th>Duration</th>
                                                <th>Release Date</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var episode in season.OrderBy(e => e.EpisodeNumber))
                                            {
                                                <tr>
                                                    <td class="fw-bold">E@(episode.EpisodeNumber)</td>
                                                    <td>@episode.Title</td>
                                                    <td>@(episode.Duration) min</td>
                                                    <td>@(episode.ReleaseDate?.ToString("dd MMM yyyy") ?? "TBA")</td>
                                                    <td>
                                                        @if (episode.IsActive)
                                                        {
                                                            <span class="badge bg-success">Active</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Inactive</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="info-section p-4 text-center" style="background: #2a2a2a; border-radius: 8px;">
                        <i class="fas fa-list fa-3x text-muted mb-3"></i>
                        <h5 class="text-light">No Episodes Yet</h5>
                        <p class="text-muted">Episodes will appear here once added.</p>
                        <a asp-controller="AdminEpisodes" asp-action="Create" asp-route-showId="@Model.Id" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Add Episode
                        </a>
                    </div>
                }

                <!-- Timeline Info -->
                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="info-section p-3" style="background: #2a2a2a; border-radius: 8px;">
                            <small class="text-muted">Created At</small>
                            <p class="text-white mb-0">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-section p-3" style="background: #2a2a2a; border-radius: 8px;">
                            <small class="text-muted">Last Updated</small>
                            <p class="text-white mb-0">@(Model.UpdatedAt?.ToString("dd MMM yyyy HH:mm") ?? "Never")</p>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="text-center mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg px-4">
                        <i class="fas fa-edit me-2"></i>Edit Show
                    </a>
                    <a asp-controller="AdminEpisodes" asp-action="Index" asp-route-showId="@Model.Id" class="btn btn-info btn-lg px-4 ms-2">
                        <i class="fas fa-list me-2"></i>Manage Episodes
                    </a>
                    <a asp-action="Index" class="btn btn-outline-light btn-lg px-4 ms-2">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 15px;
        max-width: 1400px;
        margin: auto;
    }

    .info-section {
        background: #2a2a2a;
        border-radius: 8px;
    }

    .season-section {
        border-left: 4px solid #ff4d4d;
        padding-left: 15px;
    }

        .season-section h5 {
            color: #ff4d4d;
        }

    .table-dark {
        --bs-table-bg: transparent;
    }

    .badge {
        font-size: 0.9rem;
        padding: 8px 15px;
    }

    .btn-lg {
        padding: 12px 25px;
        border-radius: 10px;
    }
</style>