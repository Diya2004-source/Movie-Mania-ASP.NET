@model IEnumerable<MovieMania.Models.Wishlist>

@{
    ViewData["Title"] = $"Wishlist - {ViewBag.UserName}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="card card-dark p-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-light">
                <i class="fas fa-heart me-2 text-danger"></i>@ViewBag.UserName's Wishlist
            </h2>
            <div>
                <span class="badge bg-info me-2 p-2">Total Items: @Model.Count()</span>
                <a asp-action="Index" class="btn btn-outline-light btn-sm">
                    <i class="fas fa-arrow-left me-2"></i>Back to All
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover table-striped mb-0">
                <thead class="table-secondary text-dark">
                    <tr>
                        <th>Item</th>
                        <th>Type</th>
                        <th>Added Date</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Rating</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="wishlist-row">
                            <td>
                                @if (item.ItemType == "Movie" && item.Movie != null)
                                {
                                    <div>
                                        <strong class="text-white">@item.Movie.Title</strong><br />
                                        <small class="text-muted">@(item.Movie.ReleaseYear)</small>
                                    </div>
                                }
                                else if (item.ItemType == "Show" && item.Show != null)
                                {
                                    <div>
                                        <strong class="text-white">@item.Show.Title</strong><br />
                                        <small class="text-muted">@(item.Show.TotalSeasons) Seasons</small>
                                    </div>
                                }
                            </td>
                            <td>
                                @if (item.ItemType == "Movie")
                                {
                                    <span class="badge bg-primary px-3 py-2">Movie</span>
                                }
                                else
                                {
                                    <span class="badge bg-info px-3 py-2">Show</span>
                                }
                            </td>
                            <td class="text-white">@item.AddedDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (item.Priority == 1)
                                {
                                    <span class="badge bg-danger px-3 py-2">High</span>
                                }
                                else if (item.Priority == 2)
                                {
                                    <span class="badge bg-warning px-3 py-2">Medium</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">Low</span>
                                }
                            </td>
                            <td>
                                @if (item.IsWatched)
                                {
                                    <span class="badge bg-success px-3 py-2">Watched</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">Unwatched</span>
                                }
                            </td>
                            <td>
                                @if (item.UserRating.HasValue)
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">
                                        @item.UserRating.Value.ToString("F1") ⭐
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm text-white" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>