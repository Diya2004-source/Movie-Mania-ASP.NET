@model IEnumerable<MovieMania.Models.Wishlist>

@{
    ViewData["Title"] = ViewBag.Type ?? "Wishlist Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="card card-dark p-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-light">
                <i class="fas fa-heart me-2 text-danger"></i>@(ViewBag.Type ?? "Wishlist Management")
            </h2>
            <div>
                <span class="badge bg-info me-2 p-2">Total Items: @Model.Count()</span>
                <div class="btn-group">
                    <a asp-action="Index" class="btn btn-outline-primary btn-sm">All</a>
                    <a asp-action="Movies" class="btn btn-outline-primary btn-sm">Movies</a>
                    <a asp-action="Shows" class="btn btn-outline-primary btn-sm">Shows</a>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@Html.Raw(TempData["Success"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@Html.Raw(TempData["Error"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-dark table-hover table-striped mb-0">
                <thead class="table-secondary text-dark">
                    <tr>
                        <th>User</th>
                        <th>Item</th>
                        <th>Type</th>
                        <th>Added Date</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Rating</th>
                        <th>Progress</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="wishlist-row">
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-user-circle fa-2x me-2 text-secondary"></i>
                                    <div>
                                        <strong class="text-white">@(item.User?.Name ?? "Unknown")</strong><br />
                                        <small class="text-muted">@(item.User?.Email ?? "No email")</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (item.ItemType == "Movie" && item.Movie != null)
                                {
                                    <div>
                                        <strong class="text-white">@item.Movie.Title</strong><br />
                                        <small class="text-muted">@(item.Movie.ReleaseYear)</small>
                                    </div>
                                }
                                else if (item.ItemType == "Show" && item.Show != null)
                                {
                                    <div>
                                        <strong class="text-white">@item.Show.Title</strong><br />
                                        <small class="text-muted">@(item.Show.TotalSeasons) Seasons</small>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">Item not available</span>
                                }
                            </td>
                            <td>
                                @if (item.ItemType == "Movie")
                                {
                                    <span class="badge bg-primary px-3 py-2"><i class="fas fa-film me-1"></i>Movie</span>
                                }
                                else
                                {
                                    <span class="badge bg-info px-3 py-2"><i class="fas fa-tv me-1"></i>Show</span>
                                }
                            </td>
                            <td class="text-white">@item.AddedDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (item.Priority == 1)
                                {
                                    <span class="badge bg-danger px-3 py-2">High</span>
                                }
                                else if (item.Priority == 2)
                                {
                                    <span class="badge bg-warning px-3 py-2">Medium</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">Low</span>
                                }
                            </td>
                            <td>
                                @if (item.IsWatched)
                                {
                                    <span class="badge bg-success px-3 py-2">Watched</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">Unwatched</span>
                                }
                            </td>
                            <td>
                                @if (item.UserRating.HasValue)
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">
                                        <i class="fas fa-star me-1"></i>@item.UserRating.Value.ToString("F1")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (item.ItemType == "Show" && item.Show != null)
                                {
                                    <span class="text-white">
                                        S@(item.WatchedSeasons ?? 0)/@(item.Show?.TotalSeasons ?? 0)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm text-white" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-heart-broken fa-4x mb-3"></i>
                <h5 class="text-light">No wishlist items found</h5>
                <p class="text-muted">Wishlist items will appear here when users add movies or shows.</p>
            </div>
        }
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    /* Table Styling */
    .table {
        border-collapse: separate;
        border-spacing: 0 5px;
        width: 100%;
    }

        .table thead th {
            background: #2a2a2a;
            color: #fff;
            font-weight: 600;
            border: none;
            padding: 15px 12px;
            white-space: nowrap;
        }

        .table tbody tr {
            background: #1e1e1e;
            transition: all 0.2s ease;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        }

            .table tbody tr:hover {
                background: #252525;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(255, 77, 77, 0.2);
            }

                .table tbody tr:hover td,
                .table tbody tr:hover td span,
                .table tbody tr:hover td .text-white,
                .table tbody tr:hover td .fw-bold {
                    color: #ffffff !important;
                }

                .table tbody tr:hover .text-muted {
                    color: #aaa !important;
                }

        .table td {
            padding: 15px 12px;
            vertical-align: middle;
            border: none;
            color: #fff;
        }

    /* Badge Styling */
    .badge {
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: 20px;
    }

        .badge.bg-success {
            background: #00c853 !important;
        }

        .badge.bg-warning {
            background: #ffc107 !important;
            color: #000 !important;
        }

        .badge.bg-danger {
            background: #ff4d4d !important;
        }

        .badge.bg-info {
            background: #0dcaf0 !important;
            color: #000 !important;
        }

        .badge.bg-primary {
            background: #4A80F0 !important;
        }

        .badge.bg-secondary {
            background: #6c757d !important;
        }

    /* Button Group Styling */
    .btn-group {
        gap: 5px;
    }

    .btn-sm {
        width: 32px;
        height: 32px;
        border-radius: 8px !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        border: none;
        margin: 0 2px;
    }

        .btn-sm:hover {
            transform: scale(1.1);
        }

    .btn-info {
        background: #0dcaf0;
    }

        .btn-info:hover {
            background: #0bb7d6;
        }

    .btn-outline-primary {
        border-color: #4A80F0;
        color: #4A80F0;
    }

        .btn-outline-primary:hover {
            background: #4A80F0;
            color: white;
        }

    /* Alert Styling */
    .alert {
        border: none;
        border-radius: 10px;
        padding: 15px 20px;
        margin-bottom: 20px;
    }

    .alert-success {
        background: rgba(0, 200, 83, 0.15);
        color: #00c853;
        border-left: 4px solid #00c853;
    }

    .alert-danger {
        background: rgba(255, 77, 77, 0.15);
        color: #ff4d4d;
        border-left: 4px solid #ff4d4d;
    }

    .btn-close {
        filter: invert(1);
    }
</style>