@model IEnumerable<MovieMania.Models.Episode>

@{
    ViewData["Title"] = $"Episodes - {ViewBag.ShowTitle}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="card card-dark p-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-light">
                <i class="fas fa-list me-2 text-primary"></i>Episodes - @ViewBag.ShowTitle
            </h2>
            <div>
                <span class="badge bg-info me-2 p-2">Total Episodes: @Model.Count()</span>
                <span class="badge bg-warning me-2 p-2">Seasons: @ViewBag.TotalSeasons</span>
                <a asp-action="Create" asp-route-showId="@ViewBag.ShowId" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Add Episode
                </a>
                <a asp-controller="AdminShows" asp-action="Index" class="btn btn-outline-light btn-sm">
                    <i class="fas fa-arrow-left me-2"></i>Back to Shows
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@Html.Raw(TempData["Success"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@Html.Raw(TempData["Error"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.Any())
        {
            var episodesBySeason = Model.GroupBy(e => e.SeasonNumber).OrderBy(g => g.Key);

            @foreach (var season in episodesBySeason)
            {
                <div class="season-section mb-4">
                    <h4 class="text-warning mb-3">
                        <i class="fas fa-layer-group me-2"></i>Season @season.Key
                    </h4>

                    <div class="table-responsive">
                        <table class="table table-dark table-hover table-striped mb-0">
                            <thead class="table-secondary text-dark">
                                <tr>
                                    <th>Thumbnail</th>
                                    <th>Episode</th>
                                    <th>Title</th>
                                    <th>Duration</th>
                                    <th>Release Date</th>
                                    <th>Status</th>
                                    <th>Views</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var episode in season.OrderBy(e => e.EpisodeNumber))
                                {
                                    <tr class="episode-row">
                                        <td>
                                            @if (!string.IsNullOrEmpty(episode.ThumbnailUrl))
                                            {
                                                <img src="@episode.ThumbnailUrl" width="60" height="60" style="border-radius:8px; object-fit:cover; border: 2px solid #ff4d4d;" />
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center justify-content-center"
                                                     style="width:60px; height:60px; background: #2a2a2a; border-radius:8px; border: 2px solid #ff4d4d;">
                                                    <i class="fas fa-play-circle fa-2x text-muted"></i>
                                                </div>
                                            }
                                        </td>
                                        <td class="fw-bold text-white">S@(episode.SeasonNumber)E@(episode.EpisodeNumber)</td>
                                        <td class="text-white">@episode.Title</td>
                                        <td class="text-white">@(episode.Duration) min</td>
                                        <td class="text-white">@(episode.ReleaseDate?.ToString("dd MMM yyyy") ?? "TBA")</td>
                                        <td>
                                            @if (episode.IsActive)
                                            {
                                                <span class="badge bg-success px-3 py-2">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary px-3 py-2">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-white">@episode.ViewsCount</td>
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <a asp-action="Edit" asp-route-id="@episode.Id"
                                                   class="btn btn-warning btn-sm" title="Edit Episode">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@episode.Id"
                                                   class="btn btn-danger btn-sm" title="Delete Episode">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                                <button type="button"
                                                        class="btn btn-info btn-sm toggle-status"
                                                        data-id="@episode.Id"
                                                        data-active="@episode.IsActive"
                                                        title="@(episode.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="fas fa-@(episode.IsActive ? "toggle-on" : "toggle-off")"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-list fa-4x mb-3"></i>
                <h5 class="text-light">No episodes found</h5>
                <p class="text-muted">Click "Add Episode" to create your first episode.</p>
                <a asp-action="Create" asp-route-showId="@ViewBag.ShowId" class="btn btn-primary mt-3">
                    <i class="fas fa-plus me-2"></i>Add Episode
                </a>
            </div>
        }
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .season-section {
        border-left: 4px solid red;
        padding-left: 15px;
    }

        .season-section h4 {
            color: #ff4d4d;
        }

    /* Table Styling */
    .table {
        border-collapse: separate;
        border-spacing: 0 5px;
        width: 100%;
    }

        .table thead th {
            background: #2a2a2a;
            color: #fff;
            font-weight: 600;
            border: none;
            padding: 12px 10px;
            white-space: nowrap;
        }

        .table tbody tr {
            background: #1e1e1e;
            transition: all 0.2s ease;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        }

            .table tbody tr:hover {
                background: #252525;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(255, 77, 77, 0.2);
            }

                .table tbody tr:hover td,
                .table tbody tr:hover td span,
                .table tbody tr:hover td .text-white,
                .table tbody tr:hover td .fw-bold {
                    color: #ffffff !important;
                }

        .table td {
            padding: 12px 10px;
            vertical-align: middle;
            border: none;
            color: #fff;
        }

    /* Badge Styling */
    .badge {
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: 20px;
    }

        .badge.bg-success {
            background: #00c853 !important;
        }

        .badge.bg-secondary {
            background: #6c757d !important;
        }

    /* Button Group Styling */
    .btn-group {
        gap: 5px;
    }

    .btn-sm {
        width: 32px;
        height: 32px;
        border-radius: 8px !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        border: none;
        margin: 0 2px;
    }

        .btn-sm:hover {
            transform: scale(1.1);
        }

    .btn-warning {
        background: #ffc107;
    }

        .btn-warning:hover {
            background: #ffb300;
        }

    .btn-danger {
        background: #ff4d4d;
    }

        .btn-danger:hover {
            background: #ff3333;
        }

    .btn-info {
        background: #0dcaf0;
    }

        .btn-info:hover {
            background: #0bb7d6;
        }

    /* Alert Styling */
    .alert {
        border: none;
        border-radius: 10px;
        padding: 15px 20px;
        margin-bottom: 20px;
    }

    .alert-success {
        background: rgba(0, 200, 83, 0.15);
        color: #00c853;
        border-left: 4px solid #00c853;
    }

    .alert-danger {
        background: rgba(255, 77, 77, 0.15);
        color: #ff4d4d;
        border-left: 4px solid #ff4d4d;
    }

    .btn-close {
        filter: invert(1);
    }
</style>

@section Scripts {
    <script>
        // Toggle status with AJAX
        $('.toggle-status').click(function() {
            var button = $(this);
            var id = button.data('id');
            var isActive = button.data('active');

            $.post('@Url.Action("ToggleStatus", "AdminEpisodes")/' + id)
                .done(function(response) {
                    if (response.success) {
                        // Update button icon and data
                        button.find('i').attr('class', 'fas fa-' + (response.isActive ? 'toggle-on' : 'toggle-off'));
                        button.data('active', response.isActive);
                        button.attr('title', response.isActive ? 'Deactivate' : 'Activate');

                        // Update status badge
                        var statusCell = button.closest('tr').find('td:eq(5)');
                        if (response.isActive) {
                            statusCell.html('<span class="badge bg-success px-3 py-2">Active</span>');
                        } else {
                            statusCell.html('<span class="badge bg-secondary px-3 py-2">Inactive</span>');
                        }

                        // Show success message
                        toastr.success(response.message);
                    }
                })
                .fail(function() {
                    toastr.error('Error toggling episode status');
                });
        });
    </script>
}