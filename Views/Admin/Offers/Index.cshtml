@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <script>
        // Configure toastr
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000",
            "extendedTimeOut": "1000",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };

        // Toggle status with AJAX
        $('.toggle-status').click(function() {
            var button = $(this);
            var id = button.data('id');
            var isActive = button.data('active');

            $.post('@Url.Action("Activate", "AdminOffers")/' + id)
                .done(function(response) {
                    if (response.success) {
                        // Update button icon and data
                        button.find('i').attr('class', 'fas fa-' + (response.isActive ? 'toggle-on' : 'toggle-off'));
                        button.data('active', response.isActive);
                        button.attr('title', response.isActive ? 'Deactivate' : 'Activate');

                        // Update status badge
                        var statusCell = button.closest('tr').find('td:eq(5)');
                        if (response.isActive) {
                            statusCell.html('<span class="badge bg-success px-3 py-2">Active</span>');
                        } else {
                            statusCell.html('<span class="badge bg-secondary px-3 py-2">Inactive</span>');
                        }

                        // Show success message
                        toastr.success(response.message);
                    }
                })
                .fail(function() {
                    toastr.error('Error toggling offer status');
                });
        });
    </script>
}