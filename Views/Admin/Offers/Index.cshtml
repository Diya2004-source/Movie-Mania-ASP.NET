@model IEnumerable<MovieMania.Models.Offer>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Offer Management";
}

<div class="container mt-4">
    <div class="card card-dark p-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-light">
                <i class="fas fa-tags me-2 text-primary"></i>Offer Management
            </h2>
            <div>
                <span class="badge bg-info me-2 p-2">Total Offers: @Model.Count()</span>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Create Offer
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@Html.Raw(TempData["Success"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@Html.Raw(TempData["Error"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-dark table-hover table-striped mb-0">
                <thead class="table-secondary text-dark">
                    <tr>
                        <th>Title</th>
                        <th>Code</th>
                        <th>Discount</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Uses</th>
                        <th>Plan</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var offer in Model.OrderByDescending(o => o.CreatedAt))
                    {
                        <tr class="offer-row">
                            <td class="fw-bold text-white">@offer.Title</td>
                            <td>
                                @if (!string.IsNullOrEmpty(offer.OfferCode))
                                {
                                    <span class="badge bg-secondary px-3 py-2">@offer.OfferCode</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-success px-3 py-2">
                                    @offer.DiscountPercentage%
                                </span>
                            </td>
                            <td class="text-white">@offer.StartDate.ToString("dd MMM yyyy")</td>
                            <td class="text-white">@offer.EndDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @{
                                    var now = DateTime.Now;
                                    if (offer.IsActive && offer.EndDate >= now)
                                    {
                                        <span class="badge bg-success px-3 py-2">Active</span>
                                    }
                                    else if (!offer.IsActive)
                                    {
                                        <span class="badge bg-secondary px-3 py-2">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning px-3 py-2">Expired</span>
                                    }
                                }
                            </td>
                            <td class="text-center text-white">
                                @offer.CurrentUses / @(offer.MaxUses?.ToString() ?? "∞")
                            </td>
                            <td>
                                @if (offer.SubscriptionPlan != null)
                                {
                                    <span class="badge bg-info text-dark px-3 py-2">@offer.SubscriptionPlan.Name</span>
                                }
                                else
                                {
                                    <span class="text-muted">All Plans</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@offer.Id"
                                       class="btn btn-warning btn-sm" title="Edit Offer">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@offer.Id"
                                       class="btn btn-danger btn-sm" title="Delete Offer">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-info btn-sm toggle-status"
                                            data-id="@offer.Id"
                                            data-active="@offer.IsActive"
                                            title="@(offer.IsActive ? "Deactivate" : "Activate")">
                                        <i class="fas fa-@(offer.IsActive ? "toggle-on" : "toggle-off")"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-tags fa-4x mb-3"></i>
                <h5 class="text-light">No offers found</h5>
                <p class="text-muted">Click "Create Offer" to add your first offer.</p>
                <a asp-action="Create" class="btn btn-primary mt-3">
                    <i class="fas fa-plus me-2"></i>Create Offer
                </a>
            </div>
        }
    </div>
</div>

