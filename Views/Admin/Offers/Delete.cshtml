@model MovieMania.Models.Offer

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <div class="card card-dark p-4 shadow-lg" style="max-width: 500px; margin: auto;">
        <h3 class="text-danger text-center mb-4">
            <i class="fas fa-exclamation-triangle"></i> Delete Offer
        </h3>

        <div class="alert alert-warning text-center">
            <p class="mb-0">Are you sure you want to delete this offer?</p>
            <p class="fw-bold text-danger">This action cannot be undone.</p>
        </div>

        <div class="offer-details mb-4 p-3" style="background: #2a2a2a; border-radius: 8px;">
            <h5 class="text-center text-light">@Model.Title</h5>
            <hr style="border-color: #444;">

            <div class="row">
                <div class="col-6 text-muted">Discount:</div>
                <div class="col-6 text-end text-light">
                    <span class="badge bg-success">@Model.DiscountPercentage%</span>
                </div>

                <div class="col-6 text-muted mt-2">Offer Code:</div>
                <div class="col-6 text-end text-light mt-2">
                    <span class="badge bg-info">@(Model.OfferCode ?? "N/A")</span>
                </div>

                <div class="col-6 text-muted mt-2">Valid Period:</div>
                <div class="col-6 text-end text-light mt-2">
                    @Model.StartDate.ToString("dd MMM") - @Model.EndDate.ToString("dd MMM yyyy")
                </div>

                <div class="col-6 text-muted mt-2">Status:</div>
                <div class="col-6 text-end text-light mt-2">
                    @if (Model.IsActive && Model.EndDate >= DateTime.Now)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </div>

                <div class="col-6 text-muted mt-2">Uses:</div>
                <div class="col-6 text-end text-light mt-2">
                    @Model.CurrentUses / @(Model.MaxUses?.ToString() ?? "∞")
                </div>
            </div>
        </div>

        <form method="post" asp-action="Delete" class="text-center">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger btn-lg px-5">
                <i class="fas fa-trash"></i> Yes, Delete
            </button>

            <a asp-action="Index" class="btn btn-outline-light btn-lg px-5 ms-2">
                <i class="fas fa-times"></i> Cancel
            </a>
        </form>
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 12px;
    }

    .btn-danger {
        background: #dc3545;
        border: none;
        transition: 0.3s;
    }

        .btn-danger:hover {
            background: #bb2d3b;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220,53,69,0.4);
        }

    .btn-outline-light:hover {
        background: white;
        color: black;
        transform: translateY(-2px);
    }

    .badge {
        font-size: 0.9rem;
        padding: 5px 10px;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}