@model MovieMania.Models.Offer

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Offer";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-dark p-4 shadow-lg">
                <h2 class="text-center text-danger mb-4">
                    <i class="fas fa-exclamation-triangle me-2"></i>Delete Offer
                </h2>

                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    Are you sure you want to delete this offer?
                    <strong>This action cannot be undone.</strong>
                </div>

                <div class="offer-details p-4 mb-4" style="background: #2a2a2a; border-radius: 10px;">
                    <h5 class="text-center text-light mb-3">@Model.Title</h5>
                    <hr style="border-color: #444;">

                    <div class="row mt-3">
                        <div class="col-6">
                            <div class="detail-item mb-3">
                                <small class="text-muted d-block">Discount</small>
                                <span class="badge bg-success fs-6 p-2">@Model.DiscountPercentage%</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="detail-item mb-3">
                                <small class="text-muted d-block">Offer Code</small>
                                @if (!string.IsNullOrEmpty(Model.OfferCode))
                                {
                                    <span class="badge bg-info fs-6 p-2">@Model.OfferCode</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="detail-item mb-3">
                                <small class="text-muted d-block">Valid From</small>
                                <span class="text-white">@Model.StartDate.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="detail-item mb-3">
                                <small class="text-muted d-block">Valid Until</small>
                                <span class="text-white">@Model.EndDate.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="detail-item mb-3">
                                <small class="text-muted d-block">Status</small>
                                @if (Model.IsActive && Model.EndDate >= DateTime.Now)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="detail-item mb-3">
                                <small class="text-muted d-block">Usage</small>
                                <span class="text-white">@Model.CurrentUses / @(Model.MaxUses?.ToString() ?? "∞")</span>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="detail-item mt-2">
                            <small class="text-muted d-block">Description</small>
                            <p class="text-white mt-1">@Model.Description</p>
                        </div>
                    }
                </div>

                <form asp-action="Delete" method="post" class="text-center">
                    <input type="hidden" asp-for="Id" />

                    <button type="submit" class="btn btn-danger btn-lg px-5">
                        <i class="fas fa-trash me-2"></i>Delete Offer
                    </button>

                    <a asp-action="Index" class="btn btn-outline-light btn-lg px-5 ms-2">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 15px;
    }

    .btn-danger {
        background: #ff4d4d;
        border: none;
        transition: all 0.3s;
    }

        .btn-danger:hover {
            background: #ff3333;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255,77,77,0.3);
        }

    .btn-outline-light:hover {
        background: white;
        color: black;
        transform: translateY(-2px);
    }

    .badge {
        font-size: 0.9rem;
        padding: 5px 10px;
    }

    .detail-item {
        background: #1e1e1e;
        padding: 10px;
        border-radius: 8px;
    }

        .detail-item small {
            margin-bottom: 5px;
        }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}