@model MovieMania.Models.Offer

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <div class="card card-dark p-4 shadow-lg">
        <h2 class="mb-4 text-center text-light">Edit Offer</h2>

        <form method="post" asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="CurrentUses" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label text-light"></label>
                <input asp-for="Title" class="form-control custom-input" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label text-light"></label>
                <textarea asp-for="Description" class="form-control custom-input" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="DiscountPercentage" class="form-label text-light"></label>
                    <input asp-for="DiscountPercentage" class="form-control custom-input" type="number" min="1" max="100" />
                    <span asp-validation-for="DiscountPercentage" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="OfferCode" class="form-label text-light"></label>
                    <input asp-for="OfferCode" class="form-control custom-input" />
                    <span asp-validation-for="OfferCode" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="MaxUses" class="form-label text-light"></label>
                    <input asp-for="MaxUses" class="form-control custom-input" type="number" min="1" />
                    <span asp-validation-for="MaxUses" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StartDate" class="form-label text-light"></label>
                    <input asp-for="StartDate" type="date" class="form-control custom-input" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="EndDate" class="form-label text-light"></label>
                    <input asp-for="EndDate" type="date" class="form-control custom-input" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SubscriptionPlanId" class="form-label text-light"></label>
                    <select asp-for="SubscriptionPlanId" class="form-control custom-input" asp-items="ViewBag.Plans">
                        <option value="">-- Select Plan (Optional) --</option>
                    </select>
                    <span asp-validation-for="SubscriptionPlanId" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="CurrentUses" class="form-label text-light"></label>
                    <input asp-for="CurrentUses" class="form-control custom-input" type="number" min="0" readonly disabled />
                </div>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label text-light">Active</label>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-warning btn-custom px-5">Update Offer</button>
                <a asp-action="Index" class="btn btn-outline-light ms-2 btn-custom px-4">Cancel</a>
            </div>

        </form>
    </div>
</div>

<style>
    body {
        background: #0f0f0f;
    }

    .card-dark {
        background: #1c1c1c;
        border: none;
        border-radius: 12px;
        max-width: 800px;
        margin: auto;
    }

    .custom-input {
        background: #2a2a2a;
        border: 1px solid #444;
        color: white;
        border-radius: 8px;
        padding: 10px;
    }

        .custom-input:focus {
            background: #2a2a2a;
            color: white;
            border-color: #ffc107;
            box-shadow: 0 0 8px rgba(255,193,7,0.4);
        }

    .btn-custom {
        padding: 10px 20px;
        border-radius: 8px;
        transition: 0.3s;
        font-weight: 500;
    }

    .btn-warning {
        background: #ffc107;
        border: none;
        color: #000;
    }

        .btn-warning:hover {
            background: #ffca2c;
            transform: translateY(-2px);
        }

    .btn-outline-light:hover {
        background: white;
        color: black;
        transform: translateY(-2px);
    }

    input:disabled, input[readonly] {
        background: #333 !important;
        color: #888 !important;
        cursor: not-allowed;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}