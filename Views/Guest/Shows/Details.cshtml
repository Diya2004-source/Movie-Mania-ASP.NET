@model MovieMania.ViewModels.GuestShowDetailsViewModel

@{
    ViewData["Title"] = Model.Show.Title;
    Layout = "~/Views/Shared/_GuestLayout.cshtml";
}

<div class="container-fluid p-0">
    <!-- Hero Section -->
    <div class="show-hero" style="background-image: url('@(Model.Show.PosterUrl ?? "/images/default-backdrop.jpg")');">
        <div class="hero-overlay">
            <div class="container h-100">
                <div class="row h-100 align-items-center">
                    <div class="col-lg-8">
                        <div class="hero-content">
                            <div class="badge-group mb-4">
                                <span class="badge bg-primary">TV Series</span>
                                @if (Model.AverageRating > 0)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-star me-1"></i>@Model.AverageRating.ToString("F1")
                                    </span>
                                }
                            </div>

                            <h1 class="display-3 fw-bold text-white mb-3">@Model.Show.Title</h1>

                            <div class="movie-meta mb-4">
                                @if (Model.Show.ReleaseYear.HasValue)
                                {
                                    <span class="meta-item"><i class="far fa-calendar me-2"></i>@Model.Show.ReleaseYear</span>
                                }
                                <span class="meta-item"><i class="fas fa-tag me-2"></i>@Model.Show.Genre</span>
                                <span class="meta-item"><i class="fas fa-layer-group me-2"></i>@Model.TotalSeasons Seasons</span>
                                @if (Model.Show.Rating.HasValue)
                                {
                                    <span class="meta-item"><i class="fas fa-star text-warning me-2"></i>@Model.Show.Rating.Value.ToString("F1")/10</span>
                                }
                            </div>

                            <p class="hero-description mb-4">
                                @Model.Show.Description
                            </p>

                            <div class="hero-actions">
                                @if (Model.Episodes.Any())
                                {
                                    <a href="#seasons" class="btn btn-primary btn-lg me-3">
                                        <i class="fas fa-play me-2"></i>Start Watching
                                    </a>
                                }
                                <button class="btn btn-outline-light btn-lg" onclick="toggleWishlist(@Model.Show.Id, 'show')">
                                    <i class="fas fa-heart me-2"></i>
                                    @(Model.IsInWishlist ? "Remove from Wishlist" : "Add to Wishlist")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Episodes by Season -->
    <div id="seasons" class="container py-5">
        @foreach (var season in Model.EpisodesBySeason.OrderBy(s => s.Key))
        {
            <div class="season-section mb-5">
                <h3 class="text-white mb-4">
                    <i class="fas fa-layer-group text-primary me-2"></i>
                    Season @season.Key
                </h3>
                <div class="row g-4">
                    @foreach (var episode in season.Value.OrderBy(e => e.EpisodeNumber))
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6">
                            <div class="episode-card">
                                <div class="episode-thumbnail">
                                    <img src="@(episode.ThumbnailUrl ?? "/images/default-episode.jpg")"
                                         alt="@episode.Title"
                                         class="img-fluid">
                                    <div class="episode-overlay">
                                        <a href="@Url.Action("Watch", "GuestShows", new { id = episode.Id })"
                                           class="btn btn-watch-episode">
                                            <i class="fas fa-play me-2"></i>Watch
                                        </a>
                                    </div>
                                    @if (episode.Duration.HasValue)
                                    {
                                        <span class="episode-duration">
                                            <i class="far fa-clock me-1"></i>@episode.Duration min
                                        </span>
                                    }
                            </div>
                            <div class="episode-info">
                                <h6 class="episode-title">
                                    @episode.EpisodeNumber. @episode.Title
                                </h6>
                                <p class="episode-description">
                                    @(episode.Description?.Length > 60
                                                                    ? episode.Description.Substring(0, 60) + "..."
                                                                    : episode.Description)
                            </p>
                        </div>
                    </div>
                </div>
                                }
                </div>
            </div>
        }
    </div>

    <!-- Similar Shows -->
    @if (Model.SimilarShows.Any())
    {
        <section class="similar-section py-5 bg-dark">
            <div class="container">
                <h3 class="text-white mb-4">
                    <i class="fas fa-film text-primary me-2"></i>
                    Similar Shows You Might Like
                </h3>
                <div class="row g-4">
                    @foreach (var show in Model.SimilarShows)
                    {
                        <div class="col-lg-2 col-md-3 col-sm-4 col-6">
                            <div class="show-card" onclick="location.href='@Url.Action("Details", new { id = show.Id })'">
                                <div class="show-poster">
                                    <img src="@(show.ThumbnailUrl ?? "/images/default-show.jpg")"
                                         alt="@show.Title"
                                         class="img-fluid">
                                </div>
                                <div class="show-info">
                                    <h6>@show.Title</h6>
                                    <small>@show.Genre</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
</div>

<style>
    .show-hero {
        min-height: 80vh;
        background-size: cover;
        background-position: center;
        position: relative;
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(90deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.6) 50%, transparent 100%);
        display: flex;
        align-items: center;
    }

    .hero-content {
        color: white;
    }

    .badge-group .badge {
        padding: 8px 16px;
        font-size: 0.9rem;
        margin-right: 10px;
    }

    .movie-meta {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .meta-item {
        color: #e5e7eb;
        font-size: 1rem;
    }

    .hero-description {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #d1d5db;
        max-width: 600px;
    }

    .episode-card {
        background: #1E1E1E;
        border-radius: 10px;
        overflow: hidden;
        transition: transform 0.3s;
        height: 100%;
    }

        .episode-card:hover {
            transform: translateY(-5px);
        }

    .episode-thumbnail {
        position: relative;
        aspect-ratio: 16/9;
        overflow: hidden;
    }

        .episode-thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }

    .episode-card:hover .episode-thumbnail img {
        transform: scale(1.1);
    }

    .episode-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s;
    }

    .episode-card:hover .episode-overlay {
        opacity: 1;
    }

    .btn-watch-episode {
        background: #4A80F0;
        color: white;
        padding: 10px 20px;
        border-radius: 25px;
        text-decoration: none;
        transform: translateY(20px);
        transition: all 0.3s;
    }

    .episode-card:hover .btn-watch-episode {
        transform: translateY(0);
    }

    .btn-watch-episode:hover {
        background: #3768d8;
        color: white;
    }

    .episode-duration {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: rgba(0,0,0,0.7);
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.8rem;
    }

    .episode-info {
        padding: 12px;
    }

    .episode-title {
        color: white;
        font-size: 0.95rem;
        font-weight: 600;
        margin: 0 0 5px 0;
    }

    .episode-description {
        color: #888;
        font-size: 0.8rem;
        margin: 0;
        line-height: 1.4;
    }

    .show-card {
        cursor: pointer;
        transition: transform 0.3s;
    }

        .show-card:hover {
            transform: scale(1.05);
        }

    .show-poster {
        aspect-ratio: 2/3;
        overflow: hidden;
        border-radius: 8px;
    }

        .show-poster img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .show-info {
        margin-top: 8px;
    }

        .show-info h6 {
            color: white;
            font-size: 0.9rem;
            margin: 0;
        }

        .show-info small {
            color: #888;
            font-size: 0.8rem;
        }

    @@media (max-width: 768px) {
        .hero-content {
            text-align: center;
        }

        .movie-meta {
            justify-content: center;
        }

        .hero-description {
            margin-left: auto;
            margin-right: auto;
        }
    }
</style>

@section Scripts {
    <script>
        function toggleWishlist(showId, type) {
            // Check if user is logged in
            @if (User.Identity?.IsAuthenticated == true)
            {
                    <text>
                    $.post('@Url.Action("ToggleWishlist", "Wishlist")', { itemId: showId, itemType: type })
                        .done(function(response) {
                            if (response.success) {
                                toastr.success(response.message);
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                toastr.error(response.message);
                            }
                        })
                        .fail(function() {
                            toastr.error('Error updating wishlist');
                        });
                    </text>
            }
            else
            {
                    <text>
                    toastr.warning('Please login to add to wishlist');
                    setTimeout(function() {
                        window.location.href = '@Url.Action("Login", "Auth")';
                    }, 2000);
                    </text>
            }
        }
    </script>
}