@model MovieMania.ViewModels.GuestMovieDetailsViewModel

@{
    Layout = "~/Views/Shared/_GuestLayout.cshtml";
    ViewData["Title"] = Model.Movie.Title;
}

<div class="movie-details-page">
    <!-- Hero Section -->
    <section class="movie-hero"
             style="background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.9)),
                    url('@(Model.Movie.ThumbnailUrl ?? "/images/default-backdrop.jpg")') center/cover no-repeat fixed;">

        <div class="container">
            <div class="row align-items-center min-vh-60">
                <div class="col-lg-3 col-md-4 mb-4 mb-md-0" data-aos="fade-right">
                    <div class="movie-poster-wrapper">
                        <img src="@(Model.Movie.ThumbnailUrl ?? "/images/default-movie.jpg")"
                             alt="@Model.Movie.Title"
                             class="img-fluid rounded movie-poster">
                        @if (Model.Movie.Rating.HasValue)
                        {
                            <div class="rating-badge">
                                <i class="fas fa-star text-warning"></i>
                                <span>@Model.Movie.Rating.Value.ToString("F1")</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-lg-9 col-md-8" data-aos="fade-left">
                    <div class="movie-info">
                        <h1 class="movie-title">@Model.Movie.Title</h1>

                        <div class="movie-meta">
                            @if (Model.Movie.ReleaseYear.HasValue)
                            {
                                <span class="meta-item">
                                    <i class="far fa-calendar-alt"></i> @Model.Movie.ReleaseYear
                                </span>
                            }
                            <span class="meta-item">
                                <i class="fas fa-tag"></i> @Model.Movie.Genre
                            </span>
                            @if (Model.Movie.Duration.HasValue)
                            {
                                <span class="meta-item">
                                    <i class="far fa-clock"></i> @Model.Movie.Duration min
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(Model.Movie.Language))
                            {
                                <span class="meta-item">
                                    <i class="fas fa-language"></i> @Model.Movie.Language
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Movie.Description))
                        {
                            <p class="movie-description">@Model.Movie.Description</p>
                        }

                        <div class="movie-details-grid">
                            @if (!string.IsNullOrEmpty(Model.Movie.Director))
                            {
                                <div class="detail-item">
                                    <span class="detail-label">Director</span>
                                    <span class="detail-value">@Model.Movie.Director</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Movie.Cast))
                            {
                                <div class="detail-item">
                                    <span class="detail-label">Cast</span>
                                    <span class="detail-value">@Model.Movie.Cast</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Movie.Country))
                            {
                                <div class="detail-item">
                                    <span class="detail-label">Country</span>
                                    <span class="detail-value">@Model.Movie.Country</span>
                                </div>
                            }
                        </div>

                        <div class="movie-actions">
                            @if (!string.IsNullOrEmpty(Model.Movie.VideoUrl))
                            {
                                <a href="@Model.Movie.VideoUrl" target="_blank" class="btn-watch">
                                    <i class="fas fa-play me-2"></i>Watch Now
                                </a>
                            }
                            <button class="btn-wishlist" onclick="addToWishlist(@Model.Movie.Id)">
                                <i class="far fa-heart"></i>
                                <span>Add to Wishlist</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Related Movies Section -->
    @if (Model.RelatedMovies.Any())
    {
        <section class="related-section py-5">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-film me-3"></i>You May Also Like
                    </h2>
                </div>

                <div class="row g-4">
                    @foreach (var movie in Model.RelatedMovies)
                    {
                        <div class="col-lg-2 col-md-3 col-sm-4 col-6">
                            <div class="movie-card">
                                <div class="movie-poster">
                                    <img src="@(movie.ThumbnailUrl ?? "/images/default-movie.jpg")"
                                         alt="@movie.Title">
                                    <div class="movie-overlay">
                                        <a href="@Url.Action("MovieDetails", new { id = movie.Id })"
                                           class="btn-details">
                                            <i class="fas fa-info-circle"></i>
                                        </a>
                                    </div>
                                </div>
                                <div class="movie-info">
                                    <h6>@movie.Title</h6>
                                    <small>@movie.ReleaseYear</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- Reviews Section -->
    @if (Model.Reviews.Any())
    {
        <section class="reviews-section py-5 bg-dark-gradient">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-star me-3"></i>User Reviews
                    </h2>
                </div>

                <div class="reviews-grid">
                    @foreach (var review in Model.Reviews.Take(3))
                    {
                        <div class="review-card">
                            <div class="review-header">
                                <div class="reviewer-info">
                                    <i class="fas fa-user-circle"></i>
                                    <span>@(review.User?.Name ?? "Anonymous")</span>
                                </div>
                                <div class="review-rating">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating / 2)
                                        {
                                            <i class="fas fa-star text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-star text-warning"></i>
                                        }
                                    }
                                </div>
                            </div>
                            <p class="review-text">@review.ReviewText</p>
                            <small class="review-date">@review.ReviewDate.ToString("dd MMM yyyy")</small>
                        </div>
                    }
                </div>

                @if (Model.Reviews.Count > 3)
                {
                    <div class="text-center mt-4">
                        <button class="btn-view-all" onclick="loadAllReviews()">
                            View All @Model.Reviews.Count Reviews
                        </button>
                    </div>
                }
            </div>
        </section>
    }
</div>

<!-- Custom CSS -->
<style>
    .movie-hero {
        min-height: 80vh;
        padding: 100px 0 50px;
        position: relative;
    }

    .min-vh-60 {
        min-height: 60vh;
    }

    .movie-poster-wrapper {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    }

    .movie-poster {
        width: 100%;
        height: auto;
        transition: transform 0.3s ease;
    }

    .movie-poster-wrapper:hover .movie-poster {
        transform: scale(1.05);
    }

    .rating-badge {
        position: absolute;
        bottom: 20px;
        right: 20px;
        background: rgba(0,0,0,0.8);
        backdrop-filter: blur(5px);
        padding: 10px 20px;
        border-radius: 30px;
        color: #ffd700;
        font-weight: 600;
        border: 1px solid rgba(255,215,0,0.3);
    }

        .rating-badge i {
            margin-right: 8px;
        }

    .movie-info {
        padding: 20px;
    }

    .movie-title {
        font-size: 3.5rem;
        font-weight: 800;
        margin-bottom: 20px;
        background: linear-gradient(135deg, #fff, #ff4d4d);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .movie-meta {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 30px;
    }

    .meta-item {
        background: rgba(255,255,255,0.05);
        padding: 8px 20px;
        border-radius: 30px;
        font-size: 0.95rem;
        color: #e5e7eb;
    }

        .meta-item i {
            margin-right: 8px;
            color: #ff4d4d;
        }

    .movie-description {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #d1d5db;
        margin-bottom: 30px;
    }

    .movie-details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .detail-item {
        background: rgba(255,255,255,0.05);
        padding: 15px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .detail-label {
        display: block;
        font-size: 0.85rem;
        color: #9ca3af;
        margin-bottom: 5px;
    }

    .detail-value {
        font-size: 1rem;
        color: white;
        font-weight: 500;
    }

    .movie-actions {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .btn-watch {
        background: linear-gradient(135deg, #ff4d4d, #ff3333);
        color: white;
        border: none;
        padding: 15px 40px;
        border-radius: 50px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
    }

        .btn-watch:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(255,77,77,0.4);
            color: white;
        }

    .btn-wishlist {
        background: transparent;
        color: white;
        border: 2px solid rgba(255,255,255,0.2);
        padding: 15px 40px;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
    }

        .btn-wishlist:hover {
            border-color: #ff4d4d;
            background: rgba(255,77,77,0.1);
            transform: translateY(-3px);
        }

    /* Related Movies Section */
    .bg-dark-gradient {
        background: linear-gradient(135deg, #0a0c0f 0%, #1a1a1a 100%);
    }

    .section-header {
        margin-bottom: 40px;
        text-align: center;
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: white;
        display: inline-flex;
        align-items: center;
        position: relative;
        padding-bottom: 15px;
    }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 3px;
            background: linear-gradient(90deg, transparent, #ff4d4d, transparent);
        }

    .movie-card {
        background: #1a1a1a;
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
        height: 100%;
    }

        .movie-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(255,77,77,0.2);
        }

    .movie-poster {
        position: relative;
        aspect-ratio: 2/3;
        overflow: hidden;
    }

        .movie-poster img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .movie-card:hover .movie-poster img {
        transform: scale(1.1);
    }

    .movie-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .movie-card:hover .movie-overlay {
        opacity: 1;
    }

    .btn-details {
        background: #ff4d4d;
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.3s ease;
        transform: scale(0);
    }

    .movie-card:hover .btn-details {
        transform: scale(1);
    }

    .btn-details:hover {
        background: #ff3333;
        transform: scale(1.1) !important;
    }

    .movie-info {
        padding: 12px;
    }

        .movie-info h6 {
            color: white;
            font-size: 0.9rem;
            margin: 0 0 5px 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .movie-info small {
            color: #9ca3af;
            font-size: 0.8rem;
        }

    /* Reviews Section */
    .reviews-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
    }

    .review-card {
        background: #1a1a1a;
        border-radius: 16px;
        padding: 25px;
        border: 1px solid rgba(255,255,255,0.05);
        transition: all 0.3s ease;
    }

        .review-card:hover {
            transform: translateY(-5px);
            border-color: rgba(255,77,77,0.3);
            box-shadow: 0 15px 30px rgba(255,77,77,0.1);
        }

    .review-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .reviewer-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .reviewer-info i {
            font-size: 2rem;
            color: #ff4d4d;
        }

        .reviewer-info span {
            color: white;
            font-weight: 600;
        }

    .review-rating {
        display: flex;
        gap: 2px;
    }

    .review-text {
        color: #d1d5db;
        line-height: 1.6;
        margin-bottom: 15px;
    }

    .review-date {
        color: #6c757d;
        font-size: 0.85rem;
    }

    .btn-view-all {
        background: transparent;
        color: #ff4d4d;
        border: 2px solid #ff4d4d;
        padding: 12px 30px;
        border-radius: 30px;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .btn-view-all:hover {
            background: #ff4d4d;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(255,77,77,0.3);
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .movie-title {
            font-size: 2.5rem;
        }

        .movie-details-grid {
            grid-template-columns: 1fr;
        }

        .movie-actions {
            flex-direction: column;
        }

        .btn-watch, .btn-wishlist {
            width: 100%;
            justify-content: center;
        }
    }
</style>

@section Scripts {
    <script>
        function addToWishlist(movieId) {
            @if (User.Identity?.IsAuthenticated == true)
            {
                    <text>
                    $.post('@Url.Action("AddToWishlist", "Wishlist", new { area = "User" })', { movieId: movieId })
                        .done(function(response) {
                            if (response.success) {
                                toastr.success('Added to wishlist!');
                            } else {
                                toastr.info('Already in wishlist');
                            }
                        })
                        .fail(function() {
                            toastr.error('Error adding to wishlist');
                        });
                    </text>
            }
            else
            {
                    <text>
                    toastr.warning('Please login to add to wishlist');
                    setTimeout(function() {
                        window.location.href = '@Url.Action("Login", "Auth")';
                    }, 2000);
                    </text>
            }
        }

        function loadAllReviews() {
            // Implement load more reviews functionality
            toastr.info('Loading all reviews...');
        }
    </script>
}