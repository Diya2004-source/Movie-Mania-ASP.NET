        border: 1px solid rgba(255,255,255,0.1);
    }

    .detail-label {
        display: block;
        font-size: 0.85rem;
        color: #9ca3af;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .detail-value {
        font-size: 1rem;
        color: white;
        font-weight: 500;
    }

    .movie-actions {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .btn-watch {
        background: linear-gradient(135deg, #ff4d4d, #ff3333);
        color: white;
        border: none;
        padding: 15px 40px;
        border-radius: 50px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        box-shadow: 0 10px 20px rgba(255,77,77,0.3);
    }

        .btn-watch:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(255,77,77,0.4);
            color: white;
        }

    .btn-wishlist {
        background: transparent;
        color: white;
        border: 2px solid rgba(255,255,255,0.2);
        padding: 15px 40px;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
    }

        .btn-wishlist:hover {
            border-color: #ff4d4d;
            background: rgba(255,77,77,0.1);
            transform: translateY(-3px);
        }

    /* Similar and Related Movies Section */
    .bg-dark-gradient {
        background: linear-gradient(135deg, #0a0c0f 0%, #1a1a1a 100%);
        position: relative;
        overflow: hidden;
    }

    .section-header {
        margin-bottom: 40px;
        text-align: center;
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: white;
        display: inline-flex;
        align-items: center;
        position: relative;
        padding-bottom: 15px;
    }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 3px;
            background: linear-gradient(90deg, transparent, #ff4d4d, transparent);
        }

    .average-rating {
        margin-top: 10px;
        font-size: 1.2rem;
        color: white;
    }

    .rating-value {
        font-size: 2rem;
        font-weight: 700;
        color: #ffd700;
    }

    .rating-star {
        font-size: 1.5rem;
        margin: 0 5px;
    }

    .rating-count {
        color: #9ca3af;
    }

    .movie-card {
        background: #1a1a1a;
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
