        .rating-badge i {
            margin-right: 8px;
        }

    .movie-info {
        padding: 20px;
    }

    .movie-title {
        font-size: 3.5rem;
        font-weight: 800;
        margin-bottom: 20px;
        background: linear-gradient(135deg, #fff, #ff4d4d);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .movie-meta {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 30px;
    }

    .meta-item {
        background: rgba(255,255,255,0.05);
        padding: 8px 20px;
        border-radius: 30px;
        font-size: 0.95rem;
        color: #e5e7eb;
    }

        .meta-item i {
            margin-right: 8px;
            color: #ff4d4d;
        }

    .movie-description {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #d1d5db;
        margin-bottom: 30px;
        max-width: 800px;
    }

    .movie-details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .detail-item {
