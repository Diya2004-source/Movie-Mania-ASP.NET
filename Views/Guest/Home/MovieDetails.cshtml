        border: 1px solid rgba(255,255,255,0.05);
        transition: all 0.3s ease;
    }

        .review-card:hover {
            transform: translateY(-5px);
            border-color: rgba(255,77,77,0.3);
            box-shadow: 0 15px 30px rgba(255,77,77,0.1);
        }

    .review-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .reviewer-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .reviewer-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #ff4d4d;
    }

    .reviewer-avatar-placeholder {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ff4d4d, #ff3333);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 1.2rem;
    }

    .reviewer-name {
        color: white;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .review-rating {
        display: flex;
        gap: 3px;
    }

        .review-rating i {
            font-size: 1rem;
        }

    .review-text {
        color: #d1d5db;
        line-height: 1.7;
        margin-bottom: 15px;
        font-size: 0.95rem;
    }

    .review-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 10px;
        border-top: 1px solid rgba(255,255,255,0.05);
    }

    .review-date {
        color: #6c757d;
        font-size: 0.85rem;
    }

        .review-date i {
            margin-right: 4px;
        }

    .btn-helpful {
        background: transparent;
        color: #9ca3af;
        border: 1px solid rgba(255,255,255,0.1);
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .btn-helpful:hover {
            background: rgba(255,77,77,0.1);
            border-color: #ff4d4d;
            color: white;
        }

    .btn-view-all {
        background: transparent;
        color: #ff4d4d;
        border: 2px solid #ff4d4d;
        padding: 12px 35px;
        border-radius: 30px;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
        font-size: 1rem;
    }

        .btn-view-all:hover {
            background: #ff4d4d;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(255,77,77,0.3);
        }

    /* Add Review Form */
    .add-review-section {
        background: #1a1a1a;
        border-radius: 20px;
        padding: 30px;
        border: 1px solid rgba(255,255,255,0.05);
        margin-top: 50px;
    }

    .star-rating {
        display: flex;
        gap: 5px;
        font-size: 2rem;
        color: #ffd700;
        cursor: pointer;
    }

    .star {
        cursor: pointer;
        transition: transform 0.2s ease;
    }

        .star:hover {
            transform: scale(1.2);
        }

        .star.selected {
            color: #ffd700;
        }

    .btn-submit-review {
        background: linear-gradient(135deg, #ff4d4d, #ff3333);
        color: white;
        border: none;
        padding: 12px 40px;
        border-radius: 30px;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .btn-submit-review:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(255,77,77,0.3);
        }

    /* Responsive */
    @@media (max-width: 992px) {
        .movie-title {
            font-size: 2.8rem;
        }
    }

    @@media (max-width: 768px) {
        .movie-title {
            font-size: 2.2rem;
            text-align: center;
        }

        .movie-meta {
            justify-content: center;
        }

        .movie-description {
            text-align: center;
            margin-left: auto;
            margin-right: auto;
        }

        .movie-details-grid {
            grid-template-columns: 1fr;
        }

        .movie-actions {
            flex-direction: column;
        }

        .btn-watch, .btn-wishlist {
            width: 100%;
            justify-content: center;
        }

        .section-title {
            font-size: 2rem;
        }

        .reviews-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .movie-title {
            font-size: 1.8rem;
        }

        .meta-item {
            font-size: 0.85rem;
            padding: 6px 15px;
        }

        .review-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
    }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <script>
        // Initialize toastr options
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };

        function addToWishlist(movieId) {
            @if (User.Identity?.IsAuthenticated == true)
            {
                    <text>
                    fetch('@Url.Action("AddToWishlist", "Wishlist", new { area = "User" })', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify({ movieId: movieId })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            toastr.success('Added to wishlist!');
                        } else {
                            toastr.info(data.message || 'Already in wishlist');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        toastr.error('Error adding to wishlist');
                    });
                    </text>
            }
            else
            {
                    <text>
                    toastr.warning('Please login to add to wishlist');
                    setTimeout(function() {
                        window.location.href = '@Url.Action("Login", "Auth")';
                    }, 2000);
                    </text>
            }
        }

        function loadAllReviews(movieId) {
            window.location.href = '@Url.Action("Reviews", "Movies")' + '?movieId=' + movieId;
        }

        function markHelpful(reviewId) {
            @if (User.Identity?.IsAuthenticated == true)
            {
                    <text>
                    fetch('@Url.Action("MarkHelpful", "Movies")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify({ reviewId: reviewId })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            toastr.success('Thank you for your feedback!');
                            location.reload();
                        } else {
                            toastr.error(data.message || 'Error marking as helpful');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        toastr.error('Error marking as helpful');
                    });
                    </text>
            }
            else
            {
                    <text>
                    toastr.warning('Please login to mark reviews as helpful');
                    setTimeout(function() {
                        window.location.href = '@Url.Action("Login", "Auth")';
                    }, 2000);
                    </text>
            }
        }

        function submitReview() {
            var movieId = document.getElementById('movieId').value;
            var rating = document.getElementById('rating').value;
            var reviewText = document.getElementById('reviewText').value;

            if (rating == 0) {
                toastr.warning('Please select a rating');
                return;
            }

            if (!reviewText.trim()) {
                toastr.warning('Please write a review');
                return;
            }

            fetch('@Url.Action("AddReview", "Movies")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({
                    movieId: movieId,
                    rating: rating,
                    reviewText: reviewText
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    toastr.success('Review submitted successfully!');
                    setTimeout(() => location.reload(), 2000);
                } else {
                    toastr.error(data.message || 'Error submitting review');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                toastr.error('Error submitting review');
            });
        }

        // Star rating functionality
        document.querySelectorAll('.star').forEach(star => {
            star.addEventListener('click', function() {
                var rating = this.getAttribute('data-rating');
                document.getElementById('rating').value = rating;

                // Update star display
                document.querySelectorAll('.star').forEach(s => {
                    if (s.getAttribute('data-rating') <= rating) {
                        s.innerHTML = '★';
                        s.classList.add('selected');
                    } else {
                        s.innerHTML = '☆';
                        s.classList.remove('selected');
                    }
                });
            });

            star.addEventListener('mouseover', function() {
                var rating = this.getAttribute('data-rating');
                document.querySelectorAll('.star').forEach(s => {
                    if (s.getAttribute('data-rating') <= rating) {
                        s.style.transform = 'scale(1.2)';
                    }
                });
            });

            star.addEventListener('mouseout', function() {
                document.querySelectorAll('.star').forEach(s => {
                    s.style.transform = 'scale(1)';
                });
            });
        });
    </script>
}