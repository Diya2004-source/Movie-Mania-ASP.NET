        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .explore-btn:hover {
            border-color: #ff4d4d;
            background: rgba(255, 77, 77, 0.1);
            color: white;
            transform: translateY(-3px);
        }

    /* Section Styles */
    .section-header {
        border-bottom: 2px solid rgba(255, 77, 77, 0.3);
        padding-bottom: 15px;
    }

    .section-subtitle {
        color: #ff4d4d;
