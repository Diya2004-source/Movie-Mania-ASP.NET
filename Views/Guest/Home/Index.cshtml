<!-- Add AOS Library for scroll animations -->
@section Scripts {
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        // Initialize AOS
        AOS.init({
            duration: 800,
            once: true,
            offset: 100
        });

        // Add to wishlist function
        function addToWishlist(movieId) {
            // Check if user is logged in
            @if (User.Identity?.IsAuthenticated == true)
            {
                    <text>
                    $.post('@Url.Action("AddToWishlist", "Wishlist")', { movieId: movieId })
                        .done(function(response) {
                            if (response.success) {
                                toastr.success('Added to wishlist!');
                            } else {
                                toastr.info('Already in wishlist');
                            }
                        })
                        .fail(function() {
                            toastr.error('Error adding to wishlist');
                        });
                    </text>
            }
            else
            {
                    <text>
                    toastr.warning('Please login to add to wishlist');
                    setTimeout(function() {
                        window.location.href = '@Url.Action("Login", "Auth")';
                    }, 2000);
                    </text>
            }
        }

        // Smooth scroll for explore button
        document.querySelector('.explore-btn')?.addEventListener('click', function(e) {
            e.preventDefault();
            document.querySelector('#latest-movies').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        });

        // Parallax effect for hero section
        window.addEventListener('scroll', function() {
            const heroSection = document.querySelector('.hero-section');
            const scrolled = window.pageYOffset;
            if (heroSection) {
                heroSection.style.transform = 'translateY(' + (scrolled * 0.3) + 'px)';
            }
        });
    </script>
}