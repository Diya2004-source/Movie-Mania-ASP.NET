@model MovieMania.ViewModels.GuestHomeViewModel

@{
    Layout = "~/Views/Shared/_GuestLayout.cshtml";
    ViewData["Title"] = "Movie Mania - Home";
}

<!-- Hero Section - Dynamic Featured Movie with Enhanced Styling -->
@if (Model.FeaturedMovies.Any())
{
    var featured = Model.FeaturedMovies.First();
    <section class="hero-section position-relative overflow-hidden">
        <!-- Animated Gradient Overlay -->
        <div class="hero-backdrop" style="background-image: url('@(featured.ThumbnailUrl ?? "/images/default-backdrop.jpg")');">
            <div class="hero-overlay"></div>
            <div class="hero-gradient"></div>
            <div class="container hero-content">
                <div class="row min-vh-80 align-items-center">
                    <div class="col-lg-7" data-aos="fade-right">
                        <div class="badge-group mb-4">
                            <span class="premium-badge animate-pulse">
                                <i class="fas fa-crown me-2"></i>FEATURED
                            </span>
                            @if (featured.Rating.HasValue)
                            {
                                <span class="rating-badge">
                                    <i class="fas fa-star text-warning"></i>
                                    <span class="rating-value">@featured.Rating.Value.ToString("F1")</span>
                                    <span class="rating-label">/10</span>
                                </span>
                            }
                        </div>

                        <h1 class="hero-title animate-title">@featured.Title</h1>

                        <div class="movie-meta mb-4">
                            @if (featured.ReleaseYear.HasValue)
                            {
                                <span class="meta-item">
                                    <i class="far fa-calendar-alt me-2"></i>@featured.ReleaseYear
                                </span>
                            }
                            <span class="meta-item">
                                <i class="fas fa-tag me-2"></i>@featured.Genre
                            </span>
                            @if (featured.Duration.HasValue)
                            {
                                <span class="meta-item">
                                    <i class="far fa-clock me-2"></i>@featured.Duration min
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(featured.Language))
                            {
                                <span class="meta-item">
                                    <i class="fas fa-language me-2"></i>@featured.Language
                                </span>
                            }
                    </div>

                    <p class="hero-description mb-4">
                        @(featured.Description?.Length > 250
                                                ? featured.Description.Substring(0, 250) + "..."
                                                : featured.Description)
                    </p>

                        <div class="hero-actions d-flex flex-wrap gap-3">
                            <a href="@Url.Action("MovieDetails", new { id = featured.Id })"
                               class="btn btn-watch btn-lg d-flex align-items-center">
                                <span class="btn-icon me-2">
                                    <i class="fas fa-play"></i>
                                </span>
                                <span class="btn-text">Watch Now</span>
                            </a>
                            <a href="#latest-movies" class="btn btn-outline-light btn-lg explore-btn">
                                <span class="btn-text">Explore More</span>
                                <span class="btn-icon ms-2">
                                    <i class="fas fa-arrow-down"></i>
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Floating Elements -->
        <div class="floating-elements">
            <div class="floating-element element-1">
                <i class="fas fa-film"></i>
            </div>
            <div class="floating-element element-2">
                <i class="fas fa-video"></i>
            </div>
            <div class="floating-element element-3">
                <i class="fas fa-ticket-alt"></i>
            </div>
        </div>
    </section>
}

<!-- Latest Movies Section with Enhanced Cards -->
<section id="latest-movies" class="movies-section py-5">
    <div class="container">
        <div class="section-header d-flex justify-content-between align-items-center mb-5">
            <div class="header-left">
                <span class="section-subtitle">Fresh Content</span>
                <h2 class="section-title">
                    <i class="fas fa-fire text-danger me-3"></i>Latest Movies
                </h2>
            </div>
            <a href="@Url.Action("Movies")" class="view-all-link">
                <span class="link-text">View All</span>
                <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var movie in Model.LatestMovies.Take(6))
            {
                <div class="col-lg-2 col-md-3 col-sm-4 col-6" data-aos="fade-up" data-aos-delay="@(movie.Id * 50)">
                    <div class="movie-card">
                        <div class="movie-poster">
                            <img src="@(movie.ThumbnailUrl ?? "/images/default-movie.jpg")"
                                 alt="@movie.Title"
                                 loading="lazy">
                            @if (movie.Rating.HasValue)
                            {
                                <div class="movie-rating-badge">
                                    <i class="fas fa-star text-warning"></i>
                                    <span>@movie.Rating.Value.ToString("F1")</span>
                                </div>
                            }
                            <div class="movie-overlay">
                                <div class="overlay-content">
                                    <a href="@Url.Action("MovieDetails", new { id = movie.Id })"
                                       class="btn btn-details">
                                        <i class="fas fa-info-circle me-2"></i>Details
                                    </a>
                                    <button class="btn btn-wishlist" onclick="addToWishlist(@movie.Id)">
                                        <i class="far fa-heart"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="movie-info">
                            <h6 class="movie-title">@movie.Title</h6>
                            <div class="movie-meta-sm">
                                <span class="genre">@movie.Genre</span>
                                <span class="year">• @movie.ReleaseYear</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Popular Movies Section with Enhanced Styling -->
@if (Model.PopularMovies.Any())
{
    <section class="popular-section py-5 bg-dark-gradient">
        <div class="container">
            <div class="section-header d-flex justify-content-between align-items-center mb-5">
                <div class="header-left">
                    <span class="section-subtitle">Top Rated</span>
                    <h2 class="section-title">
                        <i class="fas fa-star text-warning me-3"></i>Popular Movies
                    </h2>
                </div>
                <a href="@Url.Action("Movies", new { sortBy = "rating" })" class="view-all-link">
                    <span class="link-text">View All</span>
                    <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>

            <div class="popular-slider">
                <div class="row g-4">
                    @foreach (var movie in Model.PopularMovies)
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6" data-aos="zoom-in">
                            <div class="popular-card">
                                <div class="card-badge">
                                    <span class="badge-rank">#@movie.Id</span>
                                </div>
                                <div class="popular-poster">
                                    <img src="@(movie.ThumbnailUrl ?? "/images/default-movie.jpg")"
                                         alt="@movie.Title"
                                         loading="lazy">
                                    <div class="popular-overlay">
                                        <div class="overlay-stats">
                                            <div class="stat-item">
                                                <i class="fas fa-star text-warning"></i>
                                                <span>@movie.Rating?.ToString("F1")</span>
                                            </div>
                                            <div class="stat-item">
                                                <i class="fas fa-eye"></i>
                                                <span>@movie.ViewsCount</span>
                                            </div>
                                        </div>
                                        <a href="@Url.Action("MovieDetails", new { id = movie.Id })"
                                           class="btn btn-watch-sm">
                                            <i class="fas fa-play me-2"></i>Watch
                                        </a>
                                    </div>
                                </div>
                                <div class="popular-info">
                                    <h6>@movie.Title</h6>
                                    <p>@movie.Genre • @movie.ReleaseYear</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}

<!-- Trending Shows Section with Modern Design -->
@if (Model.TrendingShows.Any())
{
    <section class="shows-section py-5">
        <div class="container">
            <div class="section-header d-flex justify-content-between align-items-center mb-5">
                <div class="header-left">
                    <span class="section-subtitle">Must Watch</span>
                    <h2 class="section-title">
                        <i class="fas fa-tv text-info me-3"></i>Trending TV Shows
                    </h2>
                </div>
                <a href="@Url.Action("Shows")" class="view-all-link">
                    <span class="link-text">View All</span>
                    <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>

            <div class="row g-4">
                @foreach (var show in Model.TrendingShows)
                {
                    <div class="col-lg-2 col-md-3 col-sm-4 col-6" data-aos="flip-up">
                        <div class="show-card">
                            <div class="show-poster">
                                <img src="@(show.ThumbnailUrl ?? "/images/default-show.jpg")"
                                     alt="@show.Title"
                                     loading="lazy">
                                <div class="show-badge">
                                    <span class="season-badge">
                                        <i class="fas fa-layer-group me-1"></i>
                                        @show.TotalSeasons S
                                    </span>
                                </div>
                                <div class="show-overlay">
                                    <a href="@Url.Action("ShowDetails", new { id = show.Id })"
                                       class="btn btn-show-details">
                                        <i class="fas fa-info-circle me-2"></i>Details
                                    </a>
                                </div>
                            </div>
                            <div class="show-info">
                                <h6 class="show-title">@show.Title</h6>
                                <div class="show-meta">
                                    <span>@show.Genre</span>
                                    <span class="dot">•</span>
                                    <span>@show.ReleaseYear</span>
                                </div>
                                @if (show.Rating.HasValue)
                                {
                                    <div class="show-rating">
                                        <i class="fas fa-star text-warning"></i>
                                        <span>@show.Rating.Value.ToString("F1")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Call to Action Section -->
<section class="cta-section py-5">
    <div class="container">
        <div class="cta-wrapper text-center">
            <h2 class="cta-title">Ready to Start Watching?</h2>
            <p class="cta-text">Join thousands of movie lovers and start streaming today</p>
            <div class="cta-buttons">
                <a href="@Url.Action("Register", "Auth")" class="btn btn-cta-primary">
                    <i class="fas fa-user-plus me-2"></i>Get Started
                </a>
                <a href="@Url.Action("Movies")" class="btn btn-cta-secondary">
                    <i class="fas fa-film me-2"></i>Browse Movies
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Enhanced CSS -->
<style>
    /* Hero Section Enhancements */
    .hero-section {
        min-height: 90vh;
        margin-top: -76px;
        position: relative;
    }

    .hero-backdrop {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(90deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.6) 50%, transparent 100%);
    }

    .hero-gradient {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 150px;
        background: linear-gradient(to top, #0a0c0f, transparent);
    }

    .hero-content {
        position: relative;
        z-index: 3;
        padding-top: 120px;
    }

    .min-vh-80 {
        min-height: 80vh;
    }

    /* Floating Elements */
    .floating-elements {
        position: absolute;
        bottom: 50px;
        right: 50px;
        z-index: 2;
    }

    .floating-element {
        position: absolute;
        font-size: 1.5rem;
        color: rgba(255, 77, 77, 0.2);
        animation: float 6s ease-in-out infinite;
    }

        .floating-element.element-1 {
            bottom: 0;
            right: 0;
            font-size: 4rem;
            animation-delay: 0s;
        }

        .floating-element.element-2 {
            bottom: 60px;
            right: 80px;
            font-size: 3rem;
            animation-delay: 1s;
        }

        .floating-element.element-3 {
            bottom: 120px;
            right: 40px;
            font-size: 2.5rem;
            animation-delay: 2s;
        }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-20px);
        }
    }

    /* Badge Styles */
    .badge-group {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .premium-badge {
        background: linear-gradient(135deg, #ffd700, #ffa500);
        color: #000;
        padding: 8px 20px;
        border-radius: 30px;
        font-weight: bold;
        display: inline-flex;
        align-items: center;
        box-shadow: 0 5px 20px rgba(255, 215, 0, 0.3);
    }

    .rating-badge {
        background: rgba(0,0,0,0.6);
        backdrop-filter: blur(10px);
        padding: 8px 20px;
        border-radius: 30px;
        display: inline-flex;
        align-items: center;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .rating-value {
        font-size: 1.2rem;
        font-weight: bold;
        color: #ffd700;
        margin: 0 2px 0 8px;
    }

    .rating-label {
        font-size: 0.8rem;
        color: #9ca3af;
    }

    /* Title Animation */
    .hero-title {
        font-size: 4.5rem;
        font-weight: 800;
        margin: 1rem 0;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        animation: slideInRight 1s ease;
    }

    @@keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(-50px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .animate-title {
        background: linear-gradient(135deg, #fff 0%, #ffd700 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .animate-pulse {
        animation: pulse 2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.8;
            transform: scale(1.05);
        }
    }

    /* Movie Meta */
    .movie-meta {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .meta-item {
        color: #e5e7eb;
        font-size: 1rem;
        display: flex;
        align-items: center;
    }

    .hero-description {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #d1d5db;
        max-width: 600px;
    }

    /* Button Styles */
    .btn-watch {
        background: linear-gradient(135deg, #ff4d4d, #ff1a1a);
        color: white;
        border: none;
        padding: 16px 32px;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(255, 77, 77, 0.4);
    }

        .btn-watch:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(255, 77, 77, 0.6);
            color: white;
        }

    .explore-btn {
        border: 2px solid rgba(255,255,255,0.2);
