            color: #ff4d4d;
            background: rgba(255, 77, 77, 0.1);
            transform: translateX(5px);
        }

    .link-text {
        font-weight: 500;
    }

    /* Movie Card Styles */
    .movie-card {
        background: linear-gradient(145deg, #1a1a1a, #151515);
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.4s ease;
        height: 100%;
