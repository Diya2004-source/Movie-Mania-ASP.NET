@model IEnumerable<MovieMania.Models.Movie>

@{
    Layout = "~/Views/Shared/_GuestLayout.cshtml";
    ViewData["Title"] = "Browse Movies";
}

<div class="movies-page">
    <!-- Hero Banner -->
    <section class="page-hero mb-5">
        <div class="container">
            <div class="hero-content text-center">
                <h1 class="hero-title">Browse Movies</h1>
                <p class="hero-subtitle">Discover thousands of movies from all genres</p>
            </div>
        </div>
    </section>

    <!-- Filters Section -->
    <section class="filters-section mb-5">
        <div class="container">
            <div class="filters-wrapper">
                <form method="get" class="row g-3 align-items-end">
                    <!-- Search Bar -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label text-muted mb-2">Search Movies</label>
                        <div class="search-box">
                            <i class="fas fa-search search-icon"></i>
                            <input type="text" class="form-control" name="search" 
                                   value="@ViewBag.Search" placeholder="Search by title, cast, director...">
                        </div>
                    </div>

                    <!-- Genre Filter -->
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label text-muted mb-2">Genre</label>
                        <div class="filter-select">
                            <i class="fas fa-tag select-icon"></i>
                            <select class="form-select" name="genre">
                                <option value="All">All Genres</option>
                                @if (ViewBag.Genres != null)
                                {
                                    @foreach (var genre in ViewBag.Genres)
                                    {
                                        <option value="@genre" selected="@(genre == ViewBag.Genre)">
                                            @genre
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Sort By -->
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label text-muted mb-2">Sort By</label>
                        <div class="filter-select">
                            <i class="fas fa-sort select-icon"></i>
                            <select class="form-select" name="sortBy">
                                <option value="latest" selected="@(ViewBag.SortBy == "latest")">Latest First</option>
                                <option value="rating" selected="@(ViewBag.SortBy == "rating")">Top Rated</option>
                                <option value="year" selected="@(ViewBag.SortBy == "year")">Release Year</option>
                                <option value="title" selected="@(ViewBag.SortBy == "title")">Title A-Z</option>
                            </select>
                        </div>
                    </div>

                    <!-- Apply Button -->
                    <div class="col-lg-2 col-md-6">
                        <button type="submit" class="btn-apply w-100">
                            <i class="fas fa-filter me-2"></i>Apply Filters
                        </button>
                    </div>
                </form>

                <!-- Active Filters -->
                @if (!string.IsNullOrEmpty(ViewBag.Search) || (!string.IsNullOrEmpty(ViewBag.Genre) && ViewBag.Genre != "All"))
                {
                    <div class="active-filters mt-4">
                        <span class="filters-label">Active Filters:</span>
                        @if (!string.IsNullOrEmpty(ViewBag.Search))
                        {
                            <span class="filter-tag">
                                Search: "@ViewBag.Search"
                                <a href="@Url.Action("Movies", new { genre = ViewBag.Genre, sortBy = ViewBag.SortBy })" class="remove-filter">
                                    <i class="fas fa-times"></i>
                                </a>
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(ViewBag.Genre) && ViewBag.Genre != "All")
                        {
                            <span class="filter-tag">
                                Genre: @ViewBag.Genre
                                <a href="@Url.Action("Movies", new { search = ViewBag.Search, sortBy = ViewBag.SortBy })" class="remove-filter">
                                    <i class="fas fa-times"></i>
                                </a>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Results Info -->
    <section class="results-section mb-4">
        <div class="container">
            <div class="results-info">
                <p class="mb-0">
                    <i class="fas fa-film me-2"></i>
                    Showing <strong>@Model.Count()</strong> of <strong>@ViewBag.TotalItems</strong> movies
                </p>
            </div>
        </div>
    </section>

    <!-- Movies Grid -->
    <section class="movies-grid-section mb-5">
        <div class="container">
            @if (!Model.Any())
            {
                <div class="no-results">
                    <i class="fas fa-film fa-4x mb-3"></i>
                    <h3>No Movies Found</h3>
                    <p>Try adjusting your search or filter criteria</p>
                    <a href="@Url.Action("Movies")" class="btn-clear">
                        <i class="fas fa-undo me-2"></i>Clear Filters
                    </a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var movie in Model)
                    {
                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="@(movie.Id * 20)">
                            <div class="movie-card">
                                <div class="movie-poster">
                                    <img src="@(movie.ThumbnailUrl ?? "/images/default-movie.jpg")" 
                                         alt="@movie.Title"
                                         loading="lazy">
                                    
                                    @if (movie.Rating.HasValue)
                                    {
                                        <div class="movie-rating">
                                            <i class="fas fa-star"></i>
                                            <span>@movie.Rating.Value.ToString("F1")</span>
                                        </div>
                                    }

                                    @if (movie.IsFeatured)
                                    {
                                        <div class="movie-featured">
                                            <i class="fas fa-crown"></i>
                                        </div>
                                    }

                                    <div class="movie-overlay">
                                        <div class="overlay-content">
                                            <a href="@Url.Action("MovieDetails", new { id = movie.Id })" 
                                               class="btn-details">
                                                <i class="fas fa-info-circle me-2"></i>Details
                                            </a>
                                            <button class="btn-wishlist" onclick="addToWishlist(@movie.Id)">
                                                <i class="far fa-heart"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="movie-info">
                                    <h6 class="movie-title">@movie.Title</h6>
                                    <div class="movie-meta">
                                        <span class="genre">@movie.Genre</span>
                                        <span class="year">@movie.ReleaseYear</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(movie.Director))
                                    {
                                        <div class="movie-director">
                                            <i class="fas fa-user-tie"></i> @movie.Director
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <section class="pagination-section">
            <div class="container">
                <nav aria-label="Movies pagination">
                    <ul class="pagination">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Movies", new { 
                                    page = ViewBag.CurrentPage - 1, 
                                    search = ViewBag.Search, 
                                    genre = ViewBag.Genre,
                                    sortBy = ViewBag.SortBy
                                })">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Movies", new { 
                                    page = i, 
                                    search = ViewBag.Search, 
                                    genre = ViewBag.Genre,
                                    sortBy = ViewBag.SortBy
                                })">@i</a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Movies", new { 
                                    page = ViewBag.CurrentPage + 1, 
                                    search = ViewBag.Search, 
                                    genre = ViewBag.Genre,
                                    sortBy = ViewBag.SortBy
                                })">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </section>
    }
</div>

<!-- Custom CSS -->
<style>
    /* Page Hero */
    .page-hero {
        background: linear-gradient(135deg, #0a0c0f 0%, #1a1a1a 100%);
        padding: 80px 0;
        position: relative;
        overflow: hidden;
    }

    .page-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" opacity="0.1"><circle cx="50" cy="50" r="40" fill="none" stroke="%23ff4d4d" stroke-width="2"/></svg>') repeat;
        animation: rotate 60s linear infinite;
    }

    .hero-title {
        font-size: 3.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #fff, #ff4d4d);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 15px;
    }

    .hero-subtitle {
        font-size: 1.4rem;
        color: #9ca3af;
    }

    /* Filters Section */
    .filters-wrapper {
        background: #1a1a1a;
        border-radius: 10px;
        padding: 30px;
        border: 1px solid rgba(255,255,255,0.05);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .search-box, .filter-select {
        position: relative;
    }

    .search-icon, .select-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #ff4d4d;
        z-index: 2;
    }

    .form-control, .form-select {
        background: #2a2a2a;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        padding: 12px 15px 12px 45px;
        color: white;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

    .form-control:focus, .form-select:focus {
        background: #2a2a2a;
        border-color: #ff4d4d;
        box-shadow: 0 0 0 3px rgba(255,77,77,0.1);
        color: white;
        outline: none;
    }

    .btn-apply {
        background: linear-gradient(135deg, #ff4d4d, #ff3333);
        border: none;
        border-radius: 12px;
        padding: 12px 20px;
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .btn-apply:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(255,77,77,0.3);
    }

    /* Active Filters */
    .active-filters {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
    }

    .filters-label {
        color: #9ca3af;
        font-size: 0.9rem;
        margin-right: 10px;
    }

    .filter-tag {
        background: rgba(255,77,77,0.1);
        border: 1px solid rgba(255,77,77,0.3);
        border-radius: 30px;
        padding: 8px 15px;
        font-size: 0.9rem;
        color: white;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .remove-filter {
        color: #ff4d4d;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .remove-filter:hover {
        color: #ff3333;
        transform: scale(1.2);
    }

    /* Results Info */
    .results-info {
        background: #1a1a1a;
        border-radius: 12px;
        padding: 15px 20px;
        border: 1px solid rgba(255,255,255,0.05);
    }

    /* Movie Card */
    .movie-card {
        background: #1a1a1a;
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.4s ease;
        height: 100%;
        border: 1px solid rgba(255,255,255,0.05);
    }

    .movie-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(255,77,77,0.2);
        border-color: rgba(255,77,77,0.3);
    }

    .movie-poster {
        position: relative;
        aspect-ratio: 2/3;
        overflow: hidden;
    }

    .movie-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .movie-card:hover .movie-poster img {
        transform: scale(1.1);
    }

    .movie-rating {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(0,0,0,0.8);
        backdrop-filter: blur(5px);
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        color: #ffd700;
        border: 1px solid rgba(255,215,0,0.3);
        z-index: 2;
    }

    .movie-rating i {
        margin-right: 4px;
    }

    .movie-featured {
        position: absolute;
        top: 10px;
        left: 10px;
        background: linear-gradient(135deg, #ffd700, #ffa500);
        color: #000;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        z-index: 2;
    }

    .movie-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
        display: flex;
        align-items: flex-end;
        padding: 20px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .movie-card:hover .movie-overlay {
        opacity: 1;
    }

    .overlay-content {
        display: flex;
        gap: 10px;
        width: 100%;
        transform: translateY(20px);
        transition: transform 0.3s ease;
    }

    .movie-card:hover .overlay-content {
        transform: translateY(0);
    }

    .btn-details {
        background: #ff4d4d;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 25px;
        font-size: 0.85rem;
        font-weight: 600;
        flex: 1;
        transition: all 0.3s ease;
        text-decoration: none;
        text-align: center;
    }

    .btn-details:hover {
        background: #ff3333;
        transform: scale(1.05);
        color: white;
    }

    .btn-wishlist {
        background: rgba(255,255,255,0.2);
        color: white;
        border: 1px solid rgba(255,255,255,0.3);
        padding: 8px 12px;
        border-radius: 25px;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .btn-wishlist:hover {
        background: #ff4d4d;
        border-color: #ff4d4d;
        transform: scale(1.05);
    }

    .movie-info {
        padding: 15px;
    }

    .movie-title {
        color: white;
        font-size: 0.95rem;
        font-weight: 600;
        margin: 0 0 5px 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .movie-meta {
        display: flex;
        gap: 8px;
        font-size: 0.8rem;
        color: #9ca3af;
        margin-bottom: 5px;
    }

    .movie-meta .genre {
        color: #ff4d4d;
    }

    .movie-director {
        font-size: 0.75rem;
        color: #6c757d;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .movie-director i {
        color: #ff4d4d;
        margin-right: 4px;
    }

    /* No Results */
    .no-results {
        text-align: center;
        padding: 80px 0;
        background: #1a1a1a;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.05);
    }

    .no-results i {
        color: #ff4d4d;
        opacity: 0.5;
    }

    .no-results h3 {
        color: white;
        margin: 20px 0 10px;
    }

    .no-results p {
        color: #9ca3af;
        margin-bottom: 20px;
    }

    .btn-clear {
        background: linear-gradient(135deg, #ff4d4d, #ff3333);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 30px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .btn-clear:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(255,77,77,0.3);
        color: white;
    }

    /* Pagination */
    .pagination {
        gap: 5px;
        justify-content: center;
    }

    .page-item.active .page-link {
        background: linear-gradient(135deg, #ff4d4d, #ff3333);
        border-color: transparent;
    }

    .page-link {
        background: #1a1a1a;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px !important;
        color: white;
        padding: 10px 15px;
        transition: all 0.3s ease;
    }

    .page-link:hover {
        background: #2a2a2a;
        border-color: #ff4d4d;
        color: white;
        transform: translateY(-2px);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.5rem;
        }
        
        .filters-wrapper {
            padding: 20px;
        }
    }
</style>

@section Scripts {
    <script>
        function addToWishlist(movieId) {
            @if (User.Identity?.IsAuthenticated == true)
            {
                <text>
                $.post('@Url.Action("AddToWishlist", "Wishlist", new { area = "User" })', { movieId: movieId })
                    .done(function(response) {
                        if (response.success) {
                            toastr.success('Added to wishlist!');
                        } else {
                            toastr.info('Already in wishlist');
                        }
                    })
                    .fail(function() {
                        toastr.error('Error adding to wishlist');
                    });
                </text>
            }
            else
            {
                <text>
                toastr.warning('Please login to add to wishlist');
                setTimeout(function() {
                    window.location.href = '@Url.Action("Login", "Auth")';
                }, 2000);
                </text>
            }
        }
    </script>
}