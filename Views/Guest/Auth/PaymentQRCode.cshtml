@model dynamic
@{
    ViewData["Title"] = "Complete Payment";
    Layout = "~/Views/Shared/_GuestLayout.cshtml";
    var plans = ViewBag.Plans as List<MovieMania.Models.SubscriptionPlan>;
}

<div class="container py-5">
    <div class="text-center mb-5 text-white">
        <h2 class="display-5 fw-bold">Unlock MovieMania</h2>
        <p class="lead">
            Logged in as: <span class="text-warning">@ViewBag.Email</span>
        </p>
    </div>

    <div class="row justify-content-center">
        @foreach (var plan in plans)
        {
            <div class="col-md-4 mb-4">
                <div class="card bg-dark text-white border-warning shadow-lg p-4 text-center">

                    <h3 class="text-warning">@plan.Name</h3>
                    <h1 class="text-success">₹ @plan.Price</h1>

                    <button class="btn btn-warning w-100"
                            onclick="startPayment(@plan.Id, @plan.Price, '@plan.Name')">
                        ACTIVATE PLAN
                    </button>

                </div>
            </div>
        }
    </div>

    <!-- ✅ DEMO BUTTON -->
    <div class="text-center mt-5">
        <button id="demoSuccessBtn" class="btn btn-success btn-lg d-none">
            ✅ Payment Done (Demo)
        </button>
    </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    function startPayment(planId, price, planName) {

        $.post("/Auth/CreateOrder", { amount: price })
        .done(function (order) {

            var options = {
                "key": "rzp_test_Skm5zcDuIhucIg",
                "amount": order.amount,
                "currency": "INR",
                "name": "Movie Mania",
                "description": planName,
                "order_id": order.id,

                "handler": function (response) {
                    verifyPayment(response, planId);
                },

                "modal": {
                    "ondismiss": function () {
                        console.log("Razorpay closed");
                    }
                },

                "prefill": {
                    "name": "@ViewBag.Name",
                    "email": "@ViewBag.Email"
                },

                "theme": {
                    "color": "#ffc107"
                }
            };

            var rzp = new Razorpay(options);
            rzp.open();

            // ✅ Show demo button
            $("#demoSuccessBtn").removeClass("d-none");

            // Store selected planId
            $("#demoSuccessBtn").data("planId", planId);
        })
        .fail(function () {
            alert("Error creating order. Check backend.");
        });
    }

    // ✅ DEMO PAYMENT BUTTON
    $("#demoSuccessBtn").click(function () {

        var planId = $(this).data("planId");

        $.post("/Auth/CaptureRazorpayPayment", {
            userId: "@ViewBag.UserId",
            subscriptionPlanId: planId,
            razorpay_payment_id: "DEMO_PAYMENT"
        })
        .done(function (data) {
            if (data.success) {
                alert("✅ Demo Payment Successful!");
                window.location.href = "/Auth/Login";
            } else {
                alert("Error: " + data.message);
            }
        });
    });

    function verifyPayment(response, planId) {

        $.post("/Auth/CaptureRazorpayPayment", {
            userId: "@ViewBag.UserId",
            subscriptionPlanId: planId,
            razorpay_payment_id: response.razorpay_payment_id,
            razorpay_order_id: response.razorpay_order_id,
            razorpay_signature: response.razorpay_signature
        })
        .done(function (data) {
            if (data.success) {
                alert("Payment Successful");
                window.location.href = "/Auth/Login";
            }
        });
    }
</script>