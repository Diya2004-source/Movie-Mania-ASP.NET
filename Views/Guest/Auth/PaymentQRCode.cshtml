@{
    ViewData["Title"] = "Complete Registration Payment";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            background-color: #141414; /* Netflix dark background */
            color: #ffffff;
            font-family: Arial, sans-serif;
            text-align: center;
            margin: 0;
            padding: 0;
        }

        h2 {
            color: #e50914; /* Netflix red */
            margin-top: 40px;
        }

        p {
            color: #ffffff;
            margin-top: 10px;
        }

        .qr-container {
            margin: 40px auto;
        }

            .qr-container img {
                max-width: 300px;
                border: 4px solid #e50914;
                border-radius: 8px;
            }

        .btn-paid {
            background-color: #e50914;
            color: #ffffff;
            border: none;
            padding: 15px 30px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 10px;
            cursor: pointer;
            margin-top: 30px;
        }

            .btn-paid:hover {
                background-color: #f6121d;so
            }
    </style>
</head>
<body>
    <h2>Complete Your Registration</h2>
    <p>Scan the QR code below and pay to activate your account.</p>

    <div class="qr-container">
        <img src="~/images/payment/qr.jpg" alt="Payment QR Code" />
    </div>

    <form method="post" action="/Auth/Login">
        <button type="submit" class="btn-paid">I've Paid</button>
    </form>
</body>
</html>