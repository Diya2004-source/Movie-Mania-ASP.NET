@{
    Layout = "~/Views/Shared/_GuestLayout.cshtml";
    ViewData["Title"] = "Payment QR Code";
}

<div class="auth-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="auth-card">
                    <div class="auth-header">
                        <h2>Complete Payment</h2>
                        <p>Scan QR code to complete registration</p>
                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                        </div>
                    }

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Payment of <strong>$9.99</strong> is required for registration
                    </div>

                    <!-- QR Code Image -->
                    <div class="qr-container my-4 text-center">
                        <img src="@Url.Content("~/images/payment/qr.jpg")"
                             alt="Payment QR Code"
                             class="img-fluid"
                             style="max-width: 250px; border-radius: 8px; border: 2px solid #ff4d4d;"
                             onerror="this.onerror=null; this.src='https://via.placeholder.com/250x250?text=QR+Code+Not+Found';" />
                        <p class="mt-2 text-muted">Scan with any UPI app</p>
                    </div>

                    <!-- User Details -->
                    <div class="payment-details p-3 rounded mb-4">
                        <p><strong>Name:</strong> @ViewBag.Name</p>
                        <p><strong>Email:</strong> @ViewBag.Email</p>
                        <p><strong>Reference:</strong> @ViewBag.Reference</p>
                    </div>

                    <!-- Payment Status -->
                    <div id="paymentStatus" class="text-center">
                        <div class="spinner-border text-danger" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Waiting for payment confirmation...</p>
                        <p class="small text-muted">After scanning QR, click "I've Paid" button</p>
                    </div>

                    <!-- Manual Payment Confirmation Button -->
                    <div class="text-center mt-4">
                        <button class="btn btn-auth" onclick="confirmPayment()">
                            <i class="fas fa-check-circle me-2"></i>I've Paid
                        </button>
                        <button class="btn btn-outline-secondary ms-2" onclick="cancelPayment()">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .auth-container {
            min-height: calc(100vh - 200px);
            display: flex;
            align-items: center;
            padding: 40px 0;
        }

        .auth-card {
            background: #1a1a1a;
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border: 1px solid #333;
        }

        .auth-header {
            text-align: center;
            margin-bottom: 30px;
        }

            .auth-header h2 {
                color: #fff;
                font-size: 28px;
                font-weight: 600;
                margin-bottom: 10px;
            }

            .auth-header p {
                color: #888;
                font-size: 14px;
            }

        .payment-details {
            background: #2a2a2a;
            border: 1px solid #444;
            border-radius: 8px;
        }

            .payment-details p {
                color: #fff;
                margin-bottom: 8px;
            }

            .payment-details strong {
                color: #ff4d4d;
                width: 80px;
                display: inline-block;
            }

        .alert {
            border: none;
            border-radius: 8px;
            padding: 15px 20px;
        }

        .alert-info {
            background: rgba(255, 77, 77, 0.1);
            color: #ff4d4d;
            border-left: 4px solid #ff4d4d;
        }

        .alert-danger {
            background: rgba(255, 77, 77, 0.1);
            color: #ff4d4d;
            border-left: 4px solid #ff4d4d;
        }

        .btn-auth {
            background: #ff4d4d;
            border: none;
            color: white;
            padding: 12px 30px;
            font-size: 16px;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s;
        }

            .btn-auth:hover {
                background: #ff3333;
                transform: translateY(-2px);
                box-shadow: 0 5px 20px rgba(255, 77, 77, 0.4);
            }

        .btn-outline-secondary {
            background: transparent;
            border: 1px solid #444;
            color: #888;
            padding: 12px 30px;
            border-radius: 8px;
        }

            .btn-outline-secondary:hover {
                background: #333;
                color: white;
            }

        .spinner-border {
            width: 3rem;
            height: 3rem;
        }
    </style>
}

@section Scripts {
    <script>
        function confirmPayment() {
            // Show loading state
            document.getElementById('paymentStatus').innerHTML =
                '<div class="spinner-border text-danger" role="status">' +
                '<span class="visually-hidden">Loading...</span>' +
                '</div>' +
                '<p class="mt-2">Verifying payment...</p>';

            // Simulate payment verification
            setTimeout(function() {
                $.post('@Url.Action("VerifyPayment", "Auth")')
                    .done(function(response) {
                        // ✅ Redirect to Login page after successful payment
                        window.location.href = '@Url.Action("Login", "Auth")';
                    })
                    .fail(function(xhr, status, error) {
                        alert("Payment verification failed. Please try again.");
                        location.reload();
                    });
            }, 2000);
        }

        function cancelPayment() {
            if (confirm('Are you sure you want to cancel the payment?')) {
                window.location.href = '@Url.Action("Register", "Auth")';
            }
        }
    </script>
}