</style>

@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true,
            offset: 100
        });

        // View toggle (grid/list)
        $('.view-option').click(function() {
            $('.view-option').removeClass('active');
            $(this).addClass('active');
            
            if ($(this).data('view') === 'list') {
                $('.wishlist-grid').css('grid-template-columns', 'repeat(1, 1fr)');
                $('.wishlist-card').css('display', 'flex');
                $('.wishlist-poster').css('width', '150px');
            } else {
                $('.wishlist-grid').css('grid-template-columns', '');
                $('.wishlist-card').css('display', '');
                $('.wishlist-poster').css('width', '');
            }
        });

        // Edit item
        function editItem(id) {
            $.get('@Url.Action("GetWishlistItem", "Wishlist")/' + id)
                .done(function(item) {
                    $('#editId').val(item.id);
                    $('#editPriority').val(item.priority);
                    $('#editNotes').val(item.notes);
                    $('#editNotification').prop('checked', item.notificationEnabled);
                    $('#editModal').modal('show');
                });
        }

        // Save edit
        function saveEdit() {
            var data = {
                Id: $('#editId').val(),
                Priority: parseInt($('#editPriority').val()),
                Notes: $('#editNotes').val(),
                NotificationEnabled: $('#editNotification').is(':checked')
            };

            $.post('@Url.Action("Update", "Wishlist")', data)
                .done(function(response) {
                    if (response.success) {
                        toastr.success(response.message);
                        $('#editModal').modal('hide');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        toastr.error(response.message);
                    }
                })
                .fail(function() {
                    toastr.error('Error updating item');
                });
        }

        // Remove from wishlist
        function removeFromWishlist(id) {
            if (confirm('Remove this item from your wishlist?')) {
                $.post('@Url.Action("Remove", "Wishlist")', { id: id })
                    .done(function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            toastr.error(response.message);
                        }
                    });
            }
        }

        // Mark as watched
        function markAsWatched(id) {
            var rating = prompt('Rate this item (1-10):', '8');
            if (rating !== null) {
                var numRating = parseFloat(rating);
                if (numRating >= 0 && numRating <= 10) {
                    $.post('@Url.Action("MarkAsWatched", "Wishlist")', { id: id, rating: numRating })
                        .done(function(response) {
                            if (response.success) {
                                toastr.success(response.message);
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                toastr.error(response.message);
                            }
                        });
                } else {
                    toastr.warning('Please enter a rating between 0 and 10');
                }
            }
        }

        // Clear all watched
        function clearAllWatched() {
            if (confirm('Remove all watched items from your wishlist?')) {
                $.post('@Url.Action("ClearWatched", "Wishlist")')
                    .done(function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            toastr.error(response.message);
                        }
                    });
            }
        }

        // Toggle priority
        function togglePriority(id) {
            $.post('@Url.Action("TogglePriority", "Wishlist")', { id: id })
                .done(function(response) {
                    if (response.success) {
                        toastr.success(response.message);
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        toastr.error(response.message);
                    }
                });
        }
    </script>
}