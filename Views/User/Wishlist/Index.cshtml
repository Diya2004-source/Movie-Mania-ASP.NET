@model IEnumerable<MovieMania.Models.Wishlist>

@{
    ViewData["Title"] = "My List";
    var stats = ViewBag.Stats;
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="wishlist-page">
    <div class="wishlist-header">
        <div class="container-fluid px-4">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1 class="page-title">
                        <i class="fas fa-heart me-2 text-danger"></i>My List
                    </h1>
                    <p class="page-subtitle">
                        Manage your personal collection of movies, shows, and anime
                    </p>
                </div>

                <div class="col-lg-6 d-flex justify-content-lg-end gap-2 flex-wrap mt-3 mt-lg-0">

                    <a asp-action="Index"
                       asp-route-filter="all"
                       class="filter-chip @(ViewBag.CurrentFilter == "all" ? "active" : "")">
                        All <span class="badge">@stats.Total</span>
                    </a>

                    <a asp-action="Index"
                       asp-route-filter="movies"
                       class="filter-chip @(ViewBag.CurrentFilter == "movies" ? "active" : "")">
                        Movies <span class="badge">@stats.Movies</span>
                    </a>

                    <a asp-action="Index"
                       asp-route-filter="shows"
                       class="filter-chip @(ViewBag.CurrentFilter == "shows" ? "active" : "")">
                        Shows <span class="badge">@stats.Shows</span>
                    </a>

                    <a asp-action="Index"
                       asp-route-filter="anime"
                       class="filter-chip @(ViewBag.CurrentFilter == "anime" ? "active" : "")">
                        Anime <span class="badge">@stats.Anime</span>
                    </a>

                    <a asp-action="Index"
                       asp-route-filter="high"
                       class="filter-chip priority @(ViewBag.CurrentFilter == "high" ? "active" : "")">
                        🔥 High Priority
                        <span class="badge">@stats.HighPriority</span>
                    </a>

                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid px-4 py-5">

        @if (Model != null && Model.Any())
        {
            <div class="wishlist-grid">

                @foreach (var item in Model)
                {
                    var title = item.ItemType == "Movie"
                    ? item.Movie?.Title
                    : item.Show?.Title;

                    var poster = item.ItemType == "Movie"
                    ? item.Movie?.ThumbnailUrl
                    : item.Show?.ThumbnailUrl;

                    var rating = item.ItemType == "Movie"
                    ? item.Movie?.Rating
                    : item.Show?.Rating;

                    var detailUrl = item.ItemType == "Movie"
                    ? "/User/Home/MovieDetails/" + item.MovieId
                    : "/User/Home/ShowDetails/" + item.ShowId;

                    <div class="wishlist-card" id="wishlist-item-@item.Id">

                        <div class="wishlist-poster"
                             onclick="location.href='@detailUrl'">

                            <img src="@(poster ?? "/images/default-movie.jpg")"
                                 alt="@title">

                            @if (item.Priority == 1)
                            {
                                <div class="priority-badge">
                                    High Priority
                                </div>
                            }

                            <div class="type-badge @(item.ItemType.ToLower())-badge">
                                @item.ItemType
                            </div>

                            @if (rating > 0)
                            {
                                <div class="rating-badge">
                                    <i class="fas fa-star"></i>
                                    <span>@rating?.ToString("0.0")</span>
                                </div>
                            }

                            <div class="wishlist-overlay">

                                <button class="action-btn watch-main"
                                        onclick="event.stopPropagation(); markWatched(@item.Id)"
                                        title="Mark as Watched">
                                    <i class="fas fa-check"></i>
                                </button>

                                <button class="action-btn remove-secondary"
                                        onclick="event.stopPropagation(); removeItem(@item.Id)"
                                        title="Remove from Wishlist">
                                    <i class="fas fa-trash-alt"></i>
                                </button>

                            </div>
                        </div>

                        <div class="wishlist-info">
                            <h4 class="item-title">@title</h4>

                            <div class="item-meta">
                                <span class="item-genre">
                                    @(item.Movie?.Genre ?? item.Show?.Genre ?? "General")
                                </span>

                                <span class="item-date">
                                    Added @item.AddedDate.ToString("dd MMM")
                                </span>
                            </div>
                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-wishlist">
                <div class="empty-state-content">

                    <i class="fas fa-layer-group mb-4"></i>

                    <h2>Your list is waiting...</h2>

                    <p>
                        You haven't added any
                        @(ViewBag.CurrentFilter == "all"
                                            ? "items"
                                            : ViewBag.CurrentFilter) yet.
                </p>

                    <a href="/" class="btn-browse">
                        Browse Catalog
                    </a>

                </div>
            </div>
                }

    </div>
</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        function removeItem(id) {

            Swal.fire({
                title: 'Remove from Wishlist?',
                text: 'This will be removed from wishlist.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Remove',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#e50914',
                cancelButtonColor: '#6c757d',
                background: '#1a1a1a',
                color: '#fff'
            }).then((result) => {

                if (result.isConfirmed) {

                    $.post('/User/Wishlist/Remove', { id: id })

                    .done(function (data) {

                        if (data.success) {

                            $(`#wishlist-item-${id}`)
                                .fadeOut(400, function () {
                                    $(this).remove();
                                });

                            updateWishlistBadge(data.count);

                            Swal.fire({
                                icon: 'success',
                                title: 'Removed!',
                                text: 'Movie removed from wishlist successfully.',
                                timer: 1800,
                                showConfirmButton: false,
                                background: '#1a1a1a',
                                color: '#fff'
                            });
                        }
                    });
                }
            });
        }

        function markWatched(id) {

            $.post('/User/Wishlist/MarkAsWatched', { id: id })

            .done(function (data) {

                if (data.success) {

                    Swal.fire({
                        icon: 'success',
                        title: 'Moved to History!',
                        text: data.message,
                        timer: 2000,
                        showConfirmButton: false,
                        background: '#1a1a1a',
                        color: '#fff'
                    });

                    $(`#wishlist-item-${id}`).fadeOut();
                }
            });
        }

        function updateWishlistBadge(count) {
            $('.wishlist-badge').text(count);
        }

    </script>
}

