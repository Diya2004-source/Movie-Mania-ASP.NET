@model IEnumerable<MovieMania.Models.Wishlist>

@{
    ViewData["Title"] = "My Wishlist";
    Layout = "_UserLayout";
}

<div class="wishlist-page">
    <!-- Hero Banner -->
    <section class="page-hero mb-5">
        <div class="container">
            <div class="hero-content text-center">
                <h1 class="hero-title">My Wishlist</h1>
                <p class="hero-subtitle">Keep track of all the movies and shows you want to watch</p>
                
                <!-- Stats Cards -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <i class="fas fa-heart text-danger"></i>
                        <div class="stat-info">
                            <h3>@ViewBag.Stats.Total</h3>
                            <p>Total Items</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <i class="fas fa-film text-primary"></i>
                        <div class="stat-info">
                            <h3>@ViewBag.Stats.Movies</h3>
                            <p>Movies</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <i class="fas fa-tv text-info"></i>
                        <div class="stat-info">
                            <h3>@ViewBag.Stats.Shows</h3>
                            <p>TV Shows</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <i class="fas fa-dragon text-danger"></i>
                        <div class="stat-info">
                            <h3>@ViewBag.Stats.Anime</h3>
                            <p>Anime</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <i class="fas fa-check-circle text-success"></i>
                        <div class="stat-info">
                            <h3>@ViewBag.Stats.Watched</h3>
                            <p>Watched</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <i class="fas fa-clock text-warning"></i>
                        <div class="stat-info">
                            <h3>@ViewBag.Stats.Unwatched</h3>
                            <p>To Watch</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Filters Section -->
    <section class="filters-section mb-5">
        <div class="container">
            <div class="filters-wrapper">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="filter-tabs">
                            <a href="@Url.Action("Index", new { filter = "all" })" 
                               class="filter-tab @(ViewBag.CurrentFilter == "all" ? "active" : "")">
                                <i class="fas fa-list me-2"></i>All Items
                                <span class="badge">@ViewBag.Stats.Total</span>
                            </a>
                            <a href="@Url.Action("Index", new { filter = "movies" })" 
                               class="filter-tab @(ViewBag.CurrentFilter == "movies" ? "active" : "")">
                                <i class="fas fa-film me-2"></i>Movies
                                <span class="badge">@ViewBag.Stats.Movies</span>
                            </a>
                            <a href="@Url.Action("Index", new { filter = "shows" })" 
                               class="filter-tab @(ViewBag.CurrentFilter == "shows" ? "active" : "")">
                                <i class="fas fa-tv me-2"></i>TV Shows
                                <span class="badge">@ViewBag.Stats.Shows</span>
                            </a>
                            <a href="@Url.Action("Index", new { filter = "anime" })" 
                               class="filter-tab @(ViewBag.CurrentFilter == "anime" ? "active" : "")">
                                <i class="fas fa-dragon me-2"></i>Anime
                                <span class="badge">@ViewBag.Stats.Anime</span>
                            </a>
                            <a href="@Url.Action("Index", new { filter = "unwatched" })" 
                               class="filter-tab @(ViewBag.CurrentFilter == "unwatched" ? "active" : "")">
                                <i class="fas fa-clock me-2"></i>To Watch
                                <span class="badge">@ViewBag.Stats.Unwatched</span>
                            </a>
                            <a href="@Url.Action("Index", new { filter = "high" })" 
                               class="filter-tab @(ViewBag.CurrentFilter == "high" ? "active" : "")">
                                <i class="fas fa-exclamation-circle me-2"></i>High Priority
                                <span class="badge">@ViewBag.Stats.HighPriority</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                        <div class="view-options">
                            <button class="view-option active" data-view="grid">
                                <i class="fas fa-th"></i>
                            </button>
                            <button class="view-option" data-view="list">
                                <i class="fas fa-list"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Results Info -->
    <section class="results-section mb-4">
        <div class="container">
            <div class="results-info">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <p class="mb-0">
                            <i class="fas fa-heart me-2 text-danger"></i>
                            Showing <strong>@Model.Count()</strong> of <strong>@ViewBag.Stats.Total</strong> items
                        </p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <button class="btn-clear-all" onclick="clearAllWatched()" style="display: @(ViewBag.Stats.Watched > 0 ? "inline-block" : "none")">
                            <i class="fas fa-trash me-2"></i>Clear Watched
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Wishlist Grid -->
    <section class="wishlist-grid-section mb-5">
        <div class="container">
            @if (!Model.Any())
            {
                <div class="empty-wishlist">
                    <div class="empty-content">
                        <i class="fas fa-heart-broken fa-4x mb-3"></i>
                        <h3>Your Wishlist is Empty</h3>
                        <p>Start adding movies and shows to keep track of what you want to watch!</p>
                        <div class="suggestions">
                            <h5>Quick Actions:</h5>
                            <div class="action-buttons">
                                <a href="@Url.Action("Movies", "Home")" class="btn-action">
                                    <i class="fas fa-film me-2"></i>Browse Movies
                                </a>
                                <a href="@Url.Action("Shows", "Home")" class="btn-action">
                                    <i class="fas fa-tv me-2"></i>Browse Shows
                                </a>
                                <a href="@Url.Action("Anime", "Home")" class="btn-action">
                                    <i class="fas fa-dragon me-2"></i>Browse Anime
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="wishlist-grid" id="wishlistGrid">
                    @foreach (var item in Model)
                    {
                        <div class="wishlist-card-wrapper" data-aos="fade-up" data-aos-delay="@(item.Id * 20)">
                            <div class="wishlist-card @(item.IsWatched ? "watched" : "") @(item.Priority == 1 ? "high-priority" : "")">
                                @if (item.Priority == 1)
                                {
                                    <div class="priority-badge">
                                        <i class="fas fa-exclamation-circle"></i>
                                        <span>High Priority</span>
                                    </div>
                                }
                                
                                @if (item.Movie != null)
                                {
                                    <!-- Movie Item -->
                                    <div class="wishlist-poster">
                                        <img src="@(item.Movie.ThumbnailUrl ?? "/images/default-movie.jpg")" 
                                             alt="@item.Movie.Title">
                                        <div class="item-type-badge movie">
                                            <i class="fas fa-film"></i>
                                        </div>
                                        @if (item.IsWatched)
                                        {
                                            <div class="watched-badge">
                                                <i class="fas fa-check-circle"></i>
                                                <span>Watched</span>
                                            </div>
                                        }
                                        <div class="wishlist-overlay">
                                            <div class="overlay-content">
                                                <a href="@Url.Action("MovieDetails", "Home", new { id = item.Movie.Id })" 
                                                   class="btn-view">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <button class="btn-edit" onclick="editItem(@item.Id)">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn-remove" onclick="removeFromWishlist(@item.Id)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="wishlist-info">
                                        <h6 class="item-title">@item.Movie.Title</h6>
                                        <div class="item-meta">
                                            <span class="genre">@item.Movie.Genre</span>
                                            <span class="year">@item.Movie.ReleaseYear</span>
                                        </div>
                                        @if (item.Movie.Rating.HasValue)
                                        {
                                            <div class="item-rating">
                                                <i class="fas fa-star text-warning"></i>
                                                <span>@item.Movie.Rating.Value.ToString("F1")</span>
                                            </div>
                                        }
                                        <div class="item-date">
                                            <i class="far fa-calendar-alt"></i>
                                            Added: @item.AddedDate.ToString("dd MMM yyyy")
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.Notes))
                                        {
                                            <div class="item-notes">
                                                <i class="fas fa-sticky-note"></i>
                                                @item.Notes
                                            </div>
                                        }
                                        <div class="item-actions">
                                            @if (!item.IsWatched)
                                            {
                                                <button class="btn-watched" onclick="markAsWatched(@item.Id)">
                                                    <i class="fas fa-check-circle"></i> Mark Watched
                                                </button>
                                            }
                                            @if (!string.IsNullOrEmpty(item.Movie.VideoUrl))
                                            {
                                                <a href="@item.Movie.VideoUrl" target="_blank" class="btn-watch">
                                                    <i class="fas fa-play"></i> Watch
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                                else if (item.Show != null)
                                {
                                    <!-- Show or Anime Item -->
                                    <div class="wishlist-poster">
                                        <img src="@(item.Show.ThumbnailUrl ?? (item.Show.Genre == "Anime" ? "/images/default-anime.jpg" : "/images/default-show.jpg"))" 
                                             alt="@item.Show.Title">
                                        <div class="item-type-badge @(item.Show.Genre == "Anime" ? "anime" : "show")">
                                            <i class="fas @(item.Show.Genre == "Anime" ? "fa-dragon" : "fa-tv")"></i>
                                        </div>
                                        @if (item.IsWatched)
                                        {
                                            <div class="watched-badge">
                                                <i class="fas fa-check-circle"></i>
                                                <span>Watched</span>
                                            </div>
                                        }
                                        <div class="wishlist-overlay">
                                            <div class="overlay-content">
                                                <a href="@Url.Action("ShowDetails", "Home", new { id = item.Show.Id })" 
                                                   class="btn-view">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <button class="btn-edit" onclick="editItem(@item.Id)">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn-remove" onclick="removeFromWishlist(@item.Id)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="wishlist-info">
                                        <h6 class="item-title">@item.Show.Title</h6>
                                        <div class="item-meta">
                                            <span class="genre @(item.Show.Genre == "Anime" ? "text-danger" : "")">
                                                @if (item.Show.Genre == "Anime")
                                                {
                                                    <i class="fas fa-dragon me-1"></i>
                                                }
                                                @item.Show.Genre
                                            </span>
                                            <span class="year">@item.Show.ReleaseYear</span>
                                        </div>
                                        <div class="show-stats">
                                            <span class="seasons">
                                                <i class="fas fa-layer-group"></i> @item.Show.TotalSeasons S
                                            </span>
                                            <span class="episodes">
                                                <i class="fas fa-play-circle"></i> @item.Show.TotalEpisodes Ep
                                            </span>
                                        </div>
                                        @if (item.Show.Rating.HasValue)
                                        {
                                            <div class="item-rating">
                                                <i class="fas fa-star text-warning"></i>
                                                <span>@item.Show.Rating.Value.ToString("F1")</span>
                                            </div>
                                        }
                                        <div class="item-date">
                                            <i class="far fa-calendar-alt"></i>
                                            Added: @item.AddedDate.ToString("dd MMM yyyy")
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.Notes))
                                        {
                                            <div class="item-notes">
                                                <i class="fas fa-sticky-note"></i>
                                                @item.Notes
                                            </div>
                                        }
                                        <div class="item-actions">
                                            @if (!item.IsWatched)
                                            {
                                                <button class="btn-watched" onclick="markAsWatched(@item.Id)">
                                                    <i class="fas fa-check-circle"></i> Mark Watched
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <section class="pagination-section">
            <div class="container">
                <nav aria-label="Wishlist pagination">
                    <ul class="pagination">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { 
                                    page = ViewBag.CurrentPage - 1, 
                                    filter = ViewBag.CurrentFilter 
                                })">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { 
                                    page = i, 
                                    filter = ViewBag.CurrentFilter 
                                })">@i</a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { 
                                    page = ViewBag.CurrentPage + 1, 
                                    filter = ViewBag.CurrentFilter 
                                })">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </section>
    }
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark">
            <div class-="modal-header border-secondary">
                <h5 class="modal-title text-white">Edit Wishlist Item</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <input type="hidden" id="editId" name="id" />
                    
                    <div class="mb-3">
                        <label class="form-label text-white">Priority</label>
                        <select class="form-select bg-dark text-white" id="editPriority" name="priority">
                            <option value="1">High Priority</option>
                            <option value="2">Normal Priority</option>
                            <option value="3">Low Priority</option>
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label text-white">Notes</label>
                        <textarea class="form-control bg-dark text-white" id="editNotes" name="notes" rows="3"></textarea>
                    </div>
                    
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="editNotification" name="notification" />
                        <label class="form-check-label text-white">Enable Notifications</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveEdit()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Custom CSS -->
<style>
    /* Page Hero */
    .page-hero {
        background: linear-gradient(135deg, #0a0c0f 0%, #1a1a1a 100%);
        padding: 60px 0;
        position: relative;
        overflow: hidden;
    }

    .page-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" opacity="0.1"><circle cx="50" cy="50" r="40" fill="none" stroke="%23ff4d4d" stroke-width="2"/></svg>') repeat;
        animation: rotate 60s linear infinite;
    }

    .hero-title {
        font-size: 3.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #fff, #ff4d4d);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 15px;
        animation: fadeInUp 0.8s ease;
    }

    .hero-subtitle {
        font-size: 1.2rem;
        color: #9ca3af;
        margin-bottom: 40px;
        animation: fadeInUp 1s ease;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 15px;
        margin-top: 30px;
    }

    .stat-card {
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(10px);
        border-radius: 12px;
        padding: 20px 10px;
        text-align: center;
        border: 1px solid rgba(255,255,255,0.1);
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        border-color: #ff4d4d;
        box-shadow: 0 10px 30px rgba(255,77,77,0.2);
    }

    .stat-card i {
        font-size: 2rem;
        margin-bottom: 10px;
    }

    .stat-info h3 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: white;
    }

    .stat-info p {
        color: #9ca3af;
        margin: 5px 0 0;
        font-size: 0.8rem;
    }

    /* Filters Section */
    .filters-wrapper {
        background: #1a1a1a;
        border-radius: 20px;
        padding: 20px 30px;
        border: 1px solid rgba(255,255,255,0.05);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .filter-tabs {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .filter-tab {
        padding: 10px 20px;
        border-radius: 30px;
        background: rgba(255,255,255,0.05);
        color: #9ca3af;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .filter-tab:hover {
        background: rgba(255,77,77,0.1);
        color: white;
        border-color: #ff4d4d;
    }

    .filter-tab.active {
        background: linear-gradient(135deg, #ff4d4d, #ff3333);
        color: white;
        border-color: transparent;
    }

    .filter-tab .badge {
        background: rgba(255,255,255,0.2);
        color: white;
        margin-left: 8px;
        padding: 3px 8px;
        border-radius: 20px;
        font-size: 0.7rem;
    }

    .view-options {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .view-option {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.1);
        color: #9ca3af;
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .view-option:hover {
        border-color: #ff4d4d;
        color: white;
    }

    .view-option.active {
        background: #ff4d4d;
        border-color: #ff4d4d;
        color: white;
    }

    /* Results Info */
    .results-info {
        background: #1a1a1a;
        border-radius: 12px;
        padding: 15px 20px;
        border: 1px solid rgba(255,255,255,0.05);
    }

    .btn-clear-all {
        background: transparent;
        border: 1px solid rgba(255,77,77,0.3);
        color: #ff4d4d;
        padding: 8px 20px;
        border-radius: 30px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .btn-clear-all:hover {
        background: #ff4d4d;
        color: white;
        border-color: #ff4d4d;
    }

    /* Wishlist Grid */
    .wishlist-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .wishlist-card-wrapper {
        animation: fadeInUp 0.5s ease;
    }

    .wishlist-card {
        background: #1a1a1a;
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.4s ease;
        height: 100%;
        border: 1px solid rgba(255,255,255,0.05);
        position: relative;
    }

    .wishlist-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(255,77,77,0.2);
    }

    .wishlist-card.watched {
        opacity: 0.7;
        filter: grayscale(0.3);
    }

    .wishlist-card.watched:hover {
        opacity: 0.9;
    }

    .wishlist-card.high-priority {
        border-left: 4px solid #ff4d4d;
    }

    .priority-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        background: linear-gradient(135deg, #ff4d4d, #ff3333);
        color: white;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
        z-index: 3;
        display: flex;
        align-items: center;
        gap: 5px;
        box-shadow: 0 5px 15px rgba(255,77,77,0.3);
    }

    .wishlist-poster {
        position: relative;
        aspect-ratio: 2/3;
        overflow: hidden;
    }

    .wishlist-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .wishlist-card:hover .wishlist-poster img {
        transform: scale(1.1);
    }

    .item-type-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        z-index: 2;
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    }

    .item-type-badge.movie {
        background: linear-gradient(135deg, #ff4d4d, #ff3333);
        color: white;
    }

    .item-type-badge.show {
        background: linear-gradient(135deg, #0dcaf0, #0bb7d6);
        color: white;
    }

    .item-type-badge.anime {
        background: linear-gradient(135deg, #ff4d4d, #ff3333);
        color: white;
    }

    .watched-badge {
        position: absolute;
        bottom: 10px;
        left: 10px;
        background: linear-gradient(135deg, #00c853, #00a844);
        color: white;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 5px;
        box-shadow: 0 5px 15px rgba(0,200,83,0.3);
    }

    .wishlist-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
