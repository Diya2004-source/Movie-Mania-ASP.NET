@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function removeItem(id) {
            Swal.fire({
                title: 'Remove from list?',
                text: "You can always add it back later.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e50914',
                background: '#1a1a1a',
                color: '#fff'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/User/Wishlist/Remove', { id: id })
                    .done(function (data) {
                        if (data.success) {
                            $(`#wishlist-item-${id}`).fadeOut(400, function() { $(this).remove(); });
                            updateWishlistBadge(data.count);
                        }
                    });
                }
            });
        }

        function markWatched(id) {
            $.post('/User/Wishlist/MarkAsWatched', { id: id })
            .done(function (data) {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Moved to History!',
                        text: data.message,
                        timer: 2000,
                        showConfirmButton: false,
                        background: '#1a1a1a',
                        color: '#fff'
                    });
                    $(`#wishlist-item-${id}`).fadeOut();
                }
            });
        }

        function updateWishlistBadge(count) {
            $('.wishlist-badge').text(count);
        }
    </script>
}

