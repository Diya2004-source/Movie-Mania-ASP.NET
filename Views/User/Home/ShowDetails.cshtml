@model MovieMania.Models.Show

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@{
    // Cast ViewBag data to proper types
    var episodesBySeason = ViewBag.EpisodesBySeason as Dictionary<int, List<Episode>>;
    var totalSeasons = ViewBag.TotalSeasons != null ? (int)ViewBag.TotalSeasons : 0;
    var totalEpisodes = ViewBag.TotalEpisodes != null ? (int)ViewBag.TotalEpisodes : 0;
}

<div class="show-details-page">
    <!-- Hero Section -->
    <section class="show-hero"
             style="background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.9)),
                    url('@(Model.ThumbnailUrl ?? "/images/default-backdrop.jpg")') center/cover no-repeat fixed;">
        <div class="container">
            <div class="row align-items-center min-vh-60">
                <div class="col-lg-3 col-md-4 mb-4 mb-md-0">
                    <div class="show-poster-wrapper">
                        <img src="@(Model.ThumbnailUrl ?? "/images/default-show.jpg")"
                             alt="@Model.Title"
                             class="img-fluid rounded show-poster">
                        <div class="show-badge">
                            <span class="badge">@(Model.Genre ?? "Hotstar Specials")</span>
                        </div>
                        @if (Model.Rating > 0)
                        {
                            <div class="rating-badge">
                                <i class="fas fa-star"></i>
                                <span>@string.Format("{0:F1}", Model.Rating)</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-lg-9 col-md-8">
                    <div class="show-info">
                        <h1 class="show-title">@Model.Title</h1>
                        <div class="show-meta">
                            @if (Model.ReleaseYear.HasValue)
                            {
                                <span class="meta-item"><i class="far fa-calendar-alt"></i> @Model.ReleaseYear.Value</span>
                            }
                            <span class="meta-item"><i class="fas fa-tag"></i> @Model.Genre</span>
                            <span class="meta-item"><i class="fas fa-layer-group"></i> @totalSeasons Seasons</span>
                            <span class="meta-item"><i class="fas fa-play-circle"></i> @totalEpisodes Episodes</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <p class="show-description">@Model.Description</p>
                        }
                        <div class="show-actions">
                            <button class="btn-watch" onclick="watchShow(@Model.Id)">
                                <i class="fas fa-play me-2"></i>Start Watching
                            </button>
                            <button class="btn-wishlist" onclick="addToWishlist(@Model.Id)">
                                <i class="fas fa-plus me-2"></i>My List
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Episodes Section -->
    <section class="episodes-section py-5">
        <div class="container">
            <h3 class="section-title">Episodes</h3>
            @if (episodesBySeason != null && episodesBySeason.Count > 0)
            {
                var seasons = episodesBySeason.Keys.OrderBy(s => s).ToList();
                <ul class="nav nav-tabs" id="seasonTabs" role="tablist">
                    @foreach (var season in seasons)
                    {
                        <li class="nav-item">
                            <button class="nav-link @(season == 1 ? "active" : "")"
                                    id="season-@season-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#season-@season">
                                Season @season
                            </button>
                        </li>
                    }
                </ul>
                <div class="tab-content">
                    @foreach (var season in seasons)
                    {
                        var episodes = episodesBySeason[season].OrderBy(e => e.EpisodeNumber).ToList();
                        <div class="tab-pane fade @(season == 1 ? "show active" : "")" id="season-@season">
                            <div class="episodes-grid">
                                @foreach (var episode in episodes)
                                {
                                    <div class="episode-card" onclick="watchEpisode(@episode.Id)">
                                        <div class="episode-poster">
                                            <img src="@(episode.ThumbnailUrl ?? "/images/default-episode.jpg")"
                                                 alt="@episode.Title">
                                            <div class="episode-overlay">
                                                <i class="fas fa-play"></i>
                                            </div>
                                            @if (episode.Duration.HasValue)
                                            {
                                                <span class="episode-duration">@episode.Duration.Value min</span>
                                            }
                                        </div>
                                        <div class="episode-info">
                                            <h5 class="episode-title">
                                                @episode.EpisodeNumber. @episode.Title
                                            </h5>
                                            <p class="episode-description">
                                                @if (!string.IsNullOrEmpty(episode.Description) && episode.Description.Length > 100)
                                                {
                                                    @(episode.Description.Substring(0, 100) + "...")
                                                }
                                                else
                                                {
                                                    @episode.Description
                                                }
                                            </p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-list"></i>
                    <h3>No episodes yet</h3>
                    <p>Episodes will be added soon</p>
                </div>
            }
        </div>
    </section>
</div>

<style>
    .show-details-page {
        background: #141414;
        min-height: 100vh;
        color: white;
    }

    .show-hero {
        min-height: 70vh;
        padding: 100px 0 50px;
        position: relative;
    }

    .show-poster-wrapper {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    }

    .show-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        z-index: 2;
    }

    .badge {
        background: #e50914;
        color: white;
        padding: 4px 12px;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .rating-badge {
        position: absolute;
        bottom: 15px;
        right: 15px;
        background: rgba(0,0,0,0.8);
        padding: 8px 16px;
        border-radius: 4px;
        color: #ffd700;
        font-weight: 600;
    }

    .show-title {
        font-size: 3rem;
        font-weight: 700;
        margin-bottom: 20px;
        color: white;
    }

    .show-meta {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

    .meta-item {
        background: rgba(255,255,255,0.1);
        padding: 6px 18px;
        border-radius: 4px;
        font-size: 0.9rem;
        color: #b3b3b3;
    }

        .meta-item i {
            margin-right: 6px;
            color: #e50914;
        }

    .show-description {
        font-size: 1.1rem;
        line-height: 1.7;
        color: #b3b3b3;
        margin-bottom: 25px;
        max-width: 700px;
    }

    .show-actions {
        display: flex;
        gap: 15px;
    }

    .btn-watch {
        background: #e50914;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 4px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-wishlist {
        background: rgba(255,255,255,0.1);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 4px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
    }

    .episodes-section {
        background: #0f0f0f;
        padding: 60px 0;
    }

    .section-title {
        color: white;
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 30px;
        border-bottom: 2px solid #e50914;
        padding-bottom: 10px;
        display: inline-block;
    }

    .nav-tabs {
        border-bottom: 2px solid #333;
        margin-bottom: 30px;
    }

        .nav-tabs .nav-link {
            background: transparent;
            color: #b3b3b3;
            border: none;
            padding: 10px 20px;
            font-weight: 500;
        }

            .nav-tabs .nav-link:hover {
                color: white;
                border: none;
            }

            .nav-tabs .nav-link.active {
                background: transparent;
                color: #e50914;
                border: none;
                border-bottom: 2px solid #e50914;
            }

    .episodes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
    }

    .episode-card {
        background: #1a1a1a;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.3s ease;
    }

        .episode-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(229,9,20,0.2);
        }

    .episode-poster {
        position: relative;
        aspect-ratio: 16/9;
        overflow: hidden;
    }

        .episode-poster img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .episode-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .episode-card:hover .episode-overlay {
        opacity: 1;
    }

    .episode-overlay i {
        font-size: 3rem;
        color: #e50914;
    }

    .episode-duration {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: rgba(0,0,0,0.8);
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.8rem;
    }

    .episode-info {
        padding: 15px;
    }

    .episode-title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 5px;
        color: white;
    }

    .episode-description {
        color: #b3b3b3;
        font-size: 0.85rem;
        margin: 0;
        line-height: 1.5;
    }

    .empty-state {
        text-align: center;
        padding: 60px;
        background: #1a1a1a;
        border-radius: 8px;
        color: #b3b3b3;
    }

        .empty-state i {
            font-size: 3rem;
            color: #e50914;
            opacity: 0.5;
            margin-bottom: 15px;
        }

    @@media (max-width: 768px) {
        .show-title {
            font-size: 2.2rem;
        }

        .show-actions {
            flex-direction: column;
        }

        .episodes-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@section Scripts {
    <script>
        function watchShow(id) {
            window.location.href = '/User/Home/WatchShow/' + id;
        }

        function watchEpisode(id) {
            window.location.href = '/User/Home/PlayEpisode/' + id;
        }

        function addToWishlist(id) {
            fetch('/User/Wishlist/Add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ showId: id })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Added to your list!');
                } else {
                    alert(data.message);
                }
            });
        }
    </script>
}