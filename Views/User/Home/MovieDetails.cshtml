@model MovieMania.Models.Movie

@{
    ViewData["Title"] = Model.Title;
    Layout = "_UserLayout";
}

<div class="movie-details-page">
    <!-- Hero Section with Backdrop -->
    <section class="movie-hero"
             style="background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.9)),
                    url('@(Model.ThumbnailUrl ?? "/images/default-backdrop.jpg")') center/cover no-repeat fixed;">

        <div class="container">
            <div class="row align-items-center min-vh-60">
                <div class="col-lg-3 col-md-4 mb-4 mb-md-0" data-aos="fade-right">
                    <div class="movie-poster-wrapper">
                        <img src="@(Model.ThumbnailUrl ?? "/images/default-movie.jpg")"
                             alt="@Model.Title"
                             class="img-fluid rounded movie-poster">
                        @if (Model.Rating.HasValue)
                        {
                            <div class="rating-badge">
                                <i class="fas fa-star text-warning"></i>
                                <span>@Model.Rating.Value.ToString("F1")</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-9 col-md-8" data-aos="fade-left">
                    <div class="movie-info">
                        <h1 class="movie-title">@Model.Title</h1>

                        <div class="movie-meta">
                            @if (Model.ReleaseYear.HasValue)
                            {
                                <span class="meta-item">
                                    <i class="far fa-calendar-alt"></i> @Model.ReleaseYear
                                </span>
                            }
                            <span class="meta-item">
                                <i class="fas fa-tag"></i> @Model.Genre
                            </span>
                            @if (Model.Duration.HasValue)
                            {
                                <span class="meta-item">
                                    <i class="far fa-clock"></i> @Model.Duration min
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(Model.Language))
                            {
                                <span class="meta-item">
                                    <i class="fas fa-language"></i> @Model.Language
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <p class="movie-description">@Model.Description</p>
                        }

                        <div class="movie-details-grid">
                            @if (!string.IsNullOrEmpty(Model.Director))
                            {
                                <div class="detail-item">
                                    <span class="detail-label">Director</span>
                                    <span class="detail-value">@Model.Director</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Cast))
                            {
                                <div class="detail-item">
                                    <span class="detail-label">Cast</span>
                                    <span class="detail-value">@Model.Cast</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Country))
                            {
                                <div class="detail-item">
                                    <span class="detail-label">Country</span>
                                    <span class="detail-value">@Model.Country</span>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(Model.VideoUrl))
                        {
                            <div class="watch-now-container">
                                <a href="@Url.Action("PlayMovie", "Home", new { id = Model.Id })" class="btn-watch-now">
                                    <i class="fas fa-play-circle me-2"></i> Watch Now
                                </a>
                                <small class="text-muted ms-3">Click to watch</small>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Video not available yet
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Movie Details Section -->
    <section class="details-section py-5">
        <div class="container">
            <div class="row">
                <div class="col-md-8">
                    <div class="details-card">
                        <h3 class="section-subtitle">
                            <i class="fas fa-info-circle me-2 text-primary"></i>Movie Details
                        </h3>

                        <table class="details-table">
                            <tr>
                                <th>Title:</th>
                                <td>@Model.Title</td>
                            </tr>
                            <tr>
                                <th>Genre:</th>
                                <td>@Model.Genre</td>
                            </tr>
                            @if (Model.ReleaseYear.HasValue)
                            {
                                <tr>
                                    <th>Release Year:</th>
                                    <td>@Model.ReleaseYear</td>
                                </tr>
                            }
                            @if (Model.ReleaseDate.HasValue)
                            {
                                <tr>
                                    <th>Release Date:</th>
                                    <td>@Model.ReleaseDate.Value.ToString("MMMM dd, yyyy")</td>
                                </tr>
                            }
                            @if (Model.Duration.HasValue)
                            {
                                <tr>
                                    <th>Duration:</th>
                                    <td>@Model.Duration minutes</td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.Director))
                            {
                                <tr>
                                    <th>Director:</th>
                                    <td>@Model.Director</td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.Cast))
                            {
                                <tr>
                                    <th>Cast:</th>
                                    <td>@Model.Cast</td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.Language))
                            {
                                <tr>
                                    <th>Language:</th>
                                    <td>@Model.Language</td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.Country))
                            {
                                <tr>
                                    <th>Country:</th>
                                    <td>@Model.Country</td>
                                </tr>
                            }
                            @if (Model.Rating.HasValue)
                            {
                                <tr>
                                    <th>Rating:</th>
                                    <td>
                                        <span class="rating-stars">
                                            @{
                                                // Convert rating from 0-10 scale to 0-5 scale for stars
                                                var starRating = (double)Model.Rating.Value / 2;
                                            }
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= starRating)
                                                {
                                                    <i class="fas fa-star text-warning"></i>
                                                }
                                                else if (i - 0.5 <= starRating)
                                                {
                                                    <i class="fas fa-star-half-alt text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star text-warning"></i>
                                                }
                                            }
                                            <span class="ms-2">(@Model.Rating.Value.ToString("F1")/10)</span>
                                        </span>
                                    </td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="stats-card">
                        <h3 class="section-subtitle">
                            <i class="fas fa-chart-bar me-2 text-info"></i>Stats
                        </h3>

                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-eye"></i>
                            </div>
                            <div class="stat-content">
                                <span class="stat-value">@Model.ViewsCount</span>
                                <span class="stat-label">Views</span>
                            </div>
                        </div>

                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-calendar-plus"></i>
                            </div>
                            <div class="stat-content">
                                <span class="stat-value">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                                <span class="stat-label">Added on</span>
                            </div>
                        </div>

                        @if (Model.IsFeatured)
                        {
                            <div class="featured-badge">
                                <i class="fas fa-crown me-2"></i> Featured Movie
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.TrailerUrl))
                    {
                        <div class="trailer-card mt-4">
                            <h3 class="section-subtitle">
                                <i class="fas fa-video me-2 text-danger"></i>Trailer
                            </h3>
                            <a href="@Model.TrailerUrl" target="_blank" class="btn-trailer">
                                <i class="fab fa-youtube me-2"></i> Watch Trailer
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Back Button -->
    <div class="container text-center mb-5">
        <a href="javascript:history.back()" class="btn-back">
            <i class="fas fa-arrow-left me-2"></i> Go Back
        </a>
    </div>
</div>

<!-- Enhanced CSS -->
<style>
    .movie-details-page {
        background: #0a0c0f;
        min-height: 100vh;
    }

    .movie-hero {
        min-height: 70vh;
        padding: 100px 0 50px;
        position: relative;
    }

    .min-vh-60 {
        min-height: 60vh;
    }

    .movie-poster-wrapper {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        transition: transform 0.3s ease;
    }

        .movie-poster-wrapper:hover {
            transform: scale(1.02);
        }

    .movie-poster {
        width: 100%;
        height: auto;
        transition: transform 0.3s ease;
    }

    .rating-badge {
        position: absolute;
        bottom: 20px;
        right: 20px;
        background: rgba(0,0,0,0.8);
        backdrop-filter: blur(5px);
        padding: 10px 20px;
        border-radius: 30px;
        color: #ffd700;
        font-weight: 600;
        border: 1px solid rgba(255,215,0,0.3);
    }

        .rating-badge i {
            margin-right: 8px;
        }

    .movie-info {
        padding: 20px;
    }

    .movie-title {
        font-size: 3.5rem;
        font-weight: 800;
        margin-bottom: 20px;
        background: linear-gradient(135deg, #fff, #ff4d4d);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .movie-meta {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 30px;
    }

    .meta-item {
        background: rgba(255,255,255,0.05);
        padding: 8px 20px;
        border-radius: 30px;
        font-size: 0.95rem;
        color: #e5e7eb;
    }

        .meta-item i {
            margin-right: 8px;
            color: #ff4d4d;
        }

    .movie-description {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #d1d5db;
        margin-bottom: 30px;
        max-width: 800px;
    }

    .movie-details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .detail-item {
        background: rgba(255,255,255,0.05);
        padding: 15px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.1);
        transition: all 0.3s ease;
    }

        .detail-item:hover {
            border-color: #ff4d4d;
            transform: translateY(-2px);
        }

    .detail-label {
        display: block;
        font-size: 0.85rem;
        color: #9ca3af;
        margin-bottom: 5px;
    }

    .detail-value {
        font-size: 1rem;
        color: white;
        font-weight: 500;
    }

    .watch-now-container {
        margin-top: 30px;
        padding: 20px;
        background: rgba(255,255,255,0.03);
        border-radius: 12px;
        border-left: 4px solid #ff4d4d;
    }

    .btn-watch-now {
        display: inline-flex;
        align-items: center;
        background: linear-gradient(135deg, #ff4d4d, #ff3333);
        color: white;
        border: none;
        padding: 15px 40px;
        border-radius: 50px;
        font-size: 1.2rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(255,77,77,0.3);
    }

        .btn-watch-now:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(255,77,77,0.5);
            color: white;
        }

    .details-section {
        background: #0f0f0f;
    }

    .details-card, .stats-card, .trailer-card {
        background: #1a1a1a;
        border-radius: 16px;
        padding: 30px;
        border: 1px solid rgba(255,255,255,0.05);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .section-subtitle {
        color: white;
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 25px;
        padding-bottom: 10px;
        border-bottom: 2px solid rgba(255,77,77,0.3);
    }

    .details-table {
        width: 100%;
        border-collapse: collapse;
    }

        .details-table tr {
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

            .details-table tr:last-child {
                border-bottom: none;
            }

        .details-table th {
            padding: 12px 15px 12px 0;
            color: #9ca3af;
            font-weight: 500;
            width: 120px;
        }

        .details-table td {
            padding: 12px 0;
            color: white;
        }

    .rating-stars i {
        margin-right: 2px;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

        .stat-item:last-child {
            border-bottom: none;
        }

    .stat-icon {
        width: 50px;
        height: 50px;
        background: rgba(255,77,77,0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #ff4d4d;
    }

    .stat-content {
        flex: 1;
    }

    .stat-value {
        display: block;
        font-size: 1.2rem;
        font-weight: 600;
        color: white;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #9ca3af;
    }

    .featured-badge {
        margin-top: 20px;
        padding: 15px;
        background: linear-gradient(135deg, rgba(255,215,0,0.1), rgba(255,165,0,0.1));
        border: 1px solid rgba(255,215,0,0.3);
        border-radius: 8px;
        color: #ffd700;
        text-align: center;
        font-weight: 600;
    }

    .btn-trailer {
        display: inline-flex;
        align-items: center;
        background: #ff0000;
        color: white;
        padding: 12px 25px;
        border-radius: 30px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-trailer:hover {
            background: #cc0000;
            transform: translateY(-2px);
            color: white;
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        background: transparent;
        color: white;
        padding: 12px 30px;
        border-radius: 30px;
        text-decoration: none;
        font-weight: 600;
        border: 2px solid rgba(255,255,255,0.1);
        transition: all 0.3s ease;
    }

        .btn-back:hover {
            border-color: #ff4d4d;
            background: rgba(255,77,77,0.1);
            transform: translateX(-5px);
            color: white;
        }

    .alert-warning {
        background: rgba(255,193,7,0.1);
        color: #ffc107;
        border-left: 4px solid #ffc107;
        padding: 15px 20px;
        border-radius: 8px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .movie-title {
            font-size: 2.5rem;
        }

        .movie-details-grid {
            grid-template-columns: 1fr;
        }

        .btn-watch-now {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 576px) {
        .movie-title {
            font-size: 2rem;
        }

        .movie-meta {
            gap: 10px;
        }

        .meta-item {
            padding: 5px 15px;
            font-size: 0.85rem;
        }

        .details-table th {
            display: block;
            width: 100%;
            padding-bottom: 5px;
        }

        .details-table td {
            display: block;
            width: 100%;
            padding-top: 0;
            padding-bottom: 15px;
        }
    }
</style>