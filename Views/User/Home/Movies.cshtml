        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .movie-info {
        padding: 15px;
    }

    .movie-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: white;
        margin-bottom: 6px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .movie-meta {
        color: var(--text-gray);
        font-size: 0.85rem;
        margin-bottom: 15px;
    }

    .genre-text {
        color: var(--netflix-red);
        font-weight: 600;
    }

    /* Actions */
    .card-actions {
        display: flex;
