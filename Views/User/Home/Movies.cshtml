@model IEnumerable<MovieMania.Models.Movie>

@{
    ViewData["Title"] = "Movies";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@* Anti-Forgery Token for AJAX calls *@
@Html.AntiForgeryToken()

<div class="browse-header">
    <div class="container-fluid px-4">
        <h1 class="page-title">Movies</h1>
        <p class="page-subtitle">Explore our collection of thousands of movies</p>

        <div class="filter-bar">
            <form method="get" class="filter-form">
                <div class="filter-group">
                    <label>Genre</label>
                    <select name="genre" class="filter-select">
                        <option value="All">All Genres</option>
                        @if (ViewBag.Genres != null)
                        {
                            foreach (var genre in ViewBag.Genres as List<string>)
                            {
                                <option value="@genre" selected="@(genre == ViewBag.CurrentGenre)">@genre</option>
                            }
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label>Sort By</label>
                    <select name="sortBy" class="filter-select">
                        <option value="latest" selected="@(ViewBag.CurrentSort == "latest")">Latest First</option>
                        <option value="rating" selected="@(ViewBag.CurrentSort == "rating")">Top Rated</option>
                        <option value="views" selected="@(ViewBag.CurrentSort == "views")">Most Viewed</option>
                    </select>
                </div>

                <button type="submit" class="filter-btn">Apply Filters</button>
            </form>
        </div>

        <div class="results-count">
            Showing @Model.Count() of @(ViewBag.TotalItems ?? 0) movies
        </div>
    </div>
</div>

<div class="container-fluid px-4 py-4">
    <div class="movies-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var movie in Model)
            {
                <div class="movie-card" onclick="location.href='/User/Home/MovieDetails/@movie.Id'">
                    <div class="movie-poster">
                        <img src="@(string.IsNullOrEmpty(movie.ThumbnailUrl) ? "/images/default-movie.jpg" : movie.ThumbnailUrl)" alt="@movie.Title">

                        @if (movie.Rating > 0)
                        {
                            <div class="movie-rating">
                                <i class="fas fa-star"></i>
                                <span>@movie.Rating?.ToString("0.0")</span>
                            </div>
                        }

                        @if (movie.IsFeatured)
                        {
                            <div class="featured-badge">Featured</div>
                        }
                    </div>
                    <div class="movie-info">
                        <h4 class="movie-title">@movie.Title</h4>
                        <p class="movie-meta">
                            <span class="genre-text">@(movie.Genre ?? "General")</span> •
                            <span>@(movie.ReleaseYear?.ToString() ?? "2026")</span>
                        </p>
                        <div class="card-actions">
                            <button class="watch-btn">
                                <i class="fas fa-play me-1"></i> Watch Now
                            </button>
                            @* Updated button with data-id and dynamic class *@
                            <button class="wishlist-icon-btn"
                                    id="wishlist-btn-@movie.Id"
                                    onclick="event.stopPropagation(); addToWishlist(@movie.Id)">
                                <i class="far fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-film"></i>
                <h3>No movies found</h3>
                <p>Try adjusting your filters or search criteria.</p>
                <a href="@Url.Action("Movies")" class="btn btn-outline-danger mt-3">Clear All Filters</a>
            </div>
        }
    </div>

    @if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 1)
    {
        <nav class="pagination-nav">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Movies", new { page = i, genre = ViewBag.CurrentGenre, sortBy = ViewBag.CurrentSort })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<style>
    :root {
        --netflix-red: #e50914;
        --dark-bg: #141414;
        --card-bg: #1a1a1a;
        --text-gray: #b3b3b3;
    }

    /* Header & Layout */
    .browse-header {
        background: linear-gradient(180deg, #000 0%, var(--dark-bg) 100%);
        padding: 60px 0 30px;
        border-bottom: 1px solid #333;
    }

    .page-title {
        font-size: 2.8rem;
        font-weight: 800;
        color: white;
        margin-bottom: 8px;
    }

    .page-subtitle {
        color: var(--text-gray);
        font-size: 1.2rem;
        margin-bottom: 35px;
    }

    /* Filters */
    .filter-bar {
        background: #1f1f1f;
        border-radius: 12px;
        padding: 25px;
        border: 1px solid #333;
    }

    .filter-form {
        display: flex;
        gap: 20px;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .filter-group {
        flex: 1;
        min-width: 200px;
    }

        .filter-group label {
            color: var(--text-gray);
            font-size: 0.85rem;
            margin-bottom: 8px;
            font-weight: 600;
            text-transform: uppercase;
            display: block;
        }

    .filter-select {
        width: 100%;
        padding: 12px;
        background: #2a2a2a;
        border: 1px solid #444;
        color: white;
        border-radius: 6px;
        outline: none;
    }

        .filter-select:focus {
            border-color: var(--netflix-red);
        }

    .filter-btn {
        background: var(--netflix-red);
        color: white;
        border: none;
        padding: 12px 35px;
        border-radius: 6px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.3s;
    }

        .filter-btn:hover {
            background: #ff0a16;
            transform: scale(1.02);
        }

    /* Grid & Cards */
    .movies-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 25px;
    }

    .movie-card {
        background: var(--card-bg);
        border-radius: 10px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid #222;
        position: relative;
    }

        .movie-card:hover {
            transform: translateY(-12px);
            border-color: #444;
            box-shadow: 0 15px 30px rgba(0,0,0,0.5);
        }

    .movie-poster {
        position: relative;
        aspect-ratio: 2/3;
        overflow: hidden;
    }

        .movie-poster img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .movie-card:hover .movie-poster img {
        transform: scale(1.1);
    }

    /* Badges & Info */
    .movie-rating {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(0,0,0,0.85);
        padding: 5px 12px;
        border-radius: 20px;
        color: #ffd700;
        font-size: 0.85rem;
        font-weight: 700;
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .featured-badge {
        position: absolute;
        top: 12px;
