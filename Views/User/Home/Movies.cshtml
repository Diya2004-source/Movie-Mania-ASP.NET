        }

        .wishlist-icon-btn.active {
            color: var(--netflix-red);
            border-color: var(--netflix-red);
        }

    /* Pagination */
    .pagination-nav {
        margin-top: 50px;
    }

    .page-link {
        background: #1f1f1f;
