        border: 1px dashed #444;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function addToWishlist(movieId) {
            // Get Anti-Forgery Token
            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '/User/Wishlist/Add',
                type: 'POST',
                data: {
                    movieId: movieId,
                    __RequestVerificationToken: token
                },
                success: function (data) {
                    if (data.success) {
                        // Success Toast
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: 'Added to Wishlist',
                            showConfirmButton: false,
                            timer: 2500,
                            timerProgressBar: true,
                            background: '#1f1f1f',
                            color: '#fff',
                            iconColor: '#e50914'
                        });

                        // Visual change for the heart icon
                        var btn = $('#wishlist-btn-' + movieId);
                        btn.find('i').removeClass('far').addClass('fas');
                        btn.addClass('active');

                        // Update navbar count if element exists
                        $('#wishlist-count-badge').text(data.count);

                    } else {
                        // Already added or error info
                        Swal.fire({
                            icon: 'info',
                            title: 'Wishlist',
                            text: data.message,
                            background: '#1f1f1f',
                            color: '#fff',
                            confirmButtonColor: '#e50914'
                        });
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 401) {
                         Swal.fire('Please Login', 'You need to be logged in to use the wishlist.', 'warning');
                    } else {
                         Swal.fire('Oops...', 'Something went wrong!', 'error');
                    }
                }
            });
        }
    </script>
}
