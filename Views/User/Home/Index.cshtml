<!-- Views/User/Home/Index.cshtml -->
@model UserDashboardViewModel

@{
    ViewData["Title"] = "MOVIE MANIA";
    Layout = "_UserLayout";
}

<!-- Hero Section - Featured Movie -->
<section class="hero-section position-relative">
    <div class="hero-backdrop" style="background-image: url('https://image.tmdb.org/t/p/original/featured-movie-bg.jpg');">
        <div class="container hero-content">
            <div class="row">
                <div class="col-lg-8">
                    <div class="badge-group mb-3">
                        <span class="premium-badge">PREMIUM</span>
                        <span class="rating-badge">
                            <i class="fas fa-star text-warning"></i> 9.8 Rating
                        </span>
                    </div>

                    <h1 class="hero-title">INTERSTELLAR DREAMS</h1>

                    <div class="movie-meta mb-3">
                        <span class="meta-item">2024</span>
                        <span class="meta-item">Sci-Fi, Adventure</span>
                        <span class="meta-item">2h 15m</span>
                        <span class="meta-item">4K ULTRA HD</span>
                    </div>

                    <p class="hero-description">
                        In a distant future where memories are a tradable commodity, a daring explorer
                        must navigate the neon-lit corridors of a forgotten space colony to recover a
                        lost dream that could rewrite human history. Every shadow hides a secret, and
                        every light pulse reveals a path to salvation or destruction.
                    </p>

                    <div class="hero-actions">
                        <a href="#" class="btn btn-danger btn-lg me-3">
                            <i class="fas fa-play"></i> Watch Now
                        </a>
                        <button class="btn btn-outline-light btn-lg add-wishlist" data-movieid="1">
                            <i class="fas fa-heart"></i> Wishlist
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Top Cast Section -->
<section class="cast-section py-5">
    <div class="container">
        <div class="section-header d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title">TOP CAST</h2>
            <a href="#" class="view-all">View all <i class="fas fa-arrow-right"></i></a>
        </div>

        <div class="row cast-grid">
            <div class="col-lg-2 col-md-3 col-6 mb-3">
                <div class="cast-card">
                    <div class="cast-image">
                        <img src="https://via.placeholder.com/150x150" alt="Alex Rivers">
                    </div>
                    <div class="cast-info">
                        <h6>Alex Rivers</h6>
                        <small>AS JAX KAELEN</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-3 col-6 mb-3">
