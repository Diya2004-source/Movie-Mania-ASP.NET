</style>

@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true,
            offset: 100
        });

        function toggleWishlist(itemId, type) {
            $.post('@Url.Action("ToggleWishlist", "Wishlist", new { area = "User" })',
                { itemId: itemId, itemType: type })
                .done(function(response) {
                    if (response.success) {
                        toastr.success(response.message);
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        toastr.error(response.message);
                    }
                })
                .fail(function() {
                    toastr.error('Error updating wishlist');
                });
        }

        function removeFromWishlist(wishlistId) {
            if (confirm('Remove from wishlist?')) {
                $.post('@Url.Action("Remove", "Wishlist", new { area = "User" })',
                    { id: wishlistId })
                    .done(function(response) {
                        if (response.success) {
                            toastr.success('Removed from wishlist');
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            toastr.error('Error removing item');
                        }
                    });
            }
        }
    </script>
}