@model dynamic
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    // Get the list of IDs already in wishlist to show active states
    var wishlistIds = ViewBag.WishlistIds as List<int> ?? new List<int>();
}

<style>
    :root {
        --netflix-red: #E50914;
        --bg-dark: #141414;
        --card-bg: #181818;
        --transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .dashboard-wrapper {
        background-color: var(--bg-dark);
        color: white;
        min-height: 100vh;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }

    /* Hero Banner */
    .netflix-hero {
        height: 70vh;
        position: relative;
        background: linear-gradient(to right, rgba(0,0,0,0.9) 10%, rgba(0,0,0,0) 70%), url('https://images.unsplash.com/photo-1626814026160-2237a95fc5a0?q=80&w=2070') center/cover;
        display: flex;
        align-items: center;
        padding: 0 4%;
    }

    .hero-title {
        font-size: 3.5rem;
        font-weight: 800;
        margin-bottom: 1rem;
    }

    .hero-name {
        color: var(--netflix-red);
    }

    .btn-netflix-main {
        background: #fff;
        color: #000;
        padding: 12px 30px;
        border-radius: 4px;
        font-weight: bold;
        text-decoration: none;
    }

    .btn-netflix-sub {
        background: rgba(109, 109, 110, 0.7);
        color: #fff;
        padding: 12px 30px;
        border-radius: 4px;
        text-decoration: none;
        margin-left: 10px;
    }

    /* Netflix Rows */
    .netflix-row {
        margin-top: -60px;
        position: relative;
        z-index: 5;
        padding: 20px 4%;
    }

    .row-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .row-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #e5e5e5;
    }

    /* Movie/Show Cards */
    .movie-card {
        background: var(--card-bg);
        border-radius: 4px;
        overflow: hidden;
        transition: var(--transition);
        cursor: pointer;
        position: relative;
    }

        .movie-card:hover {
            transform: scale(1.1);
            z-index: 10;
            box-shadow: 0 10px 20px rgba(0,0,0,0.6);
        }

    .card-img {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        display: block;
    }

    /* Overlay with Heart */
    .card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(transparent 40%, rgba(0,0,0,0.9));
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 15px;
        opacity: 0;
        transition: 0.3s ease;
    }

    .movie-card:hover .card-overlay {
        opacity: 1;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .btn-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,0.5);
        background: rgba(30,30,30,0.7);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
        cursor: pointer;
    }

        .btn-circle:hover {
            border-color: white;
            transform: scale(1.1);
        }

    /* Heart Specific Styles */
    .btn-wishlist.active {
        color: var(--netflix-red);
        border-color: var(--netflix-red);
        background: rgba(229, 9, 20, 0.1);
    }

    .match-score {
        color: #46d369;
        font-weight: bold;
        font-size: 0.85rem;
        display: block;
        margin-bottom: 5px;
    }

    .card-title {
        font-size: 0.95rem;
        font-weight: 700;
        margin: 0;
        color: white;
    }

    /* Anime Grid Fallback */
    .anime-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 15px;
    }
</style>

<div class="dashboard-wrapper">
    <div class="netflix-hero">
        <div class="hero-content">
            <h1 class="hero-title">Welcome Back, <span class="hero-name">@ViewBag.UserName</span></h1>
            <p class="fs-4 mb-4">Stream the latest fintech trends and premium cinema.</p>
            <div class="hero-buttons">
                <a href="/User/Home/Movies" class="btn-netflix-main"><i class="fas fa-play me-2"></i> Browse</a>
                <a href="/User/Wishlist" class="btn-netflix-sub"><i class="fas fa-list me-2"></i> My List</a>
            </div>
        </div>
    </div>

    <div class="netflix-row">
        <div class="row-header">
            <h2 class="row-title">Trending Movies</h2>
            <a href="/User/Home/Movies" class="text-decoration-none text-muted">View All <i class="fas fa-chevron-right ms-1"></i></a>
        </div>
        <div class="movies-carousel owl-carousel">
            @if (ViewBag.Movies != null)
            {
                @foreach (var movie in ViewBag.Movies)
                {
                    bool isAdded = wishlistIds.Contains(movie.Id);
                    <div class="item">
                        <div class="movie-card" onclick="location.href='/User/Home/MovieDetails/@movie.Id'">
                            <img src="@(movie.ThumbnailUrl ?? "/images/default.jpg")" class="card-img">
                            <div class="card-overlay">
                                <span class="match-score">98% Match</span>
                                <div class="action-buttons">
                                    <button class="btn-circle" onclick="event.stopPropagation(); location.href='/User/Home/MovieDetails/@movie.Id'">
                                        <i class="fas fa-play"></i>
                                    </button>
                                    <button class="btn-circle btn-wishlist @(isAdded ? "active" : "")"
                                            onclick="event.stopPropagation(); handleWishlist(this, '@movie.Id', 'Movie')">
                                        <i class="@(isAdded ? "fas fa-heart" : "far fa-heart")"></i>
                                    </button>
                                </div>
                                <p class="card-title mt-2">@movie.Title</p>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="netflix-row">
        <div class="row-header">
            <h2 class="row-title">Top TV Series</h2>
        </div>
        <div class="shows-carousel owl-carousel">
            @if (ViewBag.Shows != null)
            {
                @foreach (var show in ViewBag.Shows)
                {
                    bool isAdded = wishlistIds.Contains(show.Id);
                    <div class="item">
                        <div class="movie-card" onclick="location.href='/User/Home/ShowDetails/@show.Id'">
                            <img src="@(show.ThumbnailUrl ?? "/images/default.jpg")" class="card-img">
                            <div class="card-overlay">
                                <div class="action-buttons">
                                    <button class="btn-circle btn-wishlist @(isAdded ? "active" : "")"
                                            onclick="event.stopPropagation(); handleWishlist(this, '@show.Id', 'Show')">
                                        <i class="@(isAdded ? "fas fa-heart" : "far fa-heart")"></i>
                                    </button>
                                </div>
                                <p class="card-title mt-2">@show.Title</p>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="netflix-row pb-5">
        <div class="row-header">
            <h2 class="row-title">Anime Spotlight</h2>
        </div>
        <div class="anime-grid">
            @if (ViewBag.Anime != null)
            {
                @foreach (var anime in ViewBag.Anime)
                {
                    bool isAdded = wishlistIds.Contains(anime.Id);
                    <div class="movie-card" onclick="location.href='/User/Home/MovieDetails/@anime.Id'">
                        <img src="@(anime.ThumbnailUrl ?? "/images/default.jpg")" class="card-img">
                        <div class="card-overlay">
                            <button class="btn-circle btn-wishlist @(isAdded ? "active" : "")"
                                    onclick="event.stopPropagation(); handleWishlist(this, '@anime.Id', 'Movie')">
                                <i class="@(isAdded ? "fas fa-heart" : "far fa-heart")"></i>
                            </button>
                            <p class="card-title mt-2">@anime.Title</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.movies-carousel, .shows-carousel').owlCarousel({
                margin: 15, loop: false, nav: false, dots: false,
                responsive: { 0: { items: 2 }, 600: { items: 3 }, 1000: { items: 6 } }
            });
        });

        function handleWishlist(btn, id, type) {
            const $btn = $(btn);
            const icon = $btn.find('i');

            $.ajax({
                url: '/User/Wishlist/Add',
                type: 'POST',
                data: { contentId: id, contentType: type },
                success: function (response) {
                    if (response.success) {
                        $btn.toggleClass('active');

                        if ($btn.hasClass('active')) {
                            icon.removeClass('far').addClass('fas');
                            Swal.fire({
                                toast: true, position: 'top-end', icon: 'success',
                                title: 'Added to your list', showConfirmButton: false, timer: 1500,
                                background: '#181818', color: '#fff'
                            });
                        } else {
                            icon.removeClass('fas').addClass('far');
                        }
                    }
                }
            });
        }
    </script>
}