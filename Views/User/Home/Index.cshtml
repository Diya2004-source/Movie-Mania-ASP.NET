﻿
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- Netflix-style Hero Banner -->
<div class="netflix-hero">
    <div class="hero-content">
        <h1 class="hero-title">Welcome Back, <span class="hero-name">@ViewBag.UserName</span></h1>
        <p class="hero-subtitle">Ready to continue your entertainment journey?</p>
        <div class="hero-buttons">
            <a href="/User/Home/Movies" class="btn-primary">
                <i class="fas fa-play me-2"></i>Continue Watching
            </a>
            <a href="/User/Wishlist" class="btn-secondary">
                <i class="fas fa-plus me-2"></i>My List
            </a>
        </div>
    </div>
    <div class="hero-overlay"></div>
</div>

<div class="dashboard-container">
    <div class="container-fluid px-4 py-4">
        <!-- All Movies Section with Netflix-style row -->
        <div class="netflix-row">
            <div class="row-header">
                <h2 class="row-title">Popular Movies</h2>
                <a href="/User/Home/Movies" class="row-link">Browse All <i class="fas fa-chevron-right"></i></a>
            </div>

            <div class="movies-carousel owl-carousel">
                @if (ViewBag.Movies != null && ViewBag.Movies.Count > 0)
                {
                    @foreach (var movie in ViewBag.Movies)
                    {
                        <div class="movie-item">
                            <div class="movie-card" onclick="location.href='/User/Home/MovieDetails/@movie.Id'">
                                <div class="movie-poster">
                                    <img src="@(movie.ThumbnailUrl ?? "/images/default-movie.jpg")" alt="@movie.Title">
                                    @if (movie.Rating != null && movie.Rating > 0)
                                    {
                                        <div class="movie-rating">
                                            <i class="fas fa-star"></i>
                                            <span>@movie.Rating.ToString("F1")</span>
                                        </div>
                                    }
                                    <div class="movie-overlay">
                                        <button class="play-btn" onclick="event.stopPropagation(); location.href='/User/Home/MovieDetails/@movie.Id'">
                                            <i class="fas fa-play"></i>
                                        </button>
                                        <button class="info-btn" onclick="event.stopPropagation(); location.href='/User/Home/MovieDetails/@movie.Id'">
                                            <i class="fas fa-info-circle"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="movie-info">
                                    <h4 class="movie-title">@movie.Title</h4>
                                    <p class="movie-meta">
                                        <span class="match">97% Match</span>
                                        <span class="year">@(movie.ReleaseYear?.ToString() ?? "2026")</span>
                                        <span class="quality">HD</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-message">No movies available</div>
                }
            </div>
        </div>

        <!-- TV Shows Section - ADD THIS SECTION HERE -->
        <div class="netflix-row">
            <div class="row-header">
                <h2 class="row-title">TV Shows</h2>
                <a href="/User/Home/Shows" class="row-link">Browse All <i class="fas fa-chevron-right"></i></a>
            </div>

            <div class="shows-carousel owl-carousel">
                @if (ViewBag.Shows != null && ViewBag.Shows.Count > 0)
                {
                    @foreach (var show in ViewBag.Shows)
                    {
                        <div class="show-item">
                            <div class="show-card" onclick="location.href='/User/Home/ShowDetails/@show.Id'">
                                <div class="show-poster">
                                    <img src="@(show.ThumbnailUrl ?? "/images/default-show.jpg")" alt="@show.Title">
                                    <div class="show-badge">
                                        <span class="badge">@(show.Genre ?? "Hotstar Specials")</span>
                                    </div>
                                    @if (show.Rating != null && show.Rating > 0)
                                    {
                                        <div class="show-rating-badge">
                                            <i class="fas fa-star"></i>
                                            <span>@show.Rating.ToString("F1")</span>
                                        </div>
                                    }
                                    <div class="show-overlay">
                                        <button class="play-btn" onclick="event.stopPropagation(); location.href='/User/Home/ShowDetails/@show.Id'">
                                            <i class="fas fa-play"></i>
                                        </button>
                                        <button class="info-btn" onclick="event.stopPropagation(); location.href='/User/Home/ShowDetails/@show.Id'">
                                            <i class="fas fa-info-circle"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="show-info">
                                    <h4 class="show-title">@show.Title</h4>
                                    <p class="show-meta">
                                        <!-- FIXED: Changed .Any() to .Count > 0 -->
                                        <span class="episodes">@(show.Episodes != null && show.Episodes.Count > 0 ? $"{show.Episodes.Count} Episodes" : "New Series")</span>
                                        <span class="year">@(show.ReleaseYear?.ToString() ?? "2026")</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-message">No TV shows available</div>
                }
            </div>
        </div>

        <!-- Anime Section -->
        <div class="netflix-row">
            <div class="row-header">
                <h2 class="row-title">Anime</h2>
                <a href="/User/Home/Anime" class="row-link">Browse All <i class="fas fa-chevron-right"></i></a>
            </div>

            @if (ViewBag.Anime != null && ViewBag.Anime.Count > 0)
            {
                <div class="anime-grid">
                    @foreach (var anime in ViewBag.Anime.Take(6))
                    {
                        <div class="anime-item">
                            <div class="anime-card" onclick="location.href='/User/Home/MovieDetails/@anime.Id'">
                                <div class="anime-poster">
                                    <img src="@(anime.ThumbnailUrl ?? "/images/default-movie.jpg")" alt="@anime.Title">
                                    @if (anime.Rating != null && anime.Rating > 0)
                                    {
                                        <div class="anime-rating-badge">
                                            <i class="fas fa-star"></i>
                                            <span>@anime.Rating.ToString("F1")</span>
                                        </div>
                                    }
                                    <div class="anime-overlay">
                                        <button class="play-btn" onclick="event.stopPropagation(); location.href='/User/Home/MovieDetails/@anime.Id'">
                                            <i class="fas fa-play"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="anime-info">
                                    <h4 class="anime-title">@anime.Title</h4>
                                    <p class="anime-meta">@(anime.Genre ?? "Anime") · @(anime.ReleaseYear?.ToString() ?? "2026")</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state-anime">
                    <i class="fas fa-dragon"></i>
                    <p>No anime available</p>
                </div>
            }
        </div>
    </div>
</div>

