@model MovieMania.ViewModels.UserDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_UserLayout";
}

<!-- Welcome Hero Section -->
<section class="welcome-hero position-relative overflow-hidden mb-5">
    <div class="hero-gradient"></div>
    <div class="container">
        <div class="row align-items-center min-vh-50">
            <div class="col-lg-8" data-aos="fade-right">
                <div class="welcome-content">
                    <span class="welcome-badge">
                        <i class="fas fa-crown me-2"></i>Welcome Back
                    </span>
                    <h1 class="welcome-title">
                        Hello, <span class="text-gradient">@Model.UserName</span>
                    </h1>
                    <p class="welcome-text">Ready to continue your entertainment journey?</p>

                    @if (Model.ActiveSubscription != null)
                    {
                        <div class="subscription-status">
                            <i class="fas fa-check-circle text-success"></i>
                            <span>Premium Active until @Model.ActiveSubscription.EndDate.ToString("MMM dd, yyyy")</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="col-lg-4" data-aos="fade-left">
                <div class="stats-grid">
                    <div class="stat-card">
                        <i class="fas fa-heart text-danger"></i>
                        <div class="stat-info">
                            <h3>@Model.TotalWishlistCount</h3>
                            <p>Wishlist</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <i class="fas fa-check-circle text-success"></i>
                        <div class="stat-info">
                            <h3>@Model.RecentlyWatchedCount</h3>
                            <p>Watched</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <i class="fas fa-clock text-warning"></i>
                        <div class="stat-info">
                            <h3>@Model.TotalWatchTimeMinutes</h3>
                            <p>Minutes</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Continue Watching Section -->
@if (Model.ContinueWatching != null && Model.ContinueWatching.Any())
{
    <section class="continue-section mb-5">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fas fa-play-circle text-success me-3"></i>Continue Watching
                </h2>
                <a href="@Url.Action("Movies", "Home")" class="view-all">
                    View All <i class="fas fa-arrow-right"></i>
                </a>
            </div>

            <div class="row g-4">
                @foreach (var item in Model.ContinueWatching.Take(6))
                {
                    <div class="col-lg-2 col-md-3 col-sm-4 col-6" data-aos="fade-up">
                        <div class="continue-card">
                            <div class="continue-poster">
                                @if (item.Movie != null)
                                {
                                    <img src="@(item.Movie.ThumbnailUrl ?? "/images/default-movie.jpg")"
                                         alt="@item.Movie.Title">
                                }
                                else if (item.Episode != null)
                                {
                                    <img src="@(item.Episode.ThumbnailUrl ?? item.Episode.Show?.ThumbnailUrl ?? "/images/default-show.jpg")"
                                         alt="@item.Episode.Title">
                                }

                                <div class="progress-ring">
                                    <svg class="progress-circle" width="50" height="50">
                                        <circle class="progress-bg" cx="25" cy="25" r="22" />
                                        <circle class="progress-bar" cx="25" cy="25" r="22"
                                                style="stroke-dasharray: 138.2;
                                                                       stroke-dashoffset: @(138.2 - (138.2 * item.ProgressPercentage / 100))" />
                                    </svg>
                                    <span class="progress-text">@item.ProgressPercentage%</span>
                                </div>

                                <div class="continue-overlay">
                                    <a href="@(item.Movie != null ? Url.Action("MovieDetails", new { id = item.Movie.Id }) : Url.Action("ShowDetails", new { id = item.Episode.ShowId }))"
                                       class="btn-resume">
                                        <i class="fas fa-play"></i> Resume
                                    </a>
                                </div>
                            </div>
                            <div class="continue-info">
                                <h6>@(item.Movie?.Title ?? item.Episode?.Title)</h6>
                                <small>@(item.Movie?.Genre ?? $"S{item.Episode?.SeasonNumber}E{item.Episode?.EpisodeNumber}")</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- All Movies Section -->
<section class="all-movies-section mb-5">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">
                <i class="fas fa-film text-primary me-3"></i>All Movies
            </h2>
            <a href="@Url.Action("Movies", "Home")" class="view-all">
                View All <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (Model.AllMovies != null && Model.AllMovies.Any())
            {
                @foreach (var movie in Model.AllMovies.Take(12))
                {
                    <div class="col-lg-2 col-md-3 col-sm-4 col-6" data-aos="fade-up">
                        <div class="movie-card">
                            <div class="movie-poster">
                                <img src="@(movie.ThumbnailUrl ?? "/images/default-movie.jpg")"
                                     alt="@movie.Title"
                                     loading="lazy">
                                <div class="movie-rating">
                                    <i class="fas fa-star"></i>
                                    <span>@(movie.Rating?.ToString("F1") ?? "N/A")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(movie.VideoUrl))
                                {
                                    <div class="watch-now-badge">
                                        <span class="badge bg-danger">Watch Now</span>
                                    </div>
                                }
                                <div class="movie-overlay">
                                    <a href="@Url.Action("MovieDetails", new { id = movie.Id })"
                                       class="btn-details">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    <button class="btn-wishlist" onclick="toggleWishlist(@movie.Id, 'movie')">
                                        <i class="fas fa-heart"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="movie-info">
                                <h6 class="movie-title">@movie.Title</h6>
                                <div class="movie-meta">
                                    <span class="genre">@movie.Genre</span>
                                    <span class="year">@movie.ReleaseYear</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-4">
                    <p class="text-muted">No movies available</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- All TV Shows Section -->
<section class="all-shows-section mb-5 bg-dark-gradient py-4">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">
                <i class="fas fa-tv text-info me-3"></i>TV Shows
            </h2>
            <a href="@Url.Action("Shows", "Home")" class="view-all">
                View All <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (Model.AllShows != null && Model.AllShows.Any())
            {
                @foreach (var show in Model.AllShows.Take(12))
                {
                    <div class="col-lg-2 col-md-3 col-sm-4 col-6" data-aos="fade-up">
                        <div class="show-card">
                            <div class="show-poster">
                                <img src="@(show.ThumbnailUrl ?? "/images/default-show.jpg")"
                                     alt="@show.Title"
                                     loading="lazy">
                                <div class="show-badge">
                                    <span class="badge-season">@show.TotalSeasons S</span>
                                </div>
                                <div class="show-overlay">
                                    <a href="@Url.Action("ShowDetails", new { id = show.Id })"
                                       class="btn-details">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                </div>
                            </div>
                            <div class="show-info">
                                <h6 class="show-title">@show.Title</h6>
                                <div class="show-meta">
                                    <span>@show.Genre</span>
                                    <span class="dot">•</span>
                                    <span>@show.ReleaseYear</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-4">
                    <p class="text-muted">No TV shows available</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Anime Section -->
<section class="anime-section mb-5">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">
                <i class="fas fa-dragon text-danger me-3"></i>Anime
            </h2>
            <a href="@Url.Action("Anime", "Home")" class="view-all">
                View All <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (Model.AnimeShows != null && Model.AnimeShows.Any())
            {
                @foreach (var anime in Model.AnimeShows.Take(12))
                {
                    <div class="col-lg-2 col-md-3 col-sm-4 col-6" data-aos="fade-up">
                        <div class="show-card">
                            <div class="show-poster">
                                <img src="@(anime.ThumbnailUrl ?? "/images/default-anime.jpg")"
                                     alt="@anime.Title"
                                     loading="lazy">
                                <div class="show-badge">
                                    <span class="badge-season">@anime.TotalSeasons S</span>
                                </div>
                                <div class="show-overlay">
                                    <a href="@Url.Action("ShowDetails", new { id = anime.Id })"
                                       class="btn-details">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                </div>
                            </div>
                            <div class="show-info">
                                <h6 class="show-title">@anime.Title</h6>
                                <div class="show-meta">
                                    <span>@anime.Genre</span>
                                    <span class="dot">•</span>
                                    <span>@anime.ReleaseYear</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-4">
                    <p class="text-muted">No anime available</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Wishlist Preview -->
@if (Model.UserWishlist != null && Model.UserWishlist.Any())
{
    <section class="wishlist-section mb-5">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fas fa-heart text-danger me-3"></i>My Wishlist
                </h2>
                <a asp-area="User" asp-controller="Wishlist" asp-action="Index" class="view-all">
                    View All <i class="fas fa-arrow-right"></i>
                </a>
            </div>

            <div class="row g-4">
                @foreach (var item in Model.UserWishlist.Take(8))
                {
                    <div class="col-lg-2 col-md-3 col-sm-4 col-6" data-aos="fade-up">
                        @if (item.Movie != null)
                        {
                            <div class="wishlist-card">
                                <div class="wishlist-poster">
                                    <img src="@(item.Movie.ThumbnailUrl ?? "/images/default-movie.jpg")"
                                         alt="@item.Movie.Title">
                                    <button class="btn-remove" onclick="removeFromWishlist(@item.Id)">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                <div class="wishlist-info">
                                    <h6>@item.Movie.Title</h6>
                                    <small>@item.Movie.Genre</small>
                                </div>
                            </div>
                        }
                        else if (item.Show != null)
                        {
                            <div class="wishlist-card">
                                <div class="wishlist-poster">
                                    <img src="@(item.Show.ThumbnailUrl ?? "/images/default-show.jpg")"
                                         alt="@item.Show.Title">
                                    <button class="btn-remove" onclick="removeFromWishlist(@item.Id)">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                <div class="wishlist-info">
                                    <h6>@item.Show.Title</h6>
                                    <small>@item.Show.Genre</small>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

<style>
    /* Welcome Hero */
    .welcome-hero {
        background: linear-gradient(135deg, #0a0c0f 0%, #1a1a1a 100%);
        padding: 40px 0;
        border-radius: 0 0 50px 50px;
        position: relative;
    }

        .welcome-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" opacity="0.1"><circle cx="50" cy="50" r="40" fill="none" stroke="%23ff4d4d" stroke-width="2"/></svg>') repeat;
            animation: rotate 60s linear infinite;
        }

    .hero-gradient {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100px;
        background: linear-gradient(to top, #0a0c0f, transparent);
    }

    .min-vh-50 {
        min-height: 50vh;
    }

    .welcome-badge {
        background: rgba(255,77,77,0.2);
        color: #ff4d4d;
        padding: 8px 20px;
        border-radius: 30px;
        font-size: 0.9rem;
        font-weight: 600;
        display: inline-block;
        margin-bottom: 20px;
        border: 1px solid rgba(255,77,77,0.3);
    }

    .welcome-title {
        font-size: 3.5rem;
        font-weight: 800;
        margin-bottom: 15px;
        color: white;
    }

    .text-gradient {
        background: linear-gradient(135deg, #ff4d4d, #ff8c5a);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .welcome-text {
        font-size: 1.2rem;
        color: #9ca3af;
        margin-bottom: 20px;
    }

    .subscription-status {
        background: rgba(0,200,83,0.1);
        border: 1px solid rgba(0,200,83,0.3);
        border-radius: 12px;
        padding: 15px 20px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

        .subscription-status i {
            font-size: 1.2rem;
        }

        .subscription-status span {
            color: #00c853;
            font-weight: 600;
        }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
    }

    .stat-card {
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        border: 1px solid rgba(255,255,255,0.1);
        transition: all 0.3s ease;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: #ff4d4d;
            box-shadow: 0 10px 30px rgba(255,77,77,0.2);
        }

        .stat-card i {
            font-size: 2rem;
            margin-bottom: 10px;
        }

    .stat-info h3 {
        font-size: 1.8rem;
        font-weight: 700;
        margin: 0;
        color: white;
    }

    .stat-info p {
        color: #9ca3af;
        margin: 5px 0 0;
        font-size: 0.9rem;
    }

    /* Section Header */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .section-title {
        font-size: 2rem;
        font-weight: 700;
        color: white;
        display: flex;
        align-items: center;
    }

    .view-all {
        color: #9ca3af;
        text-decoration: none;
        padding: 8px 20px;
        border-radius: 30px;
        background: rgba(255,255,255,0.05);
        transition: all 0.3s ease;
    }

        .view-all:hover {
            color: #ff4d4d;
            background: rgba(255,77,77,0.1);
            transform: translateX(5px);
        }

    /* Continue Watching Card */
    .continue-card {
        background: #1a1a1a;
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s ease;
        height: 100%;
    }

        .continue-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(255,77,77,0.2);
        }

    .continue-poster {
        position: relative;
        aspect-ratio: 16/9;
        overflow: hidden;
    }

        .continue-poster img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .continue-card:hover .continue-poster img {
        transform: scale(1.1);
    }

    .progress-ring {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 50px;
        height: 50px;
    }

    .progress-circle {
        transform: rotate(-90deg);
    }

    .progress-bg {
        fill: none;
        stroke: rgba(255,255,255,0.2);
        stroke-width: 3;
    }

    .progress-bar {
        fill: none;
        stroke: #ff4d4d;
        stroke-width: 3;
        stroke-linecap: round;
        transition: stroke-dashoffset 0.3s;
    }

    .progress-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 0.7rem;
        font-weight: 600;
        color: white;
    }

    .continue-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .continue-card:hover .continue-overlay {
        opacity: 1;
    }

    .btn-resume {
        background: linear-gradient(135deg, #ff4d4d, #ff3333);
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transform: translateY(20px);
        transition: all 0.3s ease;
    }

    .continue-card:hover .btn-resume {
        transform: translateY(0);
    }

    .btn-resume:hover {
        transform: translateY(-2px) !important;
        box-shadow: 0 5px 15px rgba(255,77,77,0.3);
    }

    .continue-info {
        padding: 15px;
    }

        .continue-info h6 {
            color: white;
            margin: 0 0 5px 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .continue-info small {
            color: #9ca3af;
        }

    /* Movie Card */
    .movie-card {
        background: #1a1a1a;
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s ease;
        height: 100%;
    }

        .movie-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(255,77,77,0.2);
        }

    .movie-poster {
        position: relative;
        aspect-ratio: 2/3;
        overflow: hidden;
    }

        .movie-poster img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .movie-card:hover .movie-poster img {
        transform: scale(1.1);
    }

    .movie-rating {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(0,0,0,0.8);
        backdrop-filter: blur(5px);
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        color: #ffd700;
        z-index: 2;
    }

    .watch-now-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 2;
    }

        .watch-now-badge .badge {
            background: linear-gradient(135deg, #ff4d4d, #ff3333);
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(255,77,77,0.3);
        }

    .movie-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .movie-card:hover .movie-overlay {
        opacity: 1;
    }

    .btn-details {
        background: #ff4d4d;
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.3s ease;
        transform: scale(0);
    }

    .movie-card:hover .btn-details {
        transform: scale(1);
    }

    .btn-details:hover {
        background: #ff3333;
        transform: scale(1.1) !important;
    }

    .btn-wishlist {
        background: rgba(255,255,255,0.2);
        color: white;
        border: none;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        transform: scale(0);
    }

    .movie-card:hover .btn-wishlist {
        transform: scale(1);
    }

    .btn-wishlist:hover {
        background: #ff4d4d;
        transform: scale(1.1) !important;
    }

    .movie-info {
        padding: 15px;
    }

    .movie-title {
        color: white;
        font-size: 0.9rem;
        font-weight: 600;
        margin: 0 0 5px 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .movie-meta {
        display: flex;
        gap: 8px;
        font-size: 0.8rem;
        color: #9ca3af;
    }

        .movie-meta .genre {
            color: #ff4d4d;
        }

    /* Trending Card */
    .bg-dark-gradient {
        background: linear-gradient(135deg, #0a0c0f 0%, #1a1a1a 100%);
        padding: 40px 0;
        position: relative;
        overflow: hidden;
    }

        .bg-dark-gradient::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(255,77,77,0.1) 0%, transparent 70%);
            animation: rotate 20s linear infinite;
        }

    .trending-card {
        background: #1a1a1a;
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s ease;
        height: 100%;
    }

        .trending-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(255,77,77,0.2);
        }

    .trending-poster {
        position: relative;
        aspect-ratio: 2/3;
        overflow: hidden;
    }

        .trending-poster img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .trending-card:hover .trending-poster img {
        transform: scale(1.1);
    }

    .trending-rank {
        position: absolute;
        top: 10px;
