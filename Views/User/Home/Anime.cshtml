@{
    ViewData["Title"] = "Anime";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="browse-header">
    <div class="container-fluid px-4">
        <h1 class="page-title">Anime</h1>
        <p class="page-subtitle">Discover the best Japanese animation</p>

        <div class="filter-bar">
            <form method="get" class="filter-form">
                <div class="filter-group">
                    <label>Sort By</label>
                    <select name="sortBy" class="filter-select">
                        <option value="latest" selected="@(ViewBag.CurrentSort == "latest")">Latest First</option>
                        <option value="rating" selected="@(ViewBag.CurrentSort == "rating")">Top Rated</option>
                        <option value="views" selected="@(ViewBag.CurrentSort == "views")">Most Viewed</option>
                    </select>
                </div>

                <button type="submit" class="filter-btn">Apply Filters</button>
            </form>
        </div>

        <div class="results-count">
            Showing @Model.Count() of @ViewBag.TotalItems anime
        </div>
    </div>
</div>

<div class="container-fluid px-4 py-4">
    <div class="anime-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var anime in Model)
            {
                <div class="anime-card" onclick="location.href='/User/Home/MovieDetails/@anime.Id'">
                    <div class="anime-poster">
                        <img src="@(anime.ThumbnailUrl ?? "/images/default-movie.jpg")" alt="@anime.Title">
                        @if (anime.Rating > 0)
                        {
                            <div class="anime-rating">
                                <i class="fas fa-star"></i>
                                <span>@string.Format("{0:F1}", anime.Rating)</span>
                            </div>
                        }
                        @if (anime.ReleaseYear.HasValue)
                        {
                            <div class="anime-year">
                                @anime.ReleaseYear.Value
                            </div>
                        }
                    </div>
                    <div class="anime-info">
                        <h4 class="anime-title">@anime.Title</h4>
                        <p class="anime-meta">@(anime.Genre ?? "Anime")</p>
                        @if (anime.Duration.HasValue)
                        {
                            <p class="anime-duration">@(anime.Duration.Value) min</p>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-dragon"></i>
                <h3>No anime found</h3>
                <p>Check back later for new releases</p>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 1)
    {
        <nav class="pagination-nav">
            <ul class="pagination">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Anime", new { page = i, sortBy = ViewBag.CurrentSort })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

