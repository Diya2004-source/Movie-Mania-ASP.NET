@model IEnumerable<MovieMania.Models.Movie>

@{
    ViewData["Title"] = "Anime";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@* Anti-Forgery Token for AJAX calls *@
@Html.AntiForgeryToken()

<div class="browse-header">
    <div class="container-fluid px-4">
        <h1 class="page-title">Anime</h1>
        <p class="page-subtitle">Discover the best Japanese animation and series</p>

        <div class="filter-bar">
            <form method="get" asp-action="Anime" class="filter-form">
                <div class="filter-group">
                    <label>Search</label>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch"
                           placeholder="Search anime..." class="filter-select" />
                </div>

                <div class="filter-group">
                    <label>Sort By</label>
                    <select name="sortBy" class="filter-select">
                        <option value="latest" selected="@(ViewBag.CurrentSort == "latest")">Latest First</option>
                        <option value="rating" selected="@(ViewBag.CurrentSort == "rating")">Top Rated</option>
                        <option value="views" selected="@(ViewBag.CurrentSort == "views")">Most Viewed</option>
                    </select>
                </div>

                <button type="submit" class="filter-btn">Apply Filters</button>
            </form>
        </div>

        <div class="results-count mt-3">
            Showing @Model.Count() of @(ViewBag.TotalItems ?? 0) anime
        </div>
    </div>
</div>

<div class="container-fluid px-4 py-4">
    <div class="anime-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var anime in Model)
            {
                <div class="anime-card" onclick="location.href='/User/Home/MovieDetails/@anime.Id'">
                    <div class="anime-poster">
                        <img src="@(string.IsNullOrEmpty(anime.ThumbnailUrl) ? "/images/default-movie.jpg" : anime.ThumbnailUrl)" alt="@anime.Title">

                        @if (anime.Rating > 0)
                        {
                            <div class="anime-rating">
                                <i class="fas fa-star"></i>
                                <span>@anime.Rating?.ToString("0.0")</span>
                            </div>
                        }

                        <div class="anime-duration-badge">
                            @(anime.Duration?.ToString() ?? "N/A") min
                        </div>
                    </div>
                    <div class="anime-info">
                        <h4 class="anime-title">@anime.Title</h4>
                        <p class="anime-meta">
                            <span class="genre-text">@(anime.Genre ?? "Anime")</span> •
                            <span>@(anime.ReleaseYear?.ToString() ?? "2026")</span>
                        </p>
                        <div class="card-actions">
                            <button class="watch-btn">
                                <i class="fas fa-play me-1"></i> Watch
                            </button>
                            <button class="wishlist-icon-btn"
                                    id="wishlist-btn-@anime.Id"
                                    onclick="event.stopPropagation(); toggleWishlist(@anime.Id)">
                                <i class="far fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-dragon"></i>
                <h3>No anime found</h3>
                <p>Try adjusting your filters or search criteria.</p>
                <a href="@Url.Action("Anime")" class="btn btn-outline-danger mt-3">Clear All Filters</a>
            </div>
        }
    </div>

    @if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 1)
    {
        <nav class="pagination-nav">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Anime", new { page = i, searchString = ViewBag.CurrentSearch, sortBy = ViewBag.CurrentSort })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<style>
