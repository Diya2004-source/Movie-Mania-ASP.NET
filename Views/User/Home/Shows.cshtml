@model IEnumerable<MovieMania.Models.Show>

@{
    ViewData["Title"] = "TV Shows";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@* Anti-Forgery Token for AJAX calls *@
@Html.AntiForgeryToken()

<div class="browse-header">
    <div class="container-fluid px-4">
        <h1 class="page-title">TV Shows</h1>
        <p class="page-subtitle">Explore thousands of TV series, anime, and more</p>

        <div class="filter-bar">
            <form method="get" class="filter-form">
                <div class="filter-group">
                    <label>Genre</label>
                    <select name="genre" class="filter-select">
                        <option value="All">All Genres</option>
                        @if (ViewBag.Genres != null)
                        {
                            foreach (var genre in ViewBag.Genres as List<string>)
                            {
                                <option value="@genre" selected="@(genre == ViewBag.CurrentGenre)">@genre</option>
                            }
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label>Sort By</label>
                    <select name="sortBy" class="filter-select">
                        <option value="latest" selected="@(ViewBag.CurrentSort == "latest")">Latest First</option>
                        <option value="rating" selected="@(ViewBag.CurrentSort == "rating")">Top Rated</option>
                        <option value="views" selected="@(ViewBag.CurrentSort == "views")">Most Viewed</option>
                    </select>
                </div>

                <button type="submit" class="filter-btn">Apply Filters</button>
            </form>
        </div>

        <div class="results-count">
            Showing @Model.Count() of @(ViewBag.TotalItems ?? 0) shows
        </div>
    </div>
</div>

<div class="container-fluid px-4 py-4">
    <div class="shows-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var show in Model)
            {
                // Check if this specific show is in the user's wishlist (passed from controller)
                bool isInWishlist = ViewBag.WishlistIds != null && ((List<int>)ViewBag.WishlistIds).Contains(show.Id);

                <div class="show-card" onclick="location.href='/User/Home/ShowDetails/@show.Id'">
                    <div class="show-poster">
                        <img src="@(string.IsNullOrEmpty(show.ThumbnailUrl) ? "/images/default-show.jpg" : show.ThumbnailUrl)" alt="@show.Title">

                        @if (show.Rating > 0)
                        {
                            <div class="show-rating">
                                <i class="fas fa-star"></i>
                                <span>@show.Rating?.ToString("0.0")</span>
                            </div>
                        }

                        <div class="episode-badge">
                            @(show.Episodes?.Count ?? 0) Episodes
                        </div>
                    </div>
                    <div class="show-info">
                        <h4 class="show-title">@show.Title</h4>
                        <p class="show-meta">
                            <span class="genre-text">@(show.Genre ?? "Series")</span> •
                            <span>@(show.ReleaseYear?.ToString() ?? "2026")</span>
                        </p>
                        <div class="card-actions">
                            <button class="watch-btn">
                                <i class="fas fa-play me-1"></i> Watch
                            </button>

                            @* Wishlist toggle button updated with dynamic classes *@
                            <button class="wishlist-icon-btn @(isInWishlist ? "active" : "")"
                                    id="wishlist-btn-@show.Id"
                                    onclick="event.stopPropagation(); toggleWishlist(@show.Id)">
                                <i class="@(isInWishlist ? "fas" : "far") fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-tv"></i>
                <h3>No shows found</h3>
                <p>Try adjusting your filters or search criteria.</p>
                <a href="@Url.Action("Shows")" class="btn btn-outline-danger mt-3">Clear All Filters</a>
            </div>
        }
    </div>

    @if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 1)
    {
        <nav class="pagination-nav">
            <ul class="pagination justify-content-center mt-5">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Shows", new { page = i, genre = ViewBag.CurrentGenre, sortBy = ViewBag.CurrentSort })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<style>
