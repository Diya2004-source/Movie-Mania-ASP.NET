@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function toggleWishlist(showId) {
            // Anti-Forgery Token
            var token = $('input[name="__RequestVerificationToken"]').val();
            var $btn = $('#wishlist-btn-' + showId);
            var $icon = $btn.find('i');

            $.ajax({
                url: '/User/Wishlist/Add',
                type: 'POST',
                data: {
                    // Updated keys to match your WishlistController.Add parameters
                    showId: showId,
                    priority: 1,
                    __RequestVerificationToken: token
                },
                success: function (data) {
                    if (data.success) {
                        $btn.toggleClass('active');

                        // Handle icon toggle
                        if ($btn.hasClass('active')) {
                            $icon.removeClass('far').addClass('fas');
                        } else {
                            $icon.removeClass('fas').addClass('far');
                        }

                        // Use the message from your controller in the toast
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: data.message || 'Updated Watchlist',
                            showConfirmButton: false,
                            timer: 2000,
                            background: '#1a1a1a',
                            color: '#fff'
                        });

                        if(data.count !== undefined) {
                            $('.wishlist-count-badge').text(data.count);
                        }
                    } else if (data.redirect) {
                        window.location.href = data.redirect;
                    } else {
                        Swal.fire({
                            icon: 'info',
                            title: 'Note',
                            text: data.message,
                            background: '#1a1a1a',
                            color: '#fff'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to process request. Are you logged in?',
                        background: '#1a1a1a',
                        color: '#fff'
                    });
                }
            });
        }
    </script>
