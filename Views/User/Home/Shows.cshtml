@{
    ViewData["Title"] = "TV Shows";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="browse-header">
    <div class="container-fluid px-4">
        <h1 class="page-title">TV Shows</h1>
        <p class="page-subtitle">Explore thousands of TV series, anime, and more</p>

        <div class="filter-bar">
            <form method="get" class="filter-form">
                <div class="filter-group">
                    <label>Genre</label>
                    <select name="genre" class="filter-select">
                        <option value="All">All Genres</option>
                        @if (ViewBag.Genres != null)
                        {
                            var genres = ViewBag.Genres as List<string>;
                            if (genres != null)
                            {
                                foreach (var genre in genres)
                                {
                                    <option value="@genre" selected="@(genre == ViewBag.CurrentGenre)">@genre</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label>Sort By</label>
                    <select name="sortBy" class="filter-select">
                        <option value="latest" selected="@(ViewBag.CurrentSort == "latest")">Latest First</option>
                        <option value="rating" selected="@(ViewBag.CurrentSort == "rating")">Top Rated</option>
                        <option value="views" selected="@(ViewBag.CurrentSort == "views")">Most Viewed</option>
                    </select>
                </div>

                <button type="submit" class="filter-btn">Apply Filters</button>
            </form>
        </div>

        <div class="results-count">
            Showing @Model.Count() of @ViewBag.TotalItems shows
        </div>
    </div>
</div>

<div class="container-fluid px-4 py-4">
    <div class="shows-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var show in Model)
            {
                <div class="show-card" onclick="location.href='/User/Home/ShowDetails/@show.Id'">
                    <div class="show-poster">
                        <img src="@(show.ThumbnailUrl ?? "/images/default-show.jpg")" alt="@show.Title">
                        <div class="show-badge">
                            <span class="badge">@(show.Genre ?? "Hotstar Specials")</span>
                        </div>
                        @if (show.Rating > 0)
                        {
                            <div class="show-rating">
                                <i class="fas fa-star"></i>
                                <span>@string.Format("{0:F1}", show.Rating)</span>
                            </div>
                        }
                    </div>
                    <div class="show-info">
                        <h4 class="show-title">@show.Title</h4>
                        <p class="show-meta">
                            <span class="show-genre">@(show.Genre ?? "Action")</span>
                            <span class="show-year">@(show.ReleaseYear?.ToString() ?? "2026")</span>
                        </p>
                        <p class="show-episodes">
                            <i class="fas fa-play-circle"></i>
                            @if (show.Episodes != null)
                            {
                                @(show.Episodes.Count + " Episodes")
                            }
                            else
                            {
                                <span>New Series</span>
                            }
                        </p>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-tv"></i>
                <h3>No shows found</h3>
                <p>Try adjusting your filters</p>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 1)
    {
        <nav class="pagination-nav">
            <ul class="pagination">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Shows", new { page = i, genre = ViewBag.CurrentGenre, sortBy = ViewBag.CurrentSort })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

