@model IEnumerable<MovieMania.Models.Show>

@{
    ViewData["Title"] = "TV Shows";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="browse-header">
    <div class="container-fluid px-4">
        <h1 class="page-title">TV Shows</h1>
        <p class="page-subtitle">Explore thousands of TV series, anime, and more</p>

        <div class="filter-bar">
            <form method="get" class="filter-form">
                <div class="filter-group">
                    <label>Genre</label>
                    <select name="genre" class="filter-select">
                        <option value="All">All Genres</option>
                        @if (ViewBag.Genres != null)
                        {
                            var genres = ViewBag.Genres as List<string>;
                            if (genres != null)
                            {
                                foreach (var genre in genres)
                                {
                                    <option value="@genre" selected="@(genre == ViewBag.CurrentGenre)">@genre</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label>Sort By</label>
                    <select name="sortBy" class="filter-select">
                        <option value="latest" selected="@(ViewBag.CurrentSort == "latest")">Latest First</option>
                        <option value="rating" selected="@(ViewBag.CurrentSort == "rating")">Top Rated</option>
                        <option value="views" selected="@(ViewBag.CurrentSort == "views")">Most Viewed</option>
                    </select>
                </div>

                <button type="submit" class="filter-btn">Apply Filters</button>
            </form>
        </div>

        <div class="results-count">
            Showing @Model.Count() of @ViewBag.TotalItems shows
        </div>
    </div>
</div>

<div class="container-fluid px-4 py-4">
    <div class="shows-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var show in Model)
            {
                <div class="show-card" onclick="location.href='/User/Home/ShowDetails/@show.Id'">
                    <div class="show-poster">
                        <img src="@(show.ThumbnailUrl ?? "/images/default-show.jpg")" alt="@show.Title">
                        <div class="show-badge">
                            <span class="badge">@(show.Genre ?? "Hotstar Specials")</span>
                        </div>
                        @if (show.Rating > 0)
                        {
                            <div class="show-rating">
                                <i class="fas fa-star"></i>
                                <span>@string.Format("{0:F1}", show.Rating)</span>
                            </div>
                        }
                    </div>
                    <div class="show-info">
                        <h4 class="show-title">@show.Title</h4>
                        <p class="show-meta">
                            <span class="show-genre">@(show.Genre ?? "Action")</span>
                            <span class="show-year">@(show.ReleaseYear?.ToString() ?? "2026")</span>
                        </p>
                        <p class="show-episodes">
                            <i class="fas fa-play-circle"></i>
                            @if (show.Episodes != null)
                            {
                                @(show.Episodes.Count + " Episodes")
                            }
                            else
                            {
                                <span>New Series</span>
                            }
                        </p>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-tv"></i>
                <h3>No shows found</h3>
                <p>Try adjusting your filters</p>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 1)
    {
        <nav class="pagination-nav">
            <ul class="pagination">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Shows", new { page = i, genre = ViewBag.CurrentGenre, sortBy = ViewBag.CurrentSort })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<style>
    .browse-header {
        background: linear-gradient(180deg, #141414 0%, #1a1a1a 100%);
        padding: 40px 0 20px;
        border-bottom: 1px solid #333;
    }

    .page-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: white;
        margin-bottom: 5px;
    }

    .page-subtitle {
        color: #b3b3b3;
        font-size: 1.1rem;
        margin-bottom: 30px;
    }

    .filter-bar {
        background: #1a1a1a;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .filter-form {
        display: flex;
        gap: 20px;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .filter-group {
        flex: 1;
        min-width: 200px;
    }

        .filter-group label {
            display: block;
            color: #b3b3b3;
            font-size: 0.85rem;
            margin-bottom: 5px;
        }

    .filter-select {
        width: 100%;
        padding: 10px;
        background: #2a2a2a;
        border: 1px solid #333;
        color: white;
        border-radius: 4px;
    }

    .filter-btn {
        background: #e50914;
        color: white;
        border: none;
        padding: 10px 30px;
        border-radius: 4px;
        font-weight: 600;
        cursor: pointer;
    }

        .filter-btn:hover {
            background: #f40612;
        }

    .results-count {
        color: #b3b3b3;
        font-size: 0.9rem;
    }

    .shows-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .show-card {
        background: #1a1a1a;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.3s ease;
    }

        .show-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(229, 9, 20, 0.2);
        }

    .show-poster {
        position: relative;
        aspect-ratio: 2/3;
        overflow: hidden;
    }

        .show-poster img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

    .show-card:hover .show-poster img {
        transform: scale(1.05);
    }

    .show-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 2;
    }

    .badge {
        background: #e50914;
        color: white;
        padding: 4px 12px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .show-rating {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(0,0,0,0.8);
        padding: 4px 10px;
        border-radius: 4px;
        color: #ffd700;
        font-size: 0.85rem;
        z-index: 2;
    }

        .show-rating i {
            margin-right: 4px;
        }

    .show-info {
        padding: 15px;
    }

    .show-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0 0 8px 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .show-meta {
        color: #b3b3b3;
        font-size: 0.85rem;
        margin-bottom: 8px;
        display: flex;
        gap: 10px;
    }

    .show-genre {
        color: #e50914;
    }

    .show-episodes {
        color: #b3b3b3;
        font-size: 0.8rem;
    }

        .show-episodes i {
            color: #e50914;
            margin-right: 5px;
        }

    .empty-state {
        grid-column: 1 / -1;
        text-align: center;
        padding: 80px;
        color: #b3b3b3;
    }

        .empty-state i {
            font-size: 4rem;
            margin-bottom: 20px;
            color: #e50914;
            opacity: 0.5;
        }

    .pagination-nav {
        margin-top: 40px;
        display: flex;
        justify-content: center;
    }

    .pagination {
        display: flex;
        gap: 5px;
        list-style: none;
        padding: 0;
    }

    .page-link {
        display: block;
        padding: 8px 15px;
        background: #1a1a1a;
        border: 1px solid #333;
        color: white;
        text-decoration: none;
        border-radius: 4px;
    }

    .page-item.active .page-link {
        background: #e50914;
        border-color: #e50914;
    }

    @@media (max-width: 1200px) {
        .shows-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 992px) {
        .shows-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .shows-grid {
            grid-template-columns: 1fr;
        }

        .filter-form {
            flex-direction: column;
        }
    }
</style>