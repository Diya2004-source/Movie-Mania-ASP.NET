    .page-link:hover {
        background: #2a2a2a;
        border-color: #ff4d4d;
        color: white;
        transform: translateY(-2px);
    }

    /* Animations */
    @@keyframes rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* Responsive */
    @@media (max-width: 1400px) {
        .shows-grid {
            grid-template-columns: repeat(5, 1fr);
        }
    }

    @@media (max-width: 1200px) {
        .shows-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    @@media (max-width: 992px) {
        .shows-grid {
            grid-template-columns: repeat(3, 1fr);
        }
        .hero-title {
            font-size: 3rem;
        }
        .category-tabs {
            gap: 5px;
        }
        .tab-link {
            padding: 8px 15px;
            font-size: 0.9rem;
        }
    }

    @@media (max-width: 768px) {
        .shows-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .hero-title {
            font-size: 2.5rem;
        }
        .filters-wrapper {
            padding: 20px;
        }
        .view-options {
            justify-content: flex-start;
            margin-top: 10px;
        }
        .clear-all {
            margin-left: 0;
            width: 100%;
            text-align: center;
        }
        .show-badge {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (max-width: 576px) {
        .shows-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }
        .hero-title {
            font-size: 2rem;
        }
        .stat-badge {
            padding: 8px 15px;
            font-size: 0.85rem;
        }
        .tab-link {
            padding: 6px 12px;
            font-size: 0.8rem;
        }
        .btn-details, .btn-wishlist {
            padding: 6px 10px;
            font-size: 0.7rem;
        }
        .show-badge {
            flex-direction: column;
            align-items: flex-start;
            gap: 2px;
        }
        .badge-anime, .badge-seasons, .badge-episodes {
            padding: 3px 6px;
            font-size: 0.6rem;
        }
    }
</style>

@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true,
            offset: 100
        });

        // View toggle (grid/list)
        $('.view-option').click(function() {
            $('.view-option').removeClass('active');
            $(this).addClass('active');
            
            if ($(this).data('view') === 'list') {
                $('.shows-grid').css('grid-template-columns', 'repeat(1, 1fr)');
                $('.show-card').css('display', 'flex');
                $('.show-poster').css('width', '150px');
            } else {
                $('.shows-grid').css('grid-template-columns', '');
                $('.show-card').css('display', '');
                $('.show-poster').css('width', '');
            }
        });

        // Auto-submit on filter change
        $('#genreSelect, #sortSelect').change(function() {
            $('#filterForm').submit();
        });

        // Debounced search
        let searchTimeout;
        $('#searchInput').on('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                $('#filterForm').submit();
            }, 500);
        });

        function toggleWishlist(itemId, type) {
            @if (User.Identity?.IsAuthenticated == true)
            {
                <text>
                $.post('@Url.Action("ToggleWishlist", "Wishlist", new { area = "User" })', 
                    { itemId: itemId, itemType: type })
                    .done(function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            // Update button appearance
                            $(`[data-show-id="${itemId}"]`).toggleClass('in-wishlist');
                        } else {
                            toastr.info(response.message);
                        }
                    })
                    .fail(function() {
                        toastr.error('Error updating wishlist');
                    });
                </text>
            }
            else
            {
                <text>
                toastr.warning('Please login to add to wishlist');
                setTimeout(() => {
                    window.location.href = '@Url.Action("Login", "Auth", new { area = "" })';
                }, 1500);
                </text>
            }
        }
    </script>
}