            .footer-links {
                grid-template-columns: 1fr;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Loading Animation -->
    <div class="netflix-loader" id="loader">
        <div class="loader-logo">MOVIEMANIA</div>
    </div>

    <!-- Netflix-style Navbar -->
    <nav class="netflix-navbar" id="navbar">
        <div class="container-fluid">
            <div class="d-flex align-items-center justify-content-between w-100">
                <div class="d-flex align-items-center">
                    <a href="/User/Home" class="nav-logo">
                        <i class="fas fa-film me-2"></i>MOVIEMANIA
                    </a>

                    <div class="nav-links ms-4">
                        <a href="/User/Home" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                            <i class="fas fa-home me-1"></i> Home
                        </a>
                        <a href="/User/Home/Movies" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Movies" ? "active" : "")">
                            <i class="fas fa-film me-1"></i> Movies
                        </a>
                        <a href="/User/Home/Shows" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Shows" ? "active" : "")">
                            <i class="fas fa-tv me-1"></i> TV Shows
                        </a>
                        <a href="/User/Home/Anime" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Anime" ? "active" : "")">
                            <i class="fas fa-dragon me-1"></i> Anime
                        </a>
                        <a href="/User/Wishlist" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Wishlist" ? "active" : "")">
                            <i class="fas fa-heart me-1"></i> My List
                        </a>
                    </div>
                </div>

                <div class="nav-right">
                    <div class="dropdown">
                        <div class="user-menu" data-bs-toggle="dropdown">
                            <div class="user-avatar">
                                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <span class="user-name">@User.Identity?.Name</span>
                            <i class="fas fa-chevron-down" style="color: var(--netflix-light-gray); font-size: 0.8rem;"></i>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="/User/Profile">
                                    <i class="fas fa-user"></i> Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/User/Subscription">
                                    <i class="fas fa-crown"></i> Subscription
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/User/Wishlist">
                                    <i class="fas fa-heart"></i> My List
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/User/Profile/Referral">
                                    <i class="fas fa-gift"></i> Referrals
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" style="border-color: var(--netflix-gray);"></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="fas fa-sign-out-alt"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Netflix-style Footer -->
    <footer class="netflix-footer">
        <div class="container">
            <div class="footer-social">
                <a href="#"><i class="fab fa-facebook"></i></a>
                <a href="#"><i class="fab fa-instagram"></i></a>
                <a href="#"><i class="fab fa-twitter"></i></a>
                <a href="#"><i class="fab fa-youtube"></i></a>
            </div>

            <div class="footer-links">
                <div class="footer-links-column">
                    <h5>Quick Links</h5>
                    <ul>
                        <li><a href="/User/Home">Home</a></li>
                        <li><a href="/User/Home/Movies">Movies</a></li>
                        <li><a href="/User/Home/Shows">TV Shows</a></li>
                        <li><a href="/User/Home/Anime">Anime</a></li>
                    </ul>
                </div>

                <div class="footer-links-column">
                    <h5>My Account</h5>
                    <ul>
                        <li><a href="/User/Profile">Profile</a></li>
                        <li><a href="/User/Wishlist">My List</a></li>
                        <li><a href="/User/Subscription">Subscription</a></li>
                        <li><a href="/User/Profile/Referral">Referrals</a></li>
                    </ul>
                </div>

                <div class="footer-links-column">
                    <h5>Support</h5>
                    <ul>
                        <li><a href="#">FAQ</a></li>
                        <li><a href="#">Help Center</a></li>
                        <li><a href="#">Contact Us</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                    </ul>
                </div>

                <div class="footer-links-column">
                    <h5>Legal</h5>
                    <ul>
                        <li><a href="#">Terms of Use</a></li>
                        <li><a href="#">Cookie Preferences</a></li>
                        <li><a href="#">Corporate Information</a></li>
                    </ul>
                </div>
            </div>

            <button class="service-code-btn">Service Code</button>

            <div class="footer-copyright">
                <p>&copy; @DateTime.Now.Year MovieMania. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- AOS Animation -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <!-- Owl Carousel -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>

    <script>
        // Initialize AOS
        AOS.init({
            duration: 800,
            once: true
        });

        // Navbar scroll effect
        window.addEventListener('scroll', function() {
            const navbar = document.getElementById('navbar');
            if (window.scrollY > 100) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });

        // Hide loader after page load
        window.addEventListener('load', function() {
            setTimeout(function() {
                document.getElementById('loader').style.display = 'none';
            }, 1000);
        });

        // Show toast messages from TempData
        @if (TempData["Success"] != null)
        {
                <text>
                $(document).ready(function() {
                    alert('@TempData["Success"]');
                });
                </text>
        }
        @if (TempData["Error"] != null)
        {
                <text>
                $(document).ready(function() {
                    alert('@TempData["Error"]');
                });
                </text>
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
