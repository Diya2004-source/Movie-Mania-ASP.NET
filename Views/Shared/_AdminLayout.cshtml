<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Admin Panel - Movie Mania</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <style>
        body {
            background-color: #0A0C0F;
            color: white;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            background-color: #111317;
            position: fixed;
            padding-top: 20px;
            box-shadow: 2px 0 10px rgba(0,0,0,0.3);
            overflow-y: auto;
        }

            .sidebar h4 {
                padding: 0 20px;
                margin-bottom: 30px;
                color: #4A80F0;
                font-weight: 600;
                border-bottom: 1px solid #2a2a2a;
                padding-bottom: 15px;
            }

            .sidebar a {
                color: #cfcfcf;
                text-decoration: none;
                display: block;
                padding: 12px 20px;
                transition: all 0.3s;
                margin: 2px 10px;
                border-radius: 8px;
            }

                .sidebar a:hover,
                .sidebar a.active {
                    background-color: #1E1E1E;
                    color: #4A80F0;
                    transform: translateX(5px);
                }

                .sidebar a i {
                    margin-right: 10px;
                    width: 20px;
                }

            .sidebar hr {
                margin: 15px 20px;
                border-color: #2a2a2a;
            }

        .content {
            margin-left: 250px;
            padding: 25px;
        }

        .topbar {
            background-color: #111317;
            padding: 15px 25px;
            border-bottom: 1px solid #1E1E1E;
            border-radius: 12px;
            margin-bottom: 20px;
        }

            .topbar h5 {
                color: #4A80F0;
                font-weight: 600;
            }

        .card {
            background-color: #1E1E1E !important;
            border: none;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .btn-primary {
            background-color: #4A80F0;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            transition: all 0.3s;
        }

            .btn-primary:hover {
                background-color: #3768d8;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(74,128,240,0.3);
            }

        .btn-warning {
            background-color: #ffc107;
            border: none;
            color: #000;
            transition: all 0.3s;
        }

            .btn-warning:hover {
                background-color: #ffb300;
                transform: translateY(-2px);
            }

        .btn-danger {
            background-color: #ff4d4d;
            border: none;
            transition: all 0.3s;
        }

            .btn-danger:hover {
                background-color: #ff3333;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(255,77,77,0.3);
            }

        .btn-info {
            background-color: #0dcaf0;
            border: none;
            color: #000;
            transition: all 0.3s;
        }

            .btn-info:hover {
                background-color: #0bb7d6;
                transform: translateY(-2px);
            }

        .table {
            color: white;
        }

            .table thead th {
                background-color: #2a2a2a;
                color: white;
                border: none;
                padding: 15px 12px;
            }

            .table tbody tr {
                background-color: #1e1e1e;
                transition: all 0.2s;
            }

                .table tbody tr:hover {
                    background-color: #252525;
                    transform: translateY(-2px);
                    box-shadow: 0 5px 15px rgba(74,128,240,0.1);
                }

        .badge {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 0.85rem;
        }

            .badge.bg-success {
                background-color: #00c853 !important;
            }

            .badge.bg-warning {
                background-color: #ffc107 !important;
                color: #000;
            }

            .badge.bg-info {
                background-color: #0dcaf0 !important;
                color: #000;
            }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #1e1e1e;
        }

        ::-webkit-scrollbar-thumb {
            background: #4A80F0;
            border-radius: 4px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #3768d8;
            }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <h4 class="text-center text-white mb-4">
            <i class="bi bi-film me-2"></i>Movie Mania
        </h4>

        <a asp-controller="AdminDashboard" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminDashboard" ? "active" : "")">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>

        <a asp-controller="AdminMovies" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminMovies" ? "active" : "")">
            <i class="bi bi-film"></i> Movies
        </a>

        <!-- ✅ NEW: TV Shows Link -->
        <a asp-controller="AdminShows" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminShows" ? "active" : "")">
            <i class="bi bi-tv"></i> TV Shows
        </a>

        <a asp-controller="AdminUsers" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminUsers" ? "active" : "")">
            <i class="bi bi-people"></i> Users
        </a>

        <!-- Wishlist Link -->
        <a asp-controller="AdminWishlist" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminWishlist" ? "active" : "")">
            <i class="bi bi-heart"></i> Wishlist
        </a>

        <a asp-controller="AdminOffers" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminOffers" ? "active" : "")">
            <i class="bi bi-tag"></i> Offers
        </a>

        <a asp-controller="AdminSubscriptions" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminSubscriptions" ? "active" : "")">
            <i class="bi bi-card-checklist"></i> Subscription Plans
        </a>

        <a asp-controller="AdminPayments" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminPayments" ? "active" : "")">
            <i class="bi bi-credit-card"></i> Payments
        </a>

        <hr class="text-secondary" />

        <a asp-controller="Admin" asp-action="Logout">
            <i class="bi bi-box-arrow-right"></i> Logout
        </a>
    </div>

    <!-- Main Content -->
    <div class="content">

        <!-- Topbar -->
        <div class="topbar d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-grid me-2"></i>
                @(ViewData["Title"] ?? "Admin Dashboard")
            </h5>

            <div class="d-flex align-items-center">
                <span class="me-3">
                    <i class="bi bi-person-circle me-2"></i>
                    Welcome, Admin
                </span>
                <i class="bi bi-bell fs-5 me-3"></i>
                <i class="bi bi-gear fs-5"></i>
            </div>
        </div>

        <!-- Page Content -->
        <div class="mt-4">
            @RenderBody()
        </div>

    </div>

    <!-- jQuery FIRST -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Validation scripts -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- Toastr -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <!-- Site JS -->
    <script src="~/js/site.js"></script>

    <script>
        // Configure toastr
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000",
            "extendedTimeOut": "1000",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };

        // Auto-dismiss alerts after 5 seconds
        $(document).ready(function() {
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>